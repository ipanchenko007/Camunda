    <bpmn:scriptTask id="Activity_06j7pgk" name="Create StepFormMap" scriptFormat="groovy">
      <bpmn:incoming>Flow_13n1utu</bpmn:incoming>
      <bpmn:outgoing>Flow_1xaw8d6</bpmn:outgoing>
      <bpmn:script>/* 0600 Script Task "Create StepFormMap" (createStepFormMap) */
// JsonBuilder - для преобразования объектов Groovy (Map, List, POGO) в строку формата JSON
import groovy.json.JsonBuilder
def log = org.slf4j.LoggerFactory.getLogger("${processCode}_createStepFormMap")
def processInstanceId = execution.getProcessInstanceId()

def stepForm = execution.getVariable("stepForm")
log.info("PROCESS [{}] Received stepForm: {}", processInstanceId, stepForm)

// Используем конструктор JsonBuilder для создания валидной JSON-строки
def stepFormJson = new JsonBuilder(["ABB0600_STEP_FORM": stepForm]).toString()

//Сохраняем в переменную процесса
execution.setVariable("stepFormMap", stepFormJson)
log.info("PROCESS [{}] Created stepFormMap: {}", processInstanceId, stepFormJson)
</bpmn:script>
