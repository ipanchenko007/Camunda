<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_11ao3n0" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:process id="PIB0600" name="0600 Открытие финансирования" isExecutable="true" camunda:historyTimeToLive="365">
    <bpmn:startEvent id="StartEvent_1" name="StartEvent_1">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">/* 0600 Start Event (Execution listeners: End) "StartEvent_1" (StartEvent_1) */
/* Заполнение начальных значений процесса */
import java.text.SimpleDateFormat

// Задаем BusinessKey Склеиваем префикс и часть системного ID
def date = new SimpleDateFormat("yyyyMMdd").format(new Date())
def random = Math.abs(new Random().nextInt() % 1000).toString().padLeft(3, '0')
def bKey = "PROC-${date}-${random}"
execution.setProcessBusinessKey(bKey)

// Получаем системные данные (из кэша движка)
def processInstanceId = execution.processInstanceId 
def processDefinition = execution.processEngineServices.repositoryService
    .getProcessDefinition(execution.processDefinitionId)

// Достаем Имя процесса из этого объекта
def processName = processDefinition.name ?: "UNKNOWN Process"

// Определяем processCode (берем символы до первого пробела)
def processCode = processName.takeWhile { it != ' ' } 

// Сохраняем ВСЕ в ГЛОБАЛЬНЫЕ переменные процесса (Map-синтаксис)
execution.setVariables(
  ["processInstanceId": processInstanceId
  ,"processName": processName
  ,"processCode": processCode
  ])

//Определим логер
def log = org.slf4j.LoggerFactory.getLogger("${processCode}_Start_Event")

//log.info("PROCESS: [${processInstanceId}] processCode: '${processCode}' processName: '${processName}'")
log.info("PROCESS: [{}] processCode: '{}' processName: '{}'", processInstanceId, processCode, processName)

// Выведет все текущие переменные процесса в формате {key1=val1, key2=val2}
if (log.isDebugEnabled()) {
    log.debug("PROCESS [{}]: ALL VARS: {}", processInstanceId, execution.variables)
}
</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1as5qye</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="catchEventDecline" name="Отклонить">
      <bpmn:outgoing>Flow_18wue0r</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LinkEventDefinition_0qb3vxx" name="linkDecline" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_1xeqdh0">
      <bpmn:incoming>Flow_14rok4g</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_1mw3lpu" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="noticeOfDecline" name="Отправка уведомления об Отклонении" camunda:delegateExpression="#{notificationSender}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="messageCode">NTB0600_DECLINED</camunda:inputParameter>
          <camunda:inputParameter name="addresseeLogins">${initiator}</camunda:inputParameter>
          <camunda:inputParameter name="properties">${notificationProps}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1121wso</bpmn:incoming>
      <bpmn:outgoing>Flow_14rok4g</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="settingStatusDecline" name="Установка статуса &#34;Отклонено&#34;" camunda:delegateExpression="#{restClient}">
