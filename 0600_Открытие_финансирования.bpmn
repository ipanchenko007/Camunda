        <camunda:inputOutput>
          <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
          <camunda:inputParameter name="path">/private/documents/{guid}/_status</camunda:inputParameter>
          <camunda:inputParameter name="pathParams">
            <camunda:map>
              <camunda:entry key="guid">${entityGuid}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
          <camunda:inputParameter name="method">PUT</camunda:inputParameter>
          <camunda:inputParameter name="body">
            <camunda:map>
              <camunda:entry key="statusCode">DSB0600_DECLINE</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18wue0r</bpmn:incoming>
      <bpmn:outgoing>Flow_1wskxs0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0pntbzb" name="Запрос атрибутов документа" camunda:delegateExpression="#{restClient}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
          <camunda:inputParameter name="path">/private/documents/{guid}</camunda:inputParameter>
          <camunda:inputParameter name="pathParams">
            <camunda:map>
              <camunda:entry key="guid">${entityGuid}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="resultVarName">baseDocument</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">execution.setVariable('entityMetadata', S(baseDocument).prop('data'));</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
