    <bpmn:scriptTask id="dataControl" name="Контроль данных" scriptFormat="groovy">
      <bpmn:incoming>Flow_0491rza</bpmn:incoming>
      <bpmn:outgoing>Flow_0noqp32</bpmn:outgoing>
      <bpmn:script>/* 0600 Script Task "Контроль данных" (dataControl) */
//Использование import groovy.json.JsonBuilder позволяет удобно формировать новые JSON-структуры внутри скрипта Camunda 7,
// используя нативный синтаксис Groovy. Это часто удобнее, чем работать напрямую с методами Camunda Spin, когда нужно создать сложный объект «с нуля». 
import groovy.json.JsonBuilder

// В логах ищите сообщения с тегом "0600_dataControl".
def log = org.slf4j.LoggerFactory.getLogger("${processCode}_dataControl")
def processInstanceId = execution.getProcessInstanceId()
log.info("PROCESS [{}]: --- Starting validation script ---", processInstanceId)

// --- ПОЛУЧЕНИЕ И ДИАГНОСТИКА ВХОДНОГО ДОКУМЕНТА ---
//def hasErrors = false //Больше не используется!
def errorMessage = ""
def errorList = [] //Это пустой список (List/ArrayList)

// Получаем entityMetadata - сохранена в Service Task "Запрос атрибутов документа"
def entityMetadata = execution.getVariable('entityMetadata')
// С каким типом данных вы работаете (объект SPIN или обычный Map/String), можно добавить вывод класса:
log.info("PROCESS [{}]: entityMetadata: {} Class: {}", processInstanceId, entityMetadata, entityMetadata?.getClass())

// Check entityMetadata
if (entityMetadata == null) {
  log.error("PROCESS [{}]: ERROR Empty entityMetadata", processInstanceId)
  // Формируем сообщение об ошибке
  errorMessage = "Критическая ошибка: не удалось получить или обработать данные документа."
  //execution.setVariable("errorMessage", errorMessage) //Сохраним значение errorMessage - Лишнее, т.к. значение сохранится в boundaryEvent
  
  //Создаем бизнес-исключение
  throw new org.camunda.bpm.engine.delegate.BpmnError("ERROR", errorMessage)
  //return; // Прерываем выполнение скрипта
}

//Получаем Код Типа документа. Понадобится для поиска настройки Исполнителей
def docType = (entityMetadata.hasProp("project_number") &amp;&amp; !attr.prop("project_number").isNull()) ? entityMetadata.prop("project_number").stringValue() : ""

def notificationProps = [:] // Создаем пустую карту (Map/LinkedHashMap) для данных уведомления

// ЗАПОЛНЯЕМ Map ДЛЯ УВЕДОМЛЕНИЯ - Пока нЕчего передавать!
//notificationProps.put("documentType", docType)
log.info("PROCESS [{}]: Check notificationProps: {}", processInstanceId, notificationProps)

// --- ОСНОВНАЯ ЛОГИКА ВАЛИДАЦИИ ---
log.info("PROCESS [{}]: Starting main validation logic for document attributes...", processInstanceId)

//Временно!!! Сформируем тестовую ошибку! -------------------------------------------------------------------------- 
//errorList.add("- Временно!!! Сформируем тестовую ошибку (через add).") //Var.1
//errorList &lt;&lt; "- Временно!!! Сформируем тестовую ошибку (через &lt;&lt;)" //Var.2
//errorList &lt;&lt; "- Временно!!! Сформируем тестовую ошибку (var 3)" //Var.3

//В Groovy проверка if (variable) автоматически проверяет и на null, и на пустоту (если это строка или коллекция)
if (!errorList.isEmpty()) {
  errorMessage = "Обнаружены следующие ошибки:\n" + errorList.join('\n')
  //execution.setVariable("errorMessage", errorMessage) //Сохраним значение errorMessage - Лишнее, т.к. значение сохранится в boundaryEvent
  //Заполнение ERROR_MESSAGE и ERROR_FLAG_YN (если есть) выполняется в Script Task "Create ErrorMap" (createErrorMap)

  //Создаем бизнес-исключение
  throw new org.camunda.bpm.engine.delegate.BpmnError("ERROR", errorMessage)
}

//Если в форме документа сохранена информация об ошибке, а теперь ошибки нет, то чистим значение ERROR_MESSAGE и ERROR_FLAG_YN (если есть)
def oldErrorValue = entityMetadata.prop("attributes").hasProp("ERROR_MESSAGE") ? entityMetadata.prop("attributes").prop("ERROR_MESSAGE").stringValue() : ""
if (oldErrorValue != "" &amp;&amp; errorMessage == "") {
  errorJsonMap = new JsonBuilder(["ERROR_MESSAGE": "", "ERROR_FLAG_YN": "N"]).toString()
  execution.setVariableLocal("body", errorJsonMap)
  
  //Общие Local переменные для вызова метода обновления атрибутов Документа
  execution.setVariableLocal("serviceName", "documents")
  execution.setVariableLocal("method", "PUT")
  
  fullPath = "private/documents/${entityGuid}/_attributes"
  execution.setVariableLocal("path", fullPath)
  try {
    //log.info("PROCESS [{}] Clear ERROR_MESSAGE fullPath: {} body: {}", processInstanceId, fullPath, errorJsonMap)
    restClient.execute(execution)
  
  } catch (Exception e) {
    log.info("PROCESS [{}] Error call fullPath: {} body: {}", processInstanceId, fullPath, errorJsonMap)
    errorMessage = "Не удалось очистить атрибут ERROR_MESSAGE"
    //execution.setVariable("errorMessage", errorMessage) //Сохраним значение errorMessage - Лишнее, т.к. значение сохранится в boundaryEvent
    throw new org.camunda.bpm.engine.delegate.BpmnError("ERROR", errorMessage)
  }  
}

// Дозаполняем Map ДЛЯ УВЕДОМЛЕНИЯ
notificationProps.put("errorMessage", errorMessage)

// СОХРАНЯЕМ ВСЮ Map В ОДНУ ПЕРЕМЕННУЮ ПРОЦЕССА
execution.setVariable("notificationProps", notificationProps)

log.info("PROCESS [{}]: --- Finished validation script ---", processInstanceId)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="getRequestUsersService" name="Запрос LDB0600_REQUEST_USERS" camunda:delegateExpression="#{restClient}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="serviceName">dictionaries</camunda:inputParameter>
          <camunda:inputParameter name="path">/private/dictionaries/LDB0600_REQUEST_USERS/values?onlyData=true&amp;all=true</camunda:inputParameter>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="resultVarName">requestUsers</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">def log = org.slf4j.LoggerFactory.getLogger("${processCode}_getRequestUsersService")
def processInstanceId = execution.getProcessInstanceId()
log.info("PROCESS [{}] ---Start--", processInstanceId)</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">def log = org.slf4j.LoggerFactory.getLogger("${processCode}_getRequestUsersService")
def processInstanceId = execution.getProcessInstanceId()
log.info("PROCESS [{}] Check requestUsers: {} Class: {}", processInstanceId, requestUsers, requestUsers?.getClass())</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1n2o28n</bpmn:incoming>
      <bpmn:outgoing>Flow_0491rza</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="filingInitialExecutionList" name="Предварительная настройка Исполнителей" scriptFormat="groovy">
      <bpmn:incoming>Flow_0noqp32</bpmn:incoming>
      <bpmn:outgoing>Flow_0d8hnpd</bpmn:outgoing>
      <bpmn:script>/* 0600 Script Task "Заполнение предварительной настройки Исполнителей" (filingInitialExecutionList) */
// JsonSlurper используется внутри Groovy-скриптов для парсинга JSON-строк в объекты Groovy (Map или List)
import groovy.json.JsonSlurper
// JsonBuilder - для преобразования объектов Groovy (Map, List, POGO) в строку формата JSON
//import groovy.json.JsonBuilder //Это «конструктор»
//Библиотека для преобразования объектов Groovy (Map, List) в формат JSON-строки
import groovy.json.JsonOutput //Это «молоток» для готовых данных
import static org.camunda.spin.Spin.*

//Для обработки throw new BpmnError (если есть)
import org.camunda.bpm.engine.delegate.BpmnError

/* Подготовка initialList - данные для обновления Статической таблицы "INITIAL_EXECUTION_LIST" */
def log = org.slf4j.LoggerFactory.getLogger("${processCode}_filingInitialExecutionList")
def processInstanceId = execution.getProcessInstanceId()
log.info("PROCESS [{}] ---Start--", processInstanceId)

def errorMessage = "" //Изначально ошибки нет.
def errorList = [] //Это пустой список (List/ArrayList)

//Определим Тип документа из entityMetadata - сохранена в Service Task "Запрос атрибутов документа"
def entityMetadata = execution.getVariable('entityMetadata')
// С каким типом данных вы работаете (объект SPIN или обычный Map/String), можно добавить вывод класса:
//log.info("PROCESS [{}]: entityMetadata: {} Class: {}", processInstanceId, entityMetadata, entityMetadata?.getClass())

// Попробуем короткий способ определения docType
// Сначала один раз превращаем весь JSON в Map
def metaMap = entityMetadata.mapTo(java.util.Map.class)
// Извлекаем значение по цепочке (вернет "" если чего-то нет)
def docType = metaMap?.attributes?.ABB0600_REQUEST_TYPE?.code ?: ""
log.info("PROCESS [{}]: docType: {}", processInstanceId, docType)

def requestUserMap = [:]
def setupStageDataMap = [:]
def stageDataMap = [:]
def fullPath = ""

//Общие Local переменные для вызова метода значений Справочника
execution.setVariableLocal("serviceName", "dictionaries")
execution.setVariableLocal("method", "GET")
execution.setVariableLocal("resultVarName", "resultData") //В resultData попадет результат вызова метода

//Найдем настройки Исполнителей для этапа текущего Типа документа
//Пока по упрощенной схеме из справочника LDB0600_REQUEST_USERS (берем все записи!)
fullPath = "/private/dictionaries/LDB0600_REQUEST_USERS/values?onlyData=true&amp;all=true"
execution.setVariableLocal("path", fullPath)
try {
  restClient.execute(execution)
  requestUserMap = S(execution.getVariable("resultData")).mapTo(java.util.Map.class)
  log.info("PROCESS [{}] requestUserMap: {}", processInstanceId, requestUserMap)
} catch (Exception e) {
  requestUserMap = null
  log.info("PROCESS [{}] Error call fullPath: {}", processInstanceId, fullPath)
}

//Понадобятся Имена этапов и Тип назначения и Тип исполнителя из LDB0600_SETUP_STAGES
fullPath = "/private/dictionaries/LDB0600_SETUP_STAGES/values?onlyData=true&amp;all=true"
execution.setVariableLocal("path", fullPath)
try {
  restClient.execute(execution)
  setupStageDataMap = S(execution.getVariable("resultData")).mapTo(java.util.Map.class)
  log.info("PROCESS [{}] setupStageDataMap: {}", processInstanceId, setupStageDataMap)
} catch (Exception e) {
  setupStageDataMap = null
  log.info("PROCESS [{}] Error call fullPath: {}", processInstanceId, fullPath)
}

//Понадобятся ВСЕ значения Этапов из Справочника LDB0600_STAGES и сохраняем в stageDataMap
fullPath = "/private/dictionaries/LDB0600_STAGES/values?onlyData=true&amp;all=true"
execution.setVariableLocal("path", fullPath)
try {
  restClient.execute(execution)
  stageDataMap = S(execution.getVariable("resultData")).mapTo(java.util.Map.class)
  log.info("PROCESS [{}] stageDataMap: {}", processInstanceId, stageDataMap)
} catch (Exception e) {
  stageDataMap = null
  log.info("PROCESS [{}] Error call fullPath: {}", processInstanceId, fullPath)
}

//Используем List (java.util.ArrayList) для stageCode с упорядочивание выполнения уровней
def stageSequence = ["EXPERT1","VIZIR1","COMMITTEE","REPORTING","EXPERT2"]

//Сохраним настройки этапов setupStages - это Map, которая сохраняет порядок добавления элементов (как и ассоциативный массив в PHP)
def setupStages = [:] //Инициализируем пустую LinkedHashMap

//Одновременно заполним Статическую таблицу INITIAL_EXECUTION_LIST
// Инициализируем пустой ArrayList для заполнения INITIAL_EXECUTION_LIST
def initialList = []

stageSequence.each { stageCode -&gt;
  //Найдем значения setupStageDataMap.data (name, user_type, assignment_type) из справочника LDB0600_SETUP_STAGES для текущего stageCode
  // В setupStageValue попадет первый найденный объект целиком или null, если совпадений нет.
  def setupStageValue = setupStageDataMap.data.find { it.code == stageCode }
  log.info("PROCESS [{}] setupStageValue: {}", processInstanceId, setupStageValue)

  //Найдем значения stageDataMap.data для этапа из справочника LDB0600_STAGES для текущего stageCode
  //Понадобится для формирования INITIAL_EXECUTION_LIST
  def stageValue = stageDataMap.data.find { it.code == stageCode }
  log.info("PROCESS [{}] stageValue: {}", processInstanceId, stageValue)

  //Создаем List для хранения Исполнителей этого этапа (если они есть)
  def participants = []

  //Ищем всех Исполнителей на этапе
  requestUserMap?.data?.findAll { it.request_code == docType &amp;&amp;  it.stage_code == stageCode}?.each { value -&gt;
    def userId = value.user_id //Login
    def userFullName = ""
    
    //Определяем "ФИО (Должность)" для Исполнителя (рекомендация Ильи Першина, см. чат "Аналитика" от 02.02.2026)
    fullPath = "/private/users/${userId}/employee"
    execution.setVariableLocal("path", fullPath)
    execution.setVariableLocal("serviceName", "users")
    execution.setVariableLocal("resultVarName", "userInfo") 
    
    try {
      restClient.execute(execution)
      //Внутри цикла можно определять def userData (так ИИ утверждает!)
      def userData = S(execution.getVariable("userInfo")).prop("data").mapTo(java.util.Map.class)
      log.info("PROCESS [{}] fullPath: {} userData: {} Class: {}", processInstanceId, fullPath, userData, userData?.getClass())

      // Извлекаем глубокую вложенность: data -&gt; employee -&gt; person -&gt; fullName
      def person = userData.employee?.person
      def position = userData.employee?.position ?: ""
      def dept = userData.employee?.department
      def pId = userData.employee?.personId

      //Убираем сдвоенные пробелы, если будут!
      userFullName = "${person?.fullName ?: ""} (${position ?: ""} ${dept?.fullName ?: ""})".trim().replaceAll(" +", " ")
      log.info("PROCESS [{}] userFullName: {}", processInstanceId, userFullName)

    } catch (Exception e) {
      log.error("PROCESS [{}] Error {}", processInstanceId, e.message)
      log.info("PROCESS [{}] Current fullPath: {}", processInstanceId, fullPath)
    }
    
    //Формируем объект настроек для КОНКРЕТНОГО пользователя
    def userSettings = 
               [stageName:      setupStageValue.name //Например: "Скрининг"
               ,assignmentType: setupStageValue.assignment_type //Например: "PERSONAL"
               ,userType:       setupStageValue.user_type //Например: "USER"
               ,userId:         userId //Login
               ,userName:       userFullName //ФИО (Должность)
               ]
    log.info("PROCESS [{}] stageCode: '{}' userSettings: {}", processInstanceId, stageCode, userSettings)
    
    // Добавляем пользователя в List участников этапа
    participants &lt;&lt; userSettings
    

    //Формируем "строку" в нужном формате для INITIAL_EXECUTION_LIST
    def row = ["ABB0600_STAGE": "${stageValue?.name} (${stageCode})"
              ,"ABB0600_EXECUTOR": userFullName
              ]
    //Добавляем сформированный объект в общий List initialList
    initialList &lt;&lt; row
  }
  
  // Сохраняем List участников в итоговую Map по Коду этапа
  // Даже если участников 0, в карте будет пустой List [], но порядок сохранится
  if (participants) {
    // Если участники найдены, сохраняем весь список объектов userSettings
    setupStages[stageCode] = participants
    log.info("PROCESS [{}] Stage '{}' added with {} participants", processInstanceId, stageCode, participants.size())
  
  } else {
    // Если участников НЕТ, создаем запись с настройкой этапа, но без конкретных Исполнителей
    // Это позволит избежать NullPointerException позже при чтении stageName
    setupStages[stageCode] = [
       [stageName:      setupStageValue?.name ?: "Unknown"
       ,assignmentType: setupStageValue?.assignment_type ?: "NONE"
       ,userType:       setupStageValue?.user_type ?: "NONE"
       ,userId:         ""
       ,userName:       ""
       ]
    ]
    log.warn("PROCESS [{}] Stage '{}' without participants", processInstanceId, stageCode)
  }

}
log.info("PROCESS [{}] docType: '{}' setupStages: {}", processInstanceId, docType, setupStages)

//***Блок контроля наличия исполнителей на всех этапах *********
setupStages.each { stageCode, rows -&gt;
  rows.each { stageConfig -&gt;
    //Проверяем типы, требующие конкретного пользователя
    if (['USER', 'USER_LIST'].contains(stageConfig.assignmentType)) {
      //Проверка на null, пустоту или строку "null" (частая проблема фронта)
      if (!stageConfig.userId || stageConfig.userId.toString().trim() == "") {
        //Используем stageName или stageCode для идентификации
        errorList.add("Не назначен исполнитель на этапе: ${stageConfig.stageName ?: stageCode}.")
      }
    }
  }
}

if (!errorList.isEmpty()) {
  errorMessage = "Обнаружены следующие ошибки:\n" + errorList.join('\n')
  log.info("PROCESS [{}] Errors found! errorMessage: {}", processInstanceId, errorMessage)
  throw new BpmnError("ERROR", errorMessage)
}
//***End Блок контроля наличия исполнителей на всех этапах *****

// Сохраняем в setupStages для использования в процессе
execution.setVariable("setupStages", setupStages)

// Оборачиваем список в финальный JSON-объект, который ожидает атрибут документа
// Ключ "INITIAL_EXECUTION_LIST" должен соответствовать имени атрибута в схеме данных
def attributesMap = ["INITIAL_EXECUTION_LIST": initialList]
log.info("PROCESS [{}] attributesMap: {}", processInstanceId, attributesMap)

/****************************/
//Откажусь от использования отдельной Service Task "Обновление Статической таблицы"
//Выполню запуск обновления прямо в скрипте
//Зададим Local переменные для вызова метода PUT private/documents/{guid}/_attributes
execution.setVariableLocal("serviceName", "documents")
execution.setVariableLocal("method", "PUT")
fullPath = "private/documents/${entityGuid}/_attributes"
execution.setVariableLocal("path", fullPath)

//execution.setVariableLocal("body", attributesMap) //Портит данные!

//Для определения body буду использовать Вариант 3 (см. ниже)
//Возможно, эти "танцы с бубуном" излишни, пусть эксперты подскажут более верный способ!
def rawJsonString = JsonOutput.toJson(attributesMap)
execution.setVariableLocal("body", JSON(rawJsonString).toString())

try {
  log.info("PROCESS [{}] Обновление Статической таблицы fullPath: {} attributesMap: {}", processInstanceId, fullPath, attributesMap)
  restClient.execute(execution)

} catch (Exception e) {
  log.info("PROCESS [{}] Error call fullPath: {} attributesMap: {}", processInstanceId, fullPath, attributesMap)
  log.error("PROCESS [{}] e.message: {}", processInstanceId, e.message)
  
  errorMessage = "Не удалось обновить Статическую таблицу"
  throw new BpmnError("ERROR", errorMessage)
} 
/****************************/

//***Блок контроля Шага заполнения формы (ABB0600_STEP_FORM)******
//def stepForm = entityMetadata.prop("attributes").hasProp("ABB0600_STEP_FORM") ? entityMetadata.prop("attributes").prop("ABB0600_STEP_FORM").stringValue() : ""
def attributes = entityMetadata.prop("attributes")
def stepForm = (attributes.hasProp("ABB0600_STEP_FORM") &amp;&amp; !attributes.prop("ABB0600_STEP_FORM").isNull()) ? 
               attributes.prop("ABB0600_STEP_FORM").stringValue() : ""
if (stepForm == 'Ввод данных' || stepForm == '') {
  stepForm = 'Контроль данных'
  throw new BpmnError("UPDATE_STEP", stepForm)
}
//***End Блок контроля Шага заполнения формы (ABB0600_STEP_FORM)***

//Вариант 1: Если вам нужна обычная строка (String)
//Создаем чистую JSON-строку и Сохраняем как обычный текст (java.lang.String)
//def jsonString = JsonOutput.toJson(attributesMap)
//log.info("PROCESS [{}] jsonString: {}", processInstanceId, jsonString)
//execution.setVariable("attributesMap", jsonString) 
//Если jsonString будет длинее 4000 символов, возникнет ошибка Value too long (превысит лимит колонки TEXT_ в таблице ACT_RU_VARIABLE)

//Вариант 2: Если вы хотите использовать преимущества Spin
//Spin сам умеет превращать Map в JSON, JsonOutput не нужен
//execution.setVariable("attributesMap", S(attributesMap))
//ВАЖНО!!! При отправке в Delegate expression Body (в скрипте или выражении): ${attributesMap.toString()}
//Но возникает ERROR: SPIN-01001 Unsupported input of type 'java.util.LinkedHashMap'

//Вариант 3: -----------------------------------------
//Используйте метод JSON(...) вместо универсального S(...). Это заставит Spin работать со строкой как с сырым JSON-текстом.
//Превращаем Map в строгий JSON-текст (String) через Groovy
//Это уберет все LinkedHashMap и заменит их на текст
//def rawJsonString = JsonOutput.toJson(attributesMap)

//Сохраняем в переменную типа JSON (Spin), используя метод JSON()
//Это гарантирует запись в Bytearray (без лимита 4000)
//ВАЖНО!!! При отправке в Delegate expression Body (в скрипте или выражении): ${attributesMap.toString()}
//execution.setVariable("attributesMap", JSON(rawJsonString))
//End Вариант 3: -------------------------------------
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:intermediateThrowEvent id="Event_1n6cdv3" name="на Обработку ошибки">
      <bpmn:incoming>Flow_16y5q5d</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_1yfnk8x" name="linkError" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_0g8peea" name="на Обработку ошибки">
      <bpmn:incoming>Flow_16n2gjd</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_0l2kgv8" name="linkError" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_0nymuaf" name="на Обновление Шага формы">
      <bpmn:incoming>Flow_1kl5lv6</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_1kmxjc8" name="linkUpdateStep" />
    </bpmn:intermediateThrowEvent>
    <bpmn:boundaryEvent id="Event_1if494a" name="ERROR" attachedToRef="dataControl">
      <bpmn:outgoing>Flow_16y5q5d</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_09pbg0t" errorRef="Error_0aexqe7" camunda:errorCodeVariable="ERROR" camunda:errorMessageVariable="errorMessage" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_1six651" name="UPDATE STEP" attachedToRef="filingInitialExecutionList">
      <bpmn:outgoing>Flow_1kl5lv6</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0ihb3vz" errorRef="Error_1fgx0iq" camunda:errorCodeVariable="UPDATE_STEP" camunda:errorMessageVariable="stepForm" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_01c1kse" attachedToRef="filingInitialExecutionList">
      <bpmn:outgoing>Flow_16n2gjd</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1d7ugkl" errorRef="Error_0cyvybn" camunda:errorCodeVariable="ERROR" camunda:errorMessageVariable="errorMessage" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0491rza" sourceRef="getRequestUsersService" targetRef="dataControl" />
    <bpmn:sequenceFlow id="Flow_0noqp32" sourceRef="dataControl" targetRef="filingInitialExecutionList" />
    <bpmn:sequenceFlow id="Flow_16y5q5d" sourceRef="Event_1if494a" targetRef="Event_1n6cdv3" />
    <bpmn:sequenceFlow id="Flow_16n2gjd" sourceRef="Event_01c1kse" targetRef="Event_0g8peea" />
    <bpmn:sequenceFlow id="Flow_1kl5lv6" sourceRef="Event_1six651" targetRef="Event_0nymuaf" />
    <bpmn:sequenceFlow id="Flow_1n2o28n" sourceRef="setDocumentAttributes" targetRef="getRequestUsersService" />
    <bpmn:exclusiveGateway id="Gateway_0azwmrj">
      <bpmn:incoming>Flow_0jryjlz</bpmn:incoming>
      <bpmn:outgoing>Flow_03lffiq</bpmn:outgoing>
      <bpmn:outgoing>Flow_1x6euyt</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ugapy4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_1kq9mri" name="на Доработку">
      <bpmn:incoming>Flow_03lffiq</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_1nxh507" name="linkRevise" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_122ibhp" name="Отклонить">
      <bpmn:incoming>Flow_1x6euyt</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_0scewk1" name="linkDecline" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_03lffiq" sourceRef="Gateway_0azwmrj" targetRef="Event_1kq9mri">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${taskOutcome == 'TAB0600_REVISE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1x6euyt" sourceRef="Gateway_0azwmrj" targetRef="Event_122ibhp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${taskOutcome == 'TAB0600_DECLINE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_163qihc">
      <bpmn:incoming>Flow_0ugapy4</bpmn:incoming>
