    <bpmn:sequenceFlow id="Flow_0ugapy4" sourceRef="Gateway_0azwmrj" targetRef="Event_163qihc" />
    <bpmn:userTask id="FIN_FUNC_EXPERT" name="Финансовая экспертиза функции (FIN_FUNC_EXPERT)" camunda:asyncBefore="true" camunda:assignee="${personalUser}" camunda:dueDate="#{extensions.timeService.addCalendarDaysTillEndOfDay(3)}">
      <bpmn:documentation>Связанный документ</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="actions">TAB0600_ACCEPT,TAB0600_REVISE,TAB0600_DECLINE</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:taskListener delegateExpression="#{userTaskNotificationListener}" event="create" id="notificationListener">
          <camunda:field name="messageCode">
            <camunda:string>NTB0600_TASK_ASSIGNED</camunda:string>
          </camunda:field>
        </camunda:taskListener>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy" />
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">//Получаем текущие значения
def currentTaskId = execution.getVariable("currentTaskId")
def pid = execution.processInstanceId

//Определяем логгер
def logName = ""${processCode}_User_Task ${currentTaskId}"
def log = org.slf4j.LoggerFactory.getLogger(logName)
log.info("PROCESS [{}]: ---End Execution Listeners (end)---", pid)</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16dpqms</bpmn:incoming>
      <bpmn:outgoing>Flow_0jryjlz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_1qcrkhv" name="на Обработку ошибки">
      <bpmn:incoming>Flow_0phnkh3</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_13ogx04" name="linkError" />
    </bpmn:intermediateThrowEvent>
    <bpmn:scriptTask id="preStepFinFuncExpert" name="PRE STEP FIN_FUNC_EXPERT" scriptFormat="groovy">
      <bpmn:documentation>Действия перед назначением User Task</bpmn:documentation>
      <bpmn:incoming>Flow_0d8hnpd</bpmn:incoming>
      <bpmn:outgoing>Flow_16dpqms</bpmn:outgoing>
      <bpmn:script>/************************************************************ 
0600 Pre Step User Task - установка значения statusCode 
и определение Исполнителей перед выполнением User Task.
Groovy в Script Task перед User Task.
1.ВАЖНО!!! Ставится НЕПОСРЕДСТВЕННО перед User Task!!!!!!!!!!
************************************************************/
// JsonSlurper используется внутри Groovy-скриптов для парсинга JSON-строк в объекты Groovy (Map или List)
import groovy.json.JsonSlurper

// JsonBuilder - для преобразования объектов Groovy (Map, List, POGO) в строку формата JSON
//import groovy.json.JsonBuilder //Это «конструктор»

//Библиотека для преобразования объектов Groovy (Map, List) в формат JSON-строки
import groovy.json.JsonOutput //Это «молоток» для готовых данных

import static org.camunda.spin.Spin.*

//Для обработки throw new BpmnError (если есть)
import org.camunda.bpm.engine.delegate.BpmnError

//Ищем значение currentTaskId и другие атрибуты -----------------------
def currentTaskId = 'UNDEFINED'
def currentTaskName = 'UNDEFINED'
boolean isMultiInstance = false //User Task Multi-instance
boolean isSequential = null //Признак Последовательное выполнение (true) или Параллельное (false)

// Получаем текущий элемент (сам Script Task), на котором сейчас стоит токен
def currentFlowElement = execution.getBpmnModelElementInstance()
// Берем первую исходящий Flow от этого Script Task
def outgoingFlow = currentFlowElement.getOutgoing().find()

if (outgoingFlow != null) {
  // Получаем объект, на который указывает эта линия (Target)
  def targetElement = outgoingFlow.getTarget()

  // Проверяем, является ли цель User Task
  if (targetElement instanceof org.camunda.bpm.model.bpmn.instance.UserTask) {
    currentTaskId = targetElement.getId()
    currentTaskName = targetElement.getName() ?: 'No Name'
    
    // Ищем расширение Loop Characteristics (именно оно отвечает за Multi-instance)
    def loopCharacteristics = targetElement.getLoopCharacteristics()
    
    // Получаем характеристики цикла для User Task (именно оно отвечает за Multi-instance)
    isMultiInstance = loopCharacteristics != null
    
    //Для Multi-instance Task определяем тип выполнения Последовательный (true) или Параллельный (false)
    isSequential = isMultiInstance &amp;&amp; loopCharacteristics.isSequential()

  }
}
//End Ищем значение currentTaskId -----------------------------------------
execution.setVariable("currentTaskId", currentTaskId)
execution.setVariable("currentTaskName", currentTaskName) //На всякий случай
execution.setVariableLocal("isMultiInstance", isMultiInstance)
execution.setVariableLocal("isSequential", isSequential)

//Определяем логгер
def log = org.slf4j.LoggerFactory.getLogger("${processCode}_Pre_Step ${currentTaskId}")
def pid = execution.processInstanceId
log.info("PROCESS [{}] ---Start--", pid)

def errorMessage = "" //Изначально ошибки нет.

//Задаем значение Статуса (statusCode)
def statusCode = "DSB0600_${currentTaskId}"
if (currentTaskId == 'UNDEFINED') {
  errorMessage = "Не удалось найте значение currentTaskId"
  throw new BpmnError("ERROR", errorMessage)
}

//Зададим Local переменные для вызова метода PUT /private/documents/{guid}/_status
execution.setVariableLocal("serviceName", "documents")
execution.setVariableLocal("method", "PUT")
def fullPath = "private/documents/${entityGuid}/_status"
execution.setVariableLocal("path", fullPath)

def attributesMap = ["statusCode": statusCode]
log.info("PROCESS [{}] attributesMap: {}", pid, attributesMap)
//execution.setVariableLocal("body", attributesMap) //Портит данные!

//Для определения body буду использовать Вариант из скрипта filingInitialExecutionList
//Возможно, эти "танцы с бубуном" излишни, пусть эксперты подскажут более верный способ!
def rawJsonString = JsonOutput.toJson(attributesMap)
execution.setVariableLocal("body", JSON(rawJsonString).toString())

try {
  log.info("PROCESS [{}] Обновление Статуса fullPath: {} attributesMap: {}", pid, fullPath, attributesMap)
  restClient.execute(execution)

} catch (Exception e) {
  log.info("PROCESS [{}] Error call fullPath: {} attributesMap: {}", pid, fullPath, attributesMap)
  log.error("PROCESS [{}] e.message: {}", pid, e.message)
  
  errorMessage = "Не удалось обновить Статус"
  throw new BpmnError("ERROR", errorMessage)
} 

//После обновления надо бы получить значение statusTitle из настройки "Статусы документов",
//поскольку это значение используется в Уведомлении. Но как  это сделать пока не знаю!
//execution.setVariableLocal("statusTitle", statusTitle)

//Либо обновить значение entityMetadata, но для этого надо повторно запросить атрибуты документа
execution.setVariableLocal("serviceName", "documents")
execution.setVariableLocal("method", "GET")
fullPath = "private/documents/${entityGuid}"
execution.setVariableLocal("path", fullPath)
execution.setVariableLocal("resultVarName", "baseDocument") //возвращаемое значение

//На всякий случай:
//execution.setVariableLocal("pathParams", [:])
//execution.setVariableLocal("body", null)

log.info("PROCESS [{}] fullPath: {}", pid, fullPath)

try {
  restClient.execute(execution)
  log.info("PROCESS [{}] Обновление атрибутов Документа  baseDocument: {}", pid, baseDocument)
  execution.setVariable('baseDocument', baseDocument); //baseDocument - возращаемое значение
  //Обновляем entityMetadata
  def entityMetadata = S(baseDocument).prop('data')
  execution.setVariable('entityMetadata', entityMetadata);
  log.info("PROCESS [{}] Обновление атрибутов Документа entityMetadata: {}", pid, entityMetadata)

} catch (Exception e) {
  log.info("PROCESS [{}] Error call fullPath: {}", pid, fullPath)
  log.error("PROCESS [{}] e.message: {}", pid, e.message)
  
  errorMessage = "Не удалось получит атрибуты Документа"
  throw new BpmnError("ERROR", errorMessage)
} 

//--- Проверка настройки User Task в Modeler --------------------------
if (isMultiInstance &amp;&amp; !isSequential) {
    log.info("PROCESS [{}] Task: {} - PARALLEL Multi-instance", pid, currentTaskName)
} else if (isMultiInstance &amp;&amp; isSequential) {
    log.info("PROCESS [{}] Task: {} - SEQUENTIAL Multi-instance", pid, currentTaskName)
} else {
    log.info("PROCESS [{}] Task: {} - Standard Single", pid, currentTaskName)
}
//-- End Проверка настройки User Task в Modeler -----------------------

//Блок определения Исполнителей для currentTaskId ---------------------
//Находим текущего исполнителя (-лей) из setupStages для значени currentTaskId
def setupStages = execution.getVariable("setupStages") ?: [:]
log.info("PROCESS [{}] setupStages: {}", pid, setupStages)

def currentSetup = setupStages.get(currentTaskId) //setupStages[currentTaskId] - текущий этап

if (currentSetup &amp;&amp; !currentSetup.isEmpty()) {
    
  // Извлекаем ПЕРВОЕ значение assignmentType и userType (Тип исполнения)
  def firstEntry = currentSetup[0]
  def assignmentType = firstEntry.assignmentType
  def userType = firstEntry.userType
  def resultLog = ""

  if (1==2) {
    // Только для ТЕСТИРОВАНИЯ!!!!
    errorMessage = "Test ERROR for stage: ${currentTaskId}"

    //Вариант А: Создать инцидент (остановка процесса)
    //throw new Exception(errorMessage)

    //Вариант Б: Обработать на схеме (если есть Boundary Event)
    throw new BpmnError("ERROR", errorMessage)
    
  }

  //Блок поиска Исполнителей с возможностью Rollback
  try {
    if (1==2) {
      // Только для ТЕСТИРОВАНИЯ!!!!
      errorMessage = "Test ERROR for stage: ${currentTaskId}"
      // Выбрасываем ошибку, которую поймает наш catch ниже
      throw new Exception(errorMessage)

    } else if (userType == 'PERSONAL' &amp;&amp; !isMultiInstance) {
      if (assignmentType == 'USER') {
        //Назначение только на одного исполнителя (personalUser)
        execution.setVariable("personalUser", firstEntry.userId)
        log.info("PROCESS [{}] Установлен исполнитель: {}", pid, firstEntry.userId)

      } else if (assignmentType == 'USER_LIST') {
        //Назначение на candidateUsersList, перечень через запятую всех Кандидатов
        //Извлекаем ВСЕ userId в один список. В Groovy это делается через оператор разворота *.
        //def userIds = currentSetup*.userId //Объект java.util.ArrayList
        // Пример: ["ipanchenko", "sibaranov", "rkopytov"]

        // Безопасно собираем только непустые ID в строку через запятую
        def validUserIds = currentSetup*.userId.findAll { it &amp;&amp; !it.toString().trim().isEmpty() }
        
        if (validUserIds.isEmpty()) {
          errorMessage = "No valid candidate users found for stage: " + currentTaskId
          // Выбрасываем ошибку, которую поймает наш catch ниже
          throw new Exception(errorMessage)
        }

        // Назначение всех пользователей как кандидатов в задачу
        //ВАЖНО! Поэтому для списка всегда используйте Candidate Users
        //Переменная candidateUsersList должна быть указана в поле "Candidate Users" в Modeler.
        execution.setVariable("candidateUsersList", validUserIds.join(",")) // Для поля Candidate Users нужна строка через запятую
        log.info("PROCESS [{}] Установлены кандидаты: {}", pid, validUserIds)
      
      } else {
        errorMessage = "Unknown assignmentType: '${assignmentType}'for stage: " + currentTaskId
        // Выбрасываем ошибку, которую поймает наш catch ниже
        throw new Exception(errorMessage)
      }
      
    } else if (userType == 'PARALLEL' &amp;&amp; isMultiInstance &amp;&amp; !isSequential) {
      //Используем только для isMultiInstance==true и isSequential==false (параллельное выполнение)
      //Извлекаем ВСЕ userId в один список
      def userIds = currentSetup*.userId
      
      // Дополнительная проверка внутри списка
      if (userIds.any { it == null || it.toString().trim().isEmpty() }) {
        // Формируем текст для исключения
        errorMessage = "Parallel collection contains null or empty user IDs for stage: ${currentTaskId}"
        // Выбрасываем ошибку, которую поймает наш catch ниже
        throw new Exception(errorMessage)
      }

      // Переменная assigneeList должна быть указана в поле "Collection" в Modeler. 
      // Важно! Именно assigneeList (без ${})
      execution.setVariable("assigneeList", userIds)
      log.info("PROCESS [{}] Подготовлена коллекция для Multi-Instance: {}", pid, userIds)
    
    } else {
      errorMessage = "No assignment defined for stage: ${currentTaskId}"
      // Выбрасываем ошибку, которую поймает наш catch ниже
      throw new Exception(errorMessage)
    }

  } catch (Exception e) {
      // Логируем подробности в файл лога сервера (будет видно админу)
      log.error("PROCESS [{}]: CRITICAL ERROR: {}", pid, e.getMessage())
      log.error("PROCESS [{}]: Debug data for currentTaskId: {} currentSetup: {}", pid, currentTaskId, currentSetup)
      
      //Вариант от AI:
      // "Уронить" транзакцию, чтобы произошел Rollback к предыдущей задаче
      // Именно текст из RuntimeException часто пробрасывается в UI (Tasklist)
      //throw new RuntimeException(e.getMessage())
      
      //Мой вариант:
      throw new BpmnError("ERROR", errorMessage)
      //И на User Task добавляем Error Boundary Event
  }
}
//End Блок определения Исполнителей для currentTaskId -----------------

log.info("PROCESS [{}] ---End--", pid)
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:intermediateThrowEvent id="Event_1442r1l" name="на Обработку ошибки">
