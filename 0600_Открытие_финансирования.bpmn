      <bpmn:extensionElements>
        <camunda:executionListener event="take">
          <camunda:script scriptFormat="groovy">//def statusCode = "DSB0600_REVISE"
execution.setVariable("statusCode", "DSB0600_REVISE")</camunda:script>
