      <bpmn:errorEventDefinition id="ErrorEventDefinition_1q28yxh" errorRef="Error_0aexqe7" camunda:errorCodeVariable="ERROR" camunda:errorMessageVariable="errorMessage" />
    </bpmn:boundaryEvent>
