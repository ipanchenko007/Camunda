    <bpmn:serviceTask id="findDictionaryID" name="Find Dictionary ID" camunda:delegateExpression="#{restClient}">
      <bpmn:documentation>Поиск значение ID для Справочника LDB0600_REQUEST_USERS</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="serviceName">dictionaries</camunda:inputParameter>
          <camunda:inputParameter name="path">private/dictionaries?query=code==LDB0600_REQUEST_USERS</camunda:inputParameter>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="resultVarName">dictionaryInfo</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">def log = org.slf4j.LoggerFactory.getLogger("findDictionaryID")
def processInstanceId = execution.getProcessInstanceId()
log.info("PROCESS [{}] ---Start---", processInstanceId)</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">def log = org.slf4j.LoggerFactory.getLogger("findDictionaryID")
def processInstanceId = execution.getProcessInstanceId()

// 1. Проверяем наличие и заполненность переменной
if (execution.hasVariable("dictionaryInfo") &amp;&amp; execution.getVariable("dictionaryInfo") != null) {
    def info = execution.getVariable("dictionaryInfo")
    def dictionaryList = null

    try {
        // 2. Обработка типа JacksonJsonNode (Camunda Spin) - именно он завалил прошлый запуск
        if (info instanceof org.camunda.spin.json.SpinJsonNode || info.getClass().getName().contains("JsonNode")) {
            // Проверяем, есть ли свойство "data" и является ли оно массивом
            if (info.hasProp("data")) {
                // Извлекаем массив, превращаем первый элемент в Map и берем id
                def dataArray = info.prop("data")
                if (dataArray.isArray() &amp;&amp; dataArray.elements().size() &gt; 0) {
                    def firstElement = dataArray.elements().get(0)
                    // Извлекаем id в зависимости от того, как Spin отдает свойства
                    def dictId = firstElement.hasProp("id") ? firstElement.prop("id").numberValue() : null
                    
                    if (dictId != null) {
                        execution.setVariable("dictionaryId", dictId)
                        log.info("PROCESS [{}] [SpinNode] Successfully extracted dictionaryId: {}", processInstanceId, dictId)
                    }
                }
            }
        } 
        // 3. Резервный вариант: если пришла обычная Map (на случай изменений в платформе)
        else if (info instanceof java.util.Map) {
            dictionaryList = info.data
            if (dictionaryList &amp;&amp; !dictionaryList.isEmpty()) {
                def dictId = dictionaryList[0].id
                execution.setVariable("dictionaryId", dictId)
                log.info("PROCESS [{}] [Map] Successfully extracted dictionaryId: {}", processInstanceId, dictId)
            }
        } 
        // 4. Резервный вариант: если пришла сырая строка String
        else if (info instanceof java.lang.String) {
            def jsonSlurper = new groovy.json.JsonSlurper()
            def jsonObject = jsonSlurper.parseText(info)
            dictionaryList = jsonObject.data
            if (dictionaryList &amp;&amp; !dictionaryList.isEmpty()) {
                def dictId = dictionaryList[0].id
                execution.setVariable("dictionaryId", dictId)
                log.info("PROCESS [{}] [String] Successfully extracted dictionaryId: {}", processInstanceId, dictId)
            }
        }

        // Если после всех проверок id так и не записался
        if (execution.getVariable("dictionaryId") == null) {
            log.warn("PROCESS [{}] Dictionary ID could not be found in the response structure", processInstanceId)
            execution.setVariable("dictionaryId", null)
        }

    } catch (Exception e) {
        log.error("PROCESS [{}] Error while parsing JSON structure: {}", processInstanceId, e.getMessage(), e)
        execution.setVariable("dictionaryId", null)
    }

} else {
    log.error("PROCESS [{}] variable 'dictionaryInfo' is missing or null!", processInstanceId)
    execution.setVariable("dictionaryId", null)
}

log.info("PROCESS [{}] ---End---", processInstanceId)
</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
