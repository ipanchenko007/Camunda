      <bpmn:script>import java.util.logging.Logger

Logger logger = Logger.getLogger("PFD_ECM_LOG")

def jsonNode = execution.getVariable("ecmRes")

logger.info("ecmRes: " + jsonNode + 
            " processId: " + execution.getProcessInstanceId())

def ecmSuccess = jsonNode.prop("success").value()
def ecmMessage = jsonNode.prop("error").value()

execution.setVariable("ecmSuccess", ecmSuccess)
execution.setVariable("ecmMessage", ecmMessage)

</bpmn:script>
