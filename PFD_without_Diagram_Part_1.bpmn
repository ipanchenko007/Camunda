    <bpmn:scriptTask id="Activity_0veyy5n" name="Извлечение formData" scriptFormat="groovy">
      <bpmn:incoming>Flow_1u2jv2s</bpmn:incoming>
      <bpmn:outgoing>Flow_10tzl8e</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper

def taskAssignee = execution.getVariable('taskAssignee')
def formDataRaw = execution.getVariable('formData')

println "=====PROCESS LOG====="
println "Task Assignee: " + taskAssignee
println "Form Data raw: " + formDataRaw
println "===================="

def commentText = null
def commentAuthor = null

if (formDataRaw) {
    try {
        def formData = new JsonSlurper().parseText(formDataRaw.toString())
        println "Form Data parsed: " + formData

        // Извлекаем комментарии
        def standardComment = formData?.AB453_SELECT_STANDARD_COMMENT?.displayTitle
        def freeComment = formData?.AB_017_COMMENT

        println "Standard comment: '" + standardComment + "' (type: " + (standardComment?.getClass()) + ")"
        println "Free comment: '" + freeComment + "' (type: " + (freeComment?.getClass()) + ")"

        if (taskAssignee &amp;&amp; taskAssignee.toString().trim()) {
            commentAuthor = taskAssignee.toString().trim()
        }

        // Конкатенируем комментарии
        def parts = []
        if (standardComment != null &amp;&amp; standardComment.toString().trim()) {
            parts &lt;&lt; standardComment.toString().trim()
        }
        if (freeComment != null &amp;&amp; freeComment.toString().trim()) {
            parts &lt;&lt; freeComment.toString().trim()
        }

        commentText = parts ? parts.join(' ').trim() : null

        println "Parts array: " + parts
        println "Comment text extracted: '" + commentText + "'"
        println "Comment author: '" + commentAuthor + "'"

    } catch (Exception e) {
        println "JSON parse error: " + e.message
        commentText = null
    }
}

def documentGuid = execution.getVariable('entityGuid') ?:
    (Sdocument?.prop?.data?.prop?.guid?.stringValue ?: "MISSING_GUID")

execution.setVariable('commentText', commentText)
execution.setVariable('documentGuid', documentGuid)
execution.setVariable('commentAuthor', commentAuthor)

println "Variables prepared: commentText='" + commentText + "', commentAuthor='" + commentAuthor + "', documentGuid='" + documentGuid + "'"
</bpmn:script>
    </bpmn:scriptTask>
