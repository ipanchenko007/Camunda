    <bpmn:scriptTask id="Activity_0b2hbmq" name="Определить согласующих и подписанта" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_155tuv8</bpmn:incoming>
      <bpmn:outgoing>Flow_1895ll6</bpmn:outgoing>
      <bpmn:script>def attributes = S(document).prop("data").prop("attributes")
def isEDO = execution.getVariable("isEDO") as Boolean

if (attributes != null &amp;&amp; isEDO == true) {

  // определим согласующих
  def logins = []
  if (attributes.hasProp("AB033_APPROVER") &amp;&amp;
      attributes.prop("AB033_APPROVER") != null) {

    def approvers = attributes.prop("AB033_APPROVER")

    if (approvers.isArray()) {
      for (def approver : approvers.elements()) {
        def login = approver.prop("login").stringValue()
        if (login) {
          logins.add(login)
        }
      }
    } else {
      // одиночный объект
      def login = approvers.prop("login").stringValue()
      if (login) {
        logins.add(login)
      }
    }
  }

  execution.setVariable("approvers", logins)

  // BEEDOCS-4947: определим, нужен ли этап подписания
  // Типы исключения, для которых не требуется подписание:
  Set&lt;String&gt; exceptionTypes = Set.of(
    "TP_INVOICE",
    "TP_INVOICE_REVISION",
    "TP_INVOICE_CORRECTION",
    "TP_PROFORMAINVOICE",
    "TP_SERVICE_DETAILS"
  )

  // docsWithType должен быть заранее установлен (в Activity_0bgqzun) [file:1]
  def docsWithType = execution.getVariable("docsWithType")

  boolean allInExceptions = false
  if (docsWithType != null) {
    allInExceptions = docsWithType.stream()
      .allMatch { d -&gt; exceptionTypes.contains(d.docType) }
  }

  execution.setVariable("allInExceptions", allInExceptions)

  if (!allInExceptions) {
    // определим подписанта
    if (attributes.hasProp("AB423_SIGNATORY_EDO") &amp;&amp;
        !attributes.prop("AB423_SIGNATORY_EDO").isNull()) {

      def signatoryNode = attributes.prop("AB423_SIGNATORY_EDO")
      if (signatoryNode.hasProp("value") &amp;&amp;
          !signatoryNode.prop("value").isNull()) {

        execution.setVariable("signatory",
          signatoryNode.prop("value").stringValue())
      }
    }

    // для тестирования
    // if (attributes.hasProp("AB310_EDO_OPERATOR") &amp;&amp;
    //     !attributes.prop("AB310_EDO_OPERATOR").isNull() &amp;&amp;
    //     attributes.prop("AB310_EDO_OPERATOR").stringValue() == "testIVA") {
    //
    //   execution.setVariable("signatory", "ekatvlaivanova")
    // }
  }
}
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_1f6eexb" name="Определить согласующих и подписанта" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_0ilrpe9</bpmn:incoming>
      <bpmn:outgoing>Flow_04ijd13</bpmn:outgoing>
      <bpmn:script>def attributes = S(document).prop("data").prop("attributes")
if (attributes != null){
	if(isEDO==true){
		//определим согласующих
		def logins = []
		if (attributes.hasProp("AB033_APPROVER") &amp;&amp; attributes.prop("AB033_APPROVER")!=null) {
			def approvers = attributes.prop("AB033_APPROVER")
			if (approvers.isArray()) {
				for (def approver : approvers.elements()) {
					def login = approver.prop("login").stringValue()
					if (login) logins.add(login)
				}
			} else {
				// Обработка случая, если передан не массив, а одиночный объект
				def login = approvers.prop("login").stringValue()
				if (login) 
					logins.add(login)
			}
		}  
		execution.setVariable('approvers',logins);
		//определим подписанта
		execution.setVariable('signatory','');
		if (attributes.hasProp("AB423_SIGNATORY_EDO") &amp;&amp; !attributes.prop("AB423_SIGNATORY_EDO").isNull()) {
			def signatoryNode = attributes.prop("AB423_SIGNATORY_EDO")
			if (signatoryNode.hasProp("value") &amp;&amp; !signatoryNode.prop("value").isNull()) {
				execution.setVariable('signatory',signatoryNode.prop("value").stringValue());
			}
		}
	}
}
</bpmn:script>
    </bpmn:scriptTask>
