    <bpmn:scriptTask id="Activity_1vl0th1" name="Подготовка переменных" scriptFormat="groovy">
      <bpmn:incoming>Flow_0q28rse</bpmn:incoming>
      <bpmn:incoming>Flow_11i83je</bpmn:incoming>
      <bpmn:outgoing>Flow_1wtxgkx</bpmn:outgoing>
      <bpmn:script>def title= S(document).prop("data").prop("title").stringValue();
def lastComment="";
if(execution.hasVariable("lastTaskComment")){
   lastComment = lastTaskComment;
}

execution.setVariable('messageProperties', [messageTitle: title, packageId: entityGuid, lastTaskComment: lastComment, diadocComment: '', alert: '']);

if(!ecmSuccess){
  execution.setVariable("ecmComment", 'Во время передачи документов ECM возникла ошибка: '+ ecmMessage)
}
if(!DCM_PROCESSING_SUCCEDDED){
  execution.setVariable("ecmComment", 'Во время передачи документов ECM возникла ошибка: '+ DCM_PROCESSING_COMMENT)
}
</bpmn:script>
