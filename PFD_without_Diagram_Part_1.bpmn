    <bpmn:scriptTask id="Activity_1tzx57t" name="Поиск документов с типом &#34;Документ ПФД&#34;" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_0envt2z</bpmn:incoming>
      <bpmn:outgoing>Flow_1wesr5s</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import org.camunda.spin.Spin
import org.camunda.spin.json.SpinJsonNode
import com.fasterxml.jackson.databind.ObjectMapper

// Преобразуем SpinJsonNode в объект Groovy
def json = new JsonSlurper().parseText(documents.toString())

// Фильтруем только элементы с relationCode == "PACKAGE". Запоминаем guid и тип для BEEDOCS-4947
def mappedDocs = json.data.findAll { it.relationCode == "PACKAGE" }.collect { item -&gt;
    [
    guid: item.targetGuid,
    docType: item.targetType
  ]
}
// Сохраняем в процесс (строкой)
execution.setVariable("docsWithTypeEdo", mappedDocs);

// Ищем TP_EDO_DOCUMENT
def edoDocumentGuids = docsWithTypeEdo
        .findAll { it.docType == "TP_EDO_DOCUMENT" }
        .collect { item -&gt;
    [
        guid: item.guid
    ]
}

// Флаг
execution.setVariable(
        "hasEdoDocument",
        !edoDocumentGuids.isEmpty()
)

// Просто сохраняем List напрямую
execution.setVariable(
        "edoDocumentGuids",
        edoDocumentGuids
)

execution.setVariable("needBeeidpRecognition", false)</bpmn:script>
    </bpmn:scriptTask>
