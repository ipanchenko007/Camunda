    <bpmn:scriptTask id="Activity_14zjjl6" name="Проверка были ли добавлены новые документы на подписание" scriptFormat="groovy">
      <bpmn:incoming>Flow_1cixzcc</bpmn:incoming>
      <bpmn:outgoing>Flow_1ns4fvt</bpmn:outgoing>
      <bpmn:script>// документы с такими типами не требуют подписания
Set&lt;String&gt; exceptionTypes = Set.of(
        "TP_INVOICE",
        "TP_INVOICE_REVISION",
        "TP_INVOICE_CORRECTION",
        "TP_PROFORMAINVOICE",
        "TP_SERVICE_DETAILS"
)

// преобразуем preDocuments в Set guid для быстрого поиска
Set&lt;String&gt; preDocumentGuids = preDocuments
        .collect { it.guid }
        .toSet()

// нашли новые связанные документы
def newDocuments = docsWithType.findAll { doc -&gt;
    !preDocumentGuids.contains(doc.guid) &amp;&amp;
    !exceptionTypes.contains(doc.docType)
}

// diadocFullSign установим в true, если на доработку мы попали не с подписания и согласования
// и обновим его, если появились новые документы на подписание
if (diadocFullSign) {
    diadocFullSign = newDocuments.isEmpty()
    execution.setVariable("diadocFullSign", diadocFullSign)
}

  // docsWithType должен быть заранее установлен (в Activity_0bgqzun) [file:1]
  def docsWithType = execution.getVariable("docsWithType")

  boolean allInExceptions = false
  if (docsWithType != null) {
    allInExceptions = docsWithType.stream()
      .allMatch { d -&gt; exceptionTypes.contains(d.docType) }
  }

  execution.setVariable("allInExceptions", allInExceptions)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_15ywmut" name="Фильтр документов по связи" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_1e7ej95</bpmn:incoming>
      <bpmn:outgoing>Flow_08rm8d1</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import org.camunda.spin.Spin
import org.camunda.spin.json.SpinJsonNode
import com.fasterxml.jackson.databind.ObjectMapper
import java.util.logging.Logger

Logger logger = Logger.getLogger("PFD_LOG")


// Преобразуем SpinJsonNode в объект Groovy
def json = new JsonSlurper().parseText(documents.toString())

// Фильтруем только элементы с relationCode == "PACKAGE". Запоминаем guid и тип для BEEDOCS-4947
def mappedDocs = json.data.findAll { it.relationCode == "PACKAGE" }.collect { item -&gt;
    [
		guid: item.targetGuid,
		docType: item.targetType
	]
}
// Сохраняем в процесс (строкой)
execution.setVariable("docsWithType", mappedDocs);
//для использования в multi-instance оставим только guid
docs = mappedDocs.collect { item -&gt;
    [
		guid: item.guid
	]
}

execution.setVariable("documents", docs);
//для использования в expanded sub process
ObjectMapper objectMapper = new ObjectMapper();
execution.setVariable("packageDocuments", objectMapper.writeValueAsString(mappedDocs));

mappedDocs = json.data.findAll { it.relationCode == "BASE_DOCUMENT" }.collect { item -&gt;
    [guid: item.targetGuid]
}

execution.setVariable("baseDocuments", mappedDocs)
execution.setVariable("baseDocumentsStr", objectMapper.writeValueAsString(mappedDocs))

logger.info("packageIsClosed after revise: "+packageIsClosed);</bpmn:script>
    </bpmn:scriptTask>
