    <bpmn:serviceTask id="Activity_1q2tddr" name="Запрос связанных документов" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
          <camunda:inputParameter name="path">private/documents/{guid}/relations</camunda:inputParameter>
