    <bpmn:scriptTask id="Activity_1dvpazv" name="Фильтр документов по связи" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_005wowd</bpmn:incoming>
      <bpmn:outgoing>Flow_1cpgy08</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import org.camunda.spin.Spin
import org.camunda.spin.json.SpinJsonNode
import com.fasterxml.jackson.databind.ObjectMapper

// Преобразуем SpinJsonNode в объект Groovy
def json = new JsonSlurper().parseText(documents.toString())

// Фильтруем только элементы с relationCode == "PACKAGE". Запоминаем guid и тип для BEEDOCS-4947
def mappedDocs = json.data.findAll { it.relationCode == "PACKAGE" }.collect { item -&gt;
    [
		guid: item.targetGuid,
		docType: item.targetType
	]
}
// Сохраняем в процесс (строкой)
execution.setVariable("docsWithType", mappedDocs);
//для использования в multi-instance оставим только guid
docs = mappedDocs.collect { item -&gt;
    [
		guid: item.guid
	]
}

execution.setVariable("documents", docs);
//для использования в expanded sub process
ObjectMapper objectMapper = new ObjectMapper();
execution.setVariable("packageDocuments", objectMapper.writeValueAsString(mappedDocs));

mappedDocs = json.data.findAll { it.relationCode == "BASE_DOCUMENT" }.collect { item -&gt;
    [guid: item.targetGuid]
}

execution.setVariable("baseDocuments", mappedDocs)
execution.setVariable("baseDocumentsStr", objectMapper.writeValueAsString(mappedDocs))

</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_1k5gyif" name="Проверить наличине номера ЗП" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_0psohj6</bpmn:incoming>
      <bpmn:outgoing>Flow_1kg3um6</bpmn:outgoing>
      <bpmn:script>def attrs = S(document).prop("data").prop("attributes")

// Если нет ZP — сразу выходим
if (!attrs.hasProp("ZP")) {
    execution.setVariable("purchaseOrderNumber", false)
    return
}

def zp = attrs.prop("ZP")
if (zp.isNull() || zp.elements().isEmpty()) {
    execution.setVariable("purchaseOrderNumber", false)
    return
}

def orderNumber = null

zp.elements().each { item -&gt;
    if (item.hasProp("AB296_PURCHASE_ORDER_NUMBER")) {
        def node = item.prop("AB296_PURCHASE_ORDER_NUMBER")

        if (!node.isNull()) {
            // Парсинг: и для String, и для Number
            String value = null

            if (node.isString()) {
                value = node.stringValue()
            } else if (node.isNumber()) {
                value = node.numberValue().toString()
            }

            if (value) {
                orderNumber = value
                return   // выходим из each, когда нашли первый номер
            }
        }
    }
}


execution.setVariable("purchaseOrderNumber", orderNumber != null)</bpmn:script>
    </bpmn:scriptTask>
