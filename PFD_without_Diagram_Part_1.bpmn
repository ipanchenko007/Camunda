    <bpmn:scriptTask id="Activity_17irr9s" name="Подготовка переменных" scriptFormat="groovy">
      <bpmn:incoming>Flow_0w5k2vh</bpmn:incoming>
      <bpmn:outgoing>Flow_0zhlgpq</bpmn:outgoing>
      <bpmn:script>def title= S(document).prop("data").prop("title").stringValue();
def lastComment="";
if(execution.hasVariable("lastTaskComment")){
   lastComment = lastTaskComment;
}

execution.setVariable('messageProperties', [messageTitle: title, packageId: entityGuid, lastTaskComment: lastComment, diadocComment: '', alert: '']);

//блок определения кнопок для этапа Подписать документ
def actions = "TA010_REJECT,TA015_REWORK";
def outcome = execution.getVariable("taskOutcome");
if (outcome != 'TA051_REJECT_REQUEST_PFD')
    actions = actions +",TA009_SIGN";

execution.setVariable('userActions', actions);		
//---
//execution.setVariable('signatory', 'ekatvlaivanova')

//Определение наименования задачи подписания
def folderCode = execution.getVariable("EDF_PROCESSING_FOLDER_CODE")

if (folderCode != null) {
    switch (folderCode.toString()) {
        case "READY_FOR_SIGNATURE":
            execution.setVariable("signTaskName", "Подписать документы без дополнительных проверок")
            break
        case "CHECK_BEFORE_SIGNATURE":
            execution.setVariable("signTaskName", "Необходима дополнительная проверка перед подписанием")
            break
        case "ENERGY_MANAGER":
            execution.setVariable("signTaskName", "Необходимо согласование с энергетиком перед подписанием")
            break
    }
}</bpmn:script>
    </bpmn:scriptTask>
