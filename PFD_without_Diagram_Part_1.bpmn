    <bpmn:scriptTask id="Activity_011pr7j" name="Подготовка документов к подписанию" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_1d5gezz</bpmn:incoming>
      <bpmn:outgoing>Flow_1es23zd</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import java.util.logging.Logger
import com.fasterxml.jackson.databind.ObjectMapper

Logger logger = Logger.getLogger("PFD_DIADOC_LOG")
ObjectMapper objectMapper = new ObjectMapper()

// 1. guids = Spin JSON STRING → обычная строка
// список подкументов, по которым выполнено подписание/отказ от подписания
def guidsString = ""
if(guids instanceof String){
  guidsString = guids
}else{
  guidsString = guids.stringValue()
}

// 2. строку JSON → List
def guidsList = new JsonSlurper().parseText(guidsString)

// 3. Формируем List&lt;Map&gt; для multi-instance
def sdocumentsList = guidsList.collect { [guid: it] }

// 4. Сохраняем
execution.setVariable("sdocuments", sdocumentsList)
execution.setVariable("signedDocuments", objectMapper.writeValueAsString(sdocumentsList))

// 5. sType (тоже STRING в JSON)
// sign/reject - подписано/отказано в подписи
def sTypeValue = ""
if (sType instanceof String){
  sTypeValue = sType 
}else{
  sTypeValue = sType.stringValue()
}

execution.setVariable("sType", sTypeValue)

def diadocStateCode = sType=='sign'?'DS049_CONFIRMATION_AWAITING_DELIVERY':'DS047_REJECTED_AWAITING_DELIVERY';
execution.setVariable('diadocStateCode',diadocStateCode);
// 6. fullReject (тоже BOOLEAN в JSON)
// если был отказ в подписи, то фронта приходит fullReject:
// * true - полный отказ от подписания =&gt; пакет будет переведен в статус Удален вместе со всеми его документами
// * false - частичный отказ от подписания =&gt; пакет будет переведен на доработку инициатору после чего выбранные документы будут удалены из пакета
execution.setVariable("partialReject", false)
if (execution.hasVariable("fullReject") &amp;&amp; fullReject != null) {
    def fullRejectValue = fullReject.boolValue()
    execution.setVariable("fullRejectBool", fullRejectValue)
    if(!fullRejectBool) execution.setVariable("partialReject", true)		
} 
//первый раз запускаем отправку в диадок
execution.setVariable("diadocRepeat",false);

logger.info(
    "prepared: ${sdocumentsList} " +
    "processId: ${execution.getProcessInstanceId()}"
)

logger.info("packageIsClosed after sign: "+packageIsClosed);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1es23zd" sourceRef="Activity_011pr7j" targetRef="Event_0qgq0as" />
    <bpmn:scriptTask id="Activity_18yple9" name="Определить согласующих и подписанта" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_0m8q26l</bpmn:incoming>
      <bpmn:outgoing>Flow_1qjuahu</bpmn:outgoing>
      <bpmn:script>def attributes = S(document).prop("data").prop("attributes")
if (attributes != null){
     def isEDO = attributes.hasProp("AB310_EDO_OPERATOR") &amp;&amp;         !attributes.prop("AB310_EDO_OPERATOR").isNull();
	execution.setVariable('isEDO',isEDO);
	if(isEDO==true){
		//определим согласующих
		def logins = []
		if (attributes.hasProp("AB033_APPROVER") &amp;&amp; attributes.prop("AB033_APPROVER")!=null) {
			def approvers = attributes.prop("AB033_APPROVER")
			if (approvers.isArray()) {
				for (def approver : approvers.elements()) {
					def login = approver.prop("login").stringValue()
					if (login) logins.add(login)
				}
			} else {
				// Обработка случая, если передан не массив, а одиночный объект
				def login = approvers.prop("login").stringValue()
				if (login) 
					logins.add(login)
			}
		}  
		execution.setVariable('approvers',logins);
		//определим подписанта
		execution.setVariable('signatory','');
		if (attributes.hasProp("AB423_SIGNATORY_EDO") &amp;&amp; !attributes.prop("AB423_SIGNATORY_EDO").isNull()) {
			def signatoryNode = attributes.prop("AB423_SIGNATORY_EDO")
			if (signatoryNode.hasProp("value") &amp;&amp; !signatoryNode.prop("value").isNull()) {
				execution.setVariable('signatory',signatoryNode.prop("value").stringValue());
			}
		}
	}
}
</bpmn:script>
    </bpmn:scriptTask>
