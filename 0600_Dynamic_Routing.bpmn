        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">//Инициализируем логгер динамическим именем (включая код процесса)
def log = org.slf4j.LoggerFactory.getLogger("${processCode}_setDocumentAttributes")

//Получаем ID инстанса процесса
def processInstanceId = execution.getProcessInstanceId()

//Парсим JSON и сохраняем его в переменную процесса Camunda
def metadata = S(baseDocument).prop('data')
execution.setVariable('entityMetadata', metadata)

//Логируем результат (при необходимости)
//log.info("PROCESS [{}] Check entityMetadata: {}", processInstanceId, metadata)</camunda:script>
        </camunda:executionListener>
