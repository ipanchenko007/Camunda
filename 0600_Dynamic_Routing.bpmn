      <bpmn:outgoing>Flow_19al8ty</bpmn:outgoing>
      <bpmn:script>/* 0600 Script Task "Create ErrorMap" (createErrorMap) */
// JsonBuilder - для преобразования объектов Groovy (Map, List, POGO) в строку формата JSON
import groovy.json.JsonBuilder
def log = org.slf4j.LoggerFactory.getLogger("${processCode}_createErrorMap")
def processInstanceId = execution.getProcessInstanceId()

def errorMsg = execution.getVariable("errorMessage")
//log.info("PROCESS [{}] Received errorMsg: {}", processInstanceId, errorMsg)

// Используем конструктор JsonBuilder для создания валидной JSON-строки
def errorMapJson = new JsonBuilder(["ERROR_MESSAGE": errorMsg, "ERROR_FLAG_YN":"Y"]).toString()

//Сохраняем в переменную процесса
execution.setVariable("errorMap", errorMapJson)
//log.info("PROCESS [{}] Created errorMap: {}", processInstanceId, errorMapJson)
</bpmn:script>
    </bpmn:scriptTask>
