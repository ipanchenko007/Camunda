<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di_1="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi_1="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://omg.org" xmlns:xsi="http://w3.org" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1il8meu" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:error id="Error_Reject" name="ProcessRejectedError" errorCode="PROCESS_REJECTED" />
  <bpmn:error id="Error_Revision" name="ProcessRevisionError" errorCode="PROCESS_REVISION" />
  <bpmn:process id="PIB0600_DYNAMIC_ROUTING" name="0600 Динамическое согласование" isExecutable="true" camunda:historyTimeToLive="365">
    <bpmn:startEvent id="StartEvent_1" name="StartEvent_1">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">/* 0600 Start Event (Execution listeners: End) "StartEvent_1" (StartEvent_1) */
/* Заполнение начальных значений процесса */
import java.text.SimpleDateFormat

// Задаем BusinessKey Склеиваем префикс и часть системного ID
def date = new SimpleDateFormat("yyyyMMdd").format(new Date())
def random = Math.abs(new Random().nextInt() % 1000).toString().padLeft(3, '0')
def bKey = "PROC-${date}-${random}"
execution.setProcessBusinessKey(bKey)

// Получаем системные данные (из кэша движка)
def processInstanceId = execution.processInstanceId 
def processDefinition = execution.processEngineServices.repositoryService
    .getProcessDefinition(execution.processDefinitionId)

// Достаем Имя процесса из этого объекта
def processName = processDefinition.name ?: "UNKNOWN Process"

// Определяем processCode (берем символы до первого пробела)
def processCode = processName.takeWhile { it != ' ' } 

// Сохраняем ВСЕ в ГЛОБАЛЬНЫЕ переменные процесса (Map-синтаксис)
execution.setVariables(
  ["processInstanceId": processInstanceId
  ,"processName": processName
  ,"processCode": processCode
  ])

//Определим логер
def log = org.slf4j.LoggerFactory.getLogger("${processCode}_Start_Event")

//log.info("PROCESS: [${processInstanceId}] processCode: '${processCode}' processName: '${processName}'")
log.info("PROCESS: [{}] processCode: '{}' processName: '{}'", processInstanceId, processCode, processName)

// Выведет все текущие переменные процесса в формате {key1=val1, key2=val2}
if (log.isDebugEnabled()) {
    log.debug("PROCESS [{}]: ALL VARS: {}", processInstanceId, execution.variables)
}</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToAnchor</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="DynamicStepsSubprocess" name="Последовательный обход шагов маршрута">
      <bpmn:incoming>Flow_1bifo73</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="steps" camunda:elementVariable="currentStep" />
      <bpmn:startEvent id="SubStart" name="Начало шага">
        <bpmn:outgoing>Flow_1pruknz</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="Gateway_StepType" name="Какой тип шага?" default="Flow_ToSingle">
        <bpmn:incoming>Flow_0y8jidx</bpmn:incoming>
        <bpmn:outgoing>Flow_ToSingle</bpmn:outgoing>
        <bpmn:outgoing>Flow_ToParallel</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_SingleOrGroup" name="${currentStep.name}" camunda:dueDate="#{extensions.timeService.addCalendarDaysTillEndOfDay(currentStep.working_days)}">
        <bpmn:documentation>${S(baseDocument).prop("data").prop("typeTitle").stringValue()} № ${S(baseDocument).prop("data").prop("projectNumber").stringValue()}</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:taskListener event="create">
            <camunda:script scriptFormat="groovy">// В Task Listener объект контекста процесса извлекается через task.getExecution()
def ctx = task.getExecution()
def step = ctx.getVariable("currentStep")

if (step != null &amp;&amp; step.actions != null) {
    // Безопасно пишем переменную в локальный контекст самой задачи
    task.setVariableLocal("actions", step.actions.toString())
    
    // Если Симфония требует дублирования в локальный контекст исполнения:
    ctx.setVariableLocal("actions", step.actions.toString())
}
</camunda:script>
          </camunda:taskListener>
          <camunda:inputOutput>
            <camunda:inputParameter name="disableDefaultNotifications">${true}</camunda:inputParameter>
            <camunda:inputParameter name="actions">${currentStep.actions}</camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:executionListener event="start">
            <camunda:script scriptFormat="groovy">//Смотрим пример формирования в процессе "Отправка уведомлений задачи пользователя" (UserTaskNotificationDelegateProcess)
execution.setVariable('messageProperties', [commentText: 'Сюда добавим комментарий'])</camunda:script>
          </camunda:executionListener>
          <camunda:taskListener event="create">
            <camunda:script scriptFormat="groovy">// Извлекаем текущий шаг из контекста выполнения
def step = task.getExecution().getVariable("currentStep")

if (step != null) {
    // 1. Персональное назначение
    if (step.assignee != null &amp;&amp; step.assignee != "") {
        task.setAssignee(step.assignee.toString())
    }
    
    // 2. Группы кандидатов (Роли)
    if (step.candidateGroup != null &amp;&amp; step.candidateGroup != "") {
        // Метод принимает коллекцию строк
        def groups = step.candidateGroup.toString().split(",").collect { it.trim() }
        task.addCandidateGroups(groups)
    }
    
    // 3. Пользователи-кандидаты
    if (step.candidateUsers != null &amp;&amp; step.candidateUsers != "") {
        // Метод принимает коллекцию строк
        def users = step.candidateUsers.toString().split(",").collect { it.trim() }
        task.addCandidateUsers(users)
    }
}
</camunda:script>
          </camunda:taskListener>
          <camunda:taskListener delegateExpression="#{userTaskNotificationListener}" event="create" id="notificationListener">
            <camunda:field name="messageCode">
              <camunda:string>NTB0600_TASK_ASSIGNED</camunda:string>
            </camunda:field>
            <camunda:field name="properties">
              <camunda:expression>${messageProperties}</camunda:expression>
            </camunda:field>
          </camunda:taskListener>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ToSingle</bpmn:incoming>
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Task_Parallel" name="${currentStep.name} (Параллельно)" camunda:assignee="${assigneeLoop}" camunda:dueDate="#{extensions.timeService.addCalendarDaysTillEndOfDay(currentStep.working_days)}">
        <bpmn:documentation>${S(baseDocument).prop("data").prop("typeTitle").stringValue()} № ${S(baseDocument).prop("data").prop("projectNumber").stringValue()}</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="disableDefaultNotifications">${true}</camunda:inputParameter>
            <camunda:inputParameter name="actions">${currentStep.actions}</camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:executionListener event="start">
            <camunda:script scriptFormat="groovy">//Смотрим пример формирования в процессе "Отправка уведомлений задачи пользователя" (UserTaskNotificationDelegateProcess)
execution.setVariable('messageProperties', [commentText: 'Сюда добавим комментарий'])</camunda:script>
          </camunda:executionListener>
          <camunda:taskListener delegateExpression="#{userTaskNotificationListener}" event="create" id="notificationListener">
            <camunda:field name="messageCode">
              <camunda:string>NTB0600_TASK_ASSIGNED</camunda:string>
            </camunda:field>
            <camunda:field name="properties">
              <camunda:expression>${messageProperties}</camunda:expression>
            </camunda:field>
          </camunda:taskListener>
          <camunda:taskListener event="complete">
            <camunda:script scriptFormat="groovy">/* Проверка является ли taskOutcome Глобальной или Локальной  */
def log = org.slf4j.LoggerFactory.getLogger("TEST_VARIABLE_CHECK")
def taskId = task.id

// Проверяем, есть ли переменная строго в локальном контексте задачи
def isLocal = task.getVariablesLocal().containsKey("taskOutcome")
def localVal = task.getVariableLocal("taskOutcome")

// Проверяем, есть ли переменная на уровне всего процесса
def isGlobal = task.getExecution().getVariables().containsKey("taskOutcome")
def globalVal = task.getExecution().getVariable("taskOutcome")

log.info("--- ПРОВЕРКА TASK ID: ${taskId} ---")
log.info("Локальная переменная (Task-local): существует = ${isLocal}, значение = ${localVal}")
log.info("Глобальная переменная (Process): существует = ${isGlobal}, значение = ${globalVal}")
</camunda:script>
          </camunda:taskListener>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ToParallel</bpmn:incoming>
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics camunda:collection="parallelAssigneesList" camunda:elementVariable="assigneeLoop">
          <bpmn:completionCondition xsi_1:type="bpmn:tFormalExpression">${taskOutcome == 'TAB0600_REVISE' or taskOutcome == 'TAB0600_DECLINE'}</bpmn:completionCondition>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_Merge">
        <bpmn:incoming>Flow_3</bpmn:incoming>
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_ToCheck</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_CheckResult" name="Результат шага?" default="Flow_StepApproved">
        <bpmn:incoming>Flow_ToCheck</bpmn:incoming>
        <bpmn:outgoing>Flow_StepApproved</bpmn:outgoing>
        <bpmn:outgoing>Flow_StepRejected</bpmn:outgoing>
        <bpmn:outgoing>Flow_StepRevision</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SubEnd" name="Конец шага">
        <bpmn:incoming>Flow_StepApproved</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="Event_ThrowReject" name="Выброс отказа">
        <bpmn:incoming>Flow_StepRejected</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_3" errorRef="Error_Reject" />
      </bpmn:endEvent>
      <bpmn:endEvent id="Event_ThrowRevision" name="Выброс на доработку">
        <bpmn:incoming>Flow_StepRevision</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_5" errorRef="Error_Revision" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ToSingle" name="Flow to Single" sourceRef="Gateway_StepType" targetRef="Task_SingleOrGroup" />
      <bpmn:sequenceFlow id="Flow_ToParallel" name="Flow to Parallel (Take)" sourceRef="Gateway_StepType" targetRef="Task_Parallel">
        <bpmn:extensionElements>
          <camunda:executionListener event="take">
            <camunda:script scriptFormat="groovy">// Получаем текущий шаг подпроцесса
def step = execution.getVariable("currentStep")
def cleanCollection = new java.util.ArrayList()

if (step != null &amp;&amp; step.parallelAssignees != null) {
    // Безопасно извлекаем элементы, независимо от того, SPIN это или массив
    def rawList = step.parallelAssignees
    
    if (rawList instanceof org.camunda.spin.json.SpinJsonNode) {
        cleanCollection = rawList.mapTo(java.util.List.class)
    } else {
        rawList.each { item -&gt; 
            if (item != null &amp;&amp; item.toString() != "") {
                cleanCollection.add(item.toString())
            }
        }
    }
}

// Записываем чистую плоскую Java-коллекцию в контекст выполнения
execution.setVariable("parallelAssigneesList", cleanCollection)
</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:conditionExpression xsi_1:type="bpmn:tFormalExpression">${currentStep.assignment_type == 'PARALLEL'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SingleOrGroup" targetRef="Gateway_Merge" />
      <bpmn:sequenceFlow id="Flow_4" name="See: Take" sourceRef="Task_Parallel" targetRef="Gateway_Merge">
        <bpmn:extensionElements>
          <camunda:executionListener event="take">
            <camunda:script scriptFormat="groovy">/* Для прерывания выполнения, если один из пользователей отправил на Доработку или Отклонил */
import org.camunda.bpm.engine.delegate.BpmnError

// Извлекаем результат, который зафиксировал первый нажавший пользователь
def outcome = execution.getVariable("taskOutcome")

if (outcome == "TAB0600_REVISE") {
    // Важно: Удаляем переменную перед выбросом ошибки, чтобы очистить память процесса для будущих кругов
    execution.removeVariable("taskOutcome")
    throw new BpmnError("PROCESS_REVISION")
    
} else if (outcome == "TAB0600_DECLINE") {
    // Удаляем переменную перед выбросом ошибки отказа
    execution.removeVariable("taskOutcome")
    throw new BpmnError("PROCESS_REJECTED")
}
</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ToCheck" sourceRef="Gateway_Merge" targetRef="Gateway_CheckResult" />
      <bpmn:sequenceFlow id="Flow_StepApproved" name="Успешно" sourceRef="Gateway_CheckResult" targetRef="SubEnd" />
      <bpmn:sequenceFlow id="Flow_StepRejected" name="Отклонено" sourceRef="Gateway_CheckResult" targetRef="Event_ThrowReject">
        <bpmn:conditionExpression xsi_1:type="bpmn:tFormalExpression">${taskOutcome == 'TAB0600_DECLINE'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_StepRevision" name="В самое начало" sourceRef="Gateway_CheckResult" targetRef="Event_ThrowRevision">
        <bpmn:conditionExpression xsi_1:type="bpmn:tFormalExpression">${taskOutcome == 'TAB0600_REVISE'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_1pruknz" sourceRef="SubStart" targetRef="prepareCurrentStage">
        <bpmn:extensionElements />
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0y8jidx" sourceRef="prepareCurrentStage" targetRef="Gateway_StepType" />
      <bpmn:subProcess id="prepareCurrentStage" name="Подготовка текущего этапа">
        <bpmn:incoming>Flow_1pruknz</bpmn:incoming>
        <bpmn:outgoing>Flow_0y8jidx</bpmn:outgoing>
        <bpmn:serviceTask id="Activity_19sbl5i" name="Установка статуса" camunda:delegateExpression="#{restClient}">
          <bpmn:extensionElements>
            <camunda:inputOutput>
              <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
              <camunda:inputParameter name="path">/private/documents/{guid}/_status</camunda:inputParameter>
              <camunda:inputParameter name="pathParams">
                <camunda:map>
                  <camunda:entry key="guid">${entityGuid}</camunda:entry>
                </camunda:map>
              </camunda:inputParameter>
              <camunda:inputParameter name="method">PUT</camunda:inputParameter>
              <camunda:inputParameter name="resultVarName">putStatusResponse</camunda:inputParameter>
              <camunda:inputParameter name="body">
                <camunda:map>
                  <camunda:entry key="statusCode">${'DSB0600_'.concat(currentStep.code)}</camunda:entry>
                </camunda:map>
              </camunda:inputParameter>
            </camunda:inputOutput>
            <camunda:executionListener event="start">
              <camunda:script scriptFormat="groovy">def log = org.slf4j.LoggerFactory.getLogger("prepareCurrentStage -&gt; Activity_19sbl5i")
def step = execution.getVariable("currentStep")
//log.info("PROCESS [{}] -&gt; ОТПРАВКА PUT ЗАПРОСА. Ожидаемый статус: [DSB0600_{}]", execution.getProcessInstanceId(), step?.code)    </camunda:script>
            </camunda:executionListener>
            <camunda:executionListener event="end">
              <camunda:script scriptFormat="groovy">def log = org.slf4j.LoggerFactory.getLogger("prepareCurrentStage -&gt; Activity_19sbl5i")
def processInstanceId = execution.getProcessInstanceId()

// Читаем из новой изолированной переменной
def apiResponse = execution.getVariable("putStatusResponse")
        
//log.info("PROCESS [{}] -&gt; ИСТИННЫЙ ОТВЕТ СЕРВЕРА СИМФОНИИ НА СМЕНУ СТАТУСА: {}", processInstanceId, apiResponse)       </camunda:script>
            </camunda:executionListener>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1s4llhj</bpmn:incoming>
          <bpmn:outgoing>Flow_0vz0nc4</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:startEvent id="Event_0sfy3ep">
          <bpmn:outgoing>Flow_1s4llhj</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_1s4llhj" sourceRef="Event_0sfy3ep" targetRef="Activity_19sbl5i" />
        <bpmn:endEvent id="Event_12udmw9">
          <bpmn:incoming>Flow_1nfnt4w</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_0vz0nc4" sourceRef="Activity_19sbl5i" targetRef="Activity_1ptyz6q" />
        <bpmn:serviceTask id="Activity_0c4gole" name="Обновление документа (attributes)" camunda:delegateExpression="#{restClient}">
          <bpmn:extensionElements>
            <camunda:inputOutput>
              <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
              <camunda:inputParameter name="path">private/documents/{guid}/_attributes</camunda:inputParameter>
              <camunda:inputParameter name="method">PUT</camunda:inputParameter>
              <camunda:inputParameter name="pathParams">
                <camunda:map>
                  <camunda:entry key="guid">${entityGuid}</camunda:entry>
                </camunda:map>
              </camunda:inputParameter>
              <camunda:inputParameter name="body">${stepFormMap}</camunda:inputParameter>
            </camunda:inputOutput>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1gy8176</bpmn:incoming>
          <bpmn:outgoing>Flow_1nfnt4w</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_1nfnt4w" sourceRef="Activity_0c4gole" targetRef="Event_12udmw9" />
        <bpmn:sequenceFlow id="Flow_1gy8176" sourceRef="Activity_1ptyz6q" targetRef="Activity_0c4gole" />
        <bpmn:scriptTask id="Activity_1ptyz6q" name="Create StepFormMap" scriptFormat="groovy">
          <bpmn:incoming>Flow_0vz0nc4</bpmn:incoming>
          <bpmn:outgoing>Flow_1gy8176</bpmn:outgoing>
          <bpmn:script>// JsonBuilder - для преобразования объектов Groovy (Map, List, POGO) в строку формата JSON
import groovy.json.JsonBuilder
def log = org.slf4j.LoggerFactory.getLogger("prepareCurrentStage -&gt; Create StepFormMap")
def processInstanceId = execution.getProcessInstanceId()

def step = execution.getVariable("currentStep")

// Безопасно извлекаем и приводим свойства к java.lang.String
def currentCode = step?.code?.toString() ?: ""
def currentName = step?.name?.toString() ?: ""

// Напрямую забираем готовый массив Java из контекста процесса
def rawInitialList = execution.getVariable("INITIAL_EXECUTION_LIST") ?: []

// Используем конструктор JsonBuilder для создания валидной JSON-строки
def stepFormJson = new JsonBuilder([
    "ABB0600_STAGE_CODE": currentCode
   ,"ABB0600_STAGE_NAME": currentName
   ,"INITIAL_EXECUTION_LIST": rawInitialList // Передаем напрямую как объект Java-List
]).toString()

// Сохраняем в переменную процесса
execution.setVariable("stepFormMap", stepFormJson)

// Очищаем переменную результата предыдущего шага перед началом текущего,
// чтобы избежать наложения данных на одиночных или параллельных этапах
execution.removeVariable("taskOutcome")

log.info("PROCESS [{}] stepFormMap: [{}]", execution.getProcessInstanceId(), stepFormJson) </bpmn:script>
        </bpmn:scriptTask>
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Event_CatchRevision" name="Перехват доработки" attachedToRef="DynamicStepsSubprocess">
      <bpmn:outgoing>Flow_ToGlobalRevision</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Rev" errorRef="Error_Revision" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_CatchReject" name="Полный отказ" attachedToRef="DynamicStepsSubprocess">
      <bpmn:outgoing>Flow_ToRejectTask</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_4" errorRef="Error_Reject" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_GlobalRevision" name="Доработка (REVISE)" camunda:asyncBefore="true" camunda:assignee="${initiator}" camunda:dueDate="#{extensions.timeService.addCalendarDaysTillEndOfDay(1)}" camunda:priority="150">
      <bpmn:documentation>${S(baseDocument).prop("data").prop("typeTitle").stringValue()} № ${S(baseDocument).prop("data").prop("projectNumber").stringValue()}</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="#{userTaskNotificationListener}" event="create" id="notificationListener">
          <camunda:field name="messageCode">
            <camunda:string>NTB0600_TASK_ASSIGNED</camunda:string>
          </camunda:field>
          <camunda:field name="properties">
            <camunda:expression>${messageProperties}</camunda:expression>
          </camunda:field>
        </camunda:taskListener>
        <camunda:inputOutput>
          <camunda:inputParameter name="actions">TAB0600_REAPPROVE,TAB0600_DECLINE</camunda:inputParameter>
          <camunda:inputParameter name="disableDefaultNotifications">${true}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">//Смотрим пример формирования в процессе "Отправка уведомлений задачи пользователя" (UserTaskNotificationDelegateProcess)
execution.setVariable('messageProperties', [commentText: 'Сюда добавим комментарий'])</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ais0xa</bpmn:incoming>
      <bpmn:outgoing>Flow_BackFromGlobalRevision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="EndEvent_1">
      <bpmn:incoming>Flow_15tfl2i</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToAnchor" sourceRef="StartEvent_1" targetRef="setDocumentAttributes" />
    <bpmn:sequenceFlow id="Flow_End" sourceRef="DynamicStepsSubprocess" targetRef="Activity_15o3czr" />
