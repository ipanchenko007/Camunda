      <bpmndi:BPMNShape id="Task_Parallel_di" bpmnElement="Task_Parallel">
        <dc:Bounds x="1060" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="1215" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CheckResult_di" bpmnElement="Gateway_CheckResult" isMarkerVisible="true">
        <dc:Bounds x="1325" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1307" y="191" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubEnd_di" bpmnElement="SubEnd">
        <dc:Bounds x="1512" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1500" y="265" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ThrowReject_di" bpmnElement="Event_ThrowReject">
        <dc:Bounds x="1512" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1492" y="175" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ThrowRevision_di" bpmnElement="Event_ThrowRevision">
        <dc:Bounds x="1512" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1503" y="345" width="55" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1nzh67a_di" bpmnElement="prepareCurrentStage" isExpanded="false">
