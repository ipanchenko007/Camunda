      <bpmn:incoming>Flow_BackFromGlobalRevision</bpmn:incoming>
      <bpmn:outgoing>Flow_0wu0h3o</bpmn:outgoing>
      <bpmn:outgoing>Flow_05zaga1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0wu0h3o" sourceRef="Gateway_0yofwp4" targetRef="setDocumentAttributes" />
    <bpmn:intermediateThrowEvent id="Event_001d5wo" name="Отклонить">
      <bpmn:incoming>Flow_05zaga1</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_199wjvv" name="linkDecline" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_05zaga1" sourceRef="Gateway_0yofwp4" targetRef="Event_001d5wo">
      <bpmn:conditionExpression xsi_1:type="bpmn:tFormalExpression">${taskOutcome == 'TAB0600_DECLINE'}</bpmn:conditionExpression>
