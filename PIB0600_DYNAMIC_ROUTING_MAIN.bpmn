      </bpmn:serviceTask>
      <bpmn:startEvent id="Event_14d61rq" isInterrupting="false">
        <bpmn:outgoing>Flow_0mkcmy6</bpmn:outgoing>
        <bpmn:escalationEventDefinition id="EscalationEventDefinition_16h7scj" escalationRef="Escalation_25pft9f" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_0mkcmy6" sourceRef="Event_14d61rq" targetRef="Activity_11xhg60" />
      <bpmn:sequenceFlow id="Flow_0zv2mkg" sourceRef="Activity_11xhg60" targetRef="Activity_0afnqx2" />
