    <bpmn:serviceTask id="setDocumentAttributes" name="Запрос атрибутов документа" camunda:delegateExpression="#{restClient}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
          <camunda:inputParameter name="path">/private/documents/{guid}</camunda:inputParameter>
          <camunda:inputParameter name="pathParams">
            <camunda:map>
              <camunda:entry key="guid">${entityGuid}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="resultVarName">baseDocument</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">//Инициализируем логгер динамическим именем (включая код процесса)
def log = org.slf4j.LoggerFactory.getLogger("${processCode}_setDocumentAttributes")

//Получаем ID инстанса процесса
def processInstanceId = execution.getProcessInstanceId()

//Парсим JSON и сохраняем его в переменную процесса Camunda
def metadata = S(baseDocument).prop('data')
execution.setVariable('entityMetadata', metadata)

//Логируем результат (при необходимости)
//log.info("PROCESS [{}] Check entityMetadata: {}", processInstanceId, metadata)</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAnchor</bpmn:incoming>
