      <bpmn:serviceTask id="Activity_0afnqx2" name="Запрос атрибутов документа" camunda:delegateExpression="#{restClient}">
        <bpmn:documentation>Обновление entityMetadata после изменения статуса. Лишняя операция, надо придумать что-то лучше!</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
            <camunda:inputParameter name="path">/private/documents/{guid}</camunda:inputParameter>
            <camunda:inputParameter name="pathParams">
              <camunda:map>
                <camunda:entry key="guid">${entityGuid}</camunda:entry>
              </camunda:map>
