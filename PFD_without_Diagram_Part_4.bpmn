    <bpmn:userTask id="Activity_157ho4k" name="Согласовать документ" camunda:asyncBefore="true" camunda:assignee="${approver}">
      <bpmn:documentation>${S(document).prop("data").prop("title").stringValue()}</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="actions">${userActions}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">if ("TA015_REWORK".equals(execution.getVariable("taskOutcome"))) {
    execution.getParent().setVariable("needRework", true)
}

if ("TA051_REJECT_REQUEST_PFD".equals(execution.getVariable("taskOutcome"))) {
    execution.getParent().setVariable("needReject", true)
}
</camunda:script>
        </camunda:executionListener>
        <camunda:taskListener delegateExpression="#{userTaskNotificationListener}" event="create">
          <camunda:field name="messageCode">
            <camunda:string>PACKAGE_USER_TASK_CREATED</camunda:string>
