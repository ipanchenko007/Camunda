        <bpmn:script>def statusRaw = execution.getVariable("RPA_VAT_PROCESSING_STATUS")
def comment   = execution.getVariable("RPA_VAT_PROCESSING_COMMENT")

def statusStr = statusRaw == null ? null : statusRaw.toString().toUpperCase()

String normalizedStatus

switch (statusStr) {
