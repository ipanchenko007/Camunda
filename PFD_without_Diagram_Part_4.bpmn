    <bpmn:scriptTask id="Activity_1i0av5l" name="Формирование json для отправки в комментарий " scriptFormat="groovy">
      <bpmn:incoming>Flow_03jhfob</bpmn:incoming>
      <bpmn:outgoing>Flow_1gpk9d4</bpmn:outgoing>
      <bpmn:script>import static org.camunda.spin.Spin.JSON
import groovy.json.JsonOutput

def title = S(document).prop("data").prop("title").stringValue();
def dDocs = [];

def commentBody = [:];  // будет JSON-объектом для POST

if (findDuplicate) {
    def bUrl = baseUrl;
    // Удаляем /api или /api/ в конце URL
    baseUrl = bUrl.replaceAll('/api/?$', '')

    def blocks = duplicateComment.collect { 
        guid, urls -&gt;
            def links = urls.collect { url -&gt; "- ${url}" }.join("\n")
            return "${baseUrl}/document-and-storage/list/user/${guid}/view?tab=base-info — документ:\n${links}"
    }

    def text = "Необходимо устранить дублирующие документы:\n" + blocks.join("\n");

    // Обрезка data до безопасного размера
    // Базовая часть JSON (без содержимого data) ~ 200-300 символов.
    // Лимит varchar 4000. Кириллица в JSON экранируется как \uXXXX (6 символов на букву).
    // Берём консервативный лимит "сырых" символов data, чтобы при worst-case 6x
    // итоговый JSON гарантированно был &lt;= 3999.
    def maxRawChars = 600   // 600 * 6 = 3600 + базовый JSON (~300) = 3900 &lt; 4000
    if (text.length() &gt; maxRawChars) {
        text = text.substring(0, maxRawChars)
    }

    commentBody = [
        data: text,
        parentId: null,
        taggedUsers: []
    ]

    dDocs = duplicateComment.collect { guid, urls -&gt;
        [guid: guid]
    }
}

execution.setVariable('messagePropertiesUI', [
                        messageTitle: title,
                        packageId: entityGuid,
                        duplicateComment: commentBody.data ?: ""
                      ]);
execution.setVariable('duplicateDocuments', dDocs);
execution.setVariable('urlContract', '');

// Отправка комментария
if (findDuplicate) {
    execution.setVariable('commentPayload', JsonOutput.toJson(commentBody));
}</bpmn:script>
    </bpmn:scriptTask>
