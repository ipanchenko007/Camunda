        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">pfd-service</camunda:inputParameter>
            <camunda:inputParameter name="path">private/integration/send-to-energybilling</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="body">{
  "guid": "${entityGuid}"
}</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">ebSendResponse</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
