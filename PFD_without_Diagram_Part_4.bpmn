      <bpmn:scriptTask id="Activity_0ah5zrn" name="Анализ состава пакета" scriptFormat="groovy">
        <bpmn:incoming>Flow_0eug1j6</bpmn:incoming>
        <bpmn:outgoing>Flow_0nhcdjc</bpmn:outgoing>
        <bpmn:script>import java.util.logging.Logger
import groovy.json.JsonSlurper
Logger logger = Logger.getLogger("PFD_REVOCATION_LOG")

// 1. Проверить признак закрытого пакета (AB374_PACKET_IS_LOCKED)
def pkgDoc = execution.getVariable("packageDocument")
def isLocked = false
try {
    def attrs = pkgDoc.prop("data").prop("attributes")
    if (attrs.hasProp("AB374_PACKET_IS_LOCKED")) {
        def lockVal = attrs.prop("AB374_PACKET_IS_LOCKED")
        if (lockVal.isBoolean()) {
            isLocked = lockVal.boolValue()
        } else {
            isLocked = "true".equalsIgnoreCase(lockVal.stringValue())
        }
    }
} catch (Exception e) {
    logger.warning("Cannot read AB374_PACKET_IS_LOCKED: " + e.getMessage())
}
execution.setVariable("isPackageLocked", isLocked)

// 2. Посчитать документы в пакете (PACKAGE relations)
def json = new JsonSlurper().parseText(packageRelations.toString())
def packageDocs = json.data.findAll { it.relationCode == "PACKAGE" }
def docCount = packageDocs.size()
execution.setVariable("packageDocCount", docCount)

// 3. Определить ветку
execution.setVariable("cancelPackage", false)
execution.setVariable("terminateProcess", false)

if (docCount == 1) {
    execution.setVariable("cancelPackage", true)
    execution.setVariable("terminateProcess", true)
} else if (isLocked) {
    execution.setVariable("cancelPackage", true)
    execution.setVariable("terminateProcess", true)
}

logger.info("Package analysis: docCount=" + docCount + " isLocked=" + isLocked + " cancelPackage=" + execution.getVariable("cancelPackage") + " terminateProcess=" + execution.getVariable("terminateProcess"))</bpmn:script>
      </bpmn:scriptTask>
