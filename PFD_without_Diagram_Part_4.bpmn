    <bpmn:scriptTask id="Activity_15c9zdz" name="Обработка таймаутов роботов" scriptFormat="groovy">
      <bpmn:incoming>Flow_1xps4li</bpmn:incoming>
      <bpmn:outgoing>Flow_1qcfje0</bpmn:outgoing>
      <bpmn:script>// Если задачу уже исполнил пользователь — таймаут не актуален
if (execution.getVariable("USER_COMPLETED_BEFORE_RPA") == true) {
    println "===============LOG=================="
    println "### TIMEOUT skipped: USER_COMPLETED_BEFORE_RPA=true"
    println "===================================="
    return
}

def rpaNames = ["RPA_SF", "RPA_VAT", "RPA_SN_AN"]

rpaNames.each { name -&gt;
    def statusVar  = "${name}_STATUS"
    def commentVar = "${name}_COMMENT"

    if (!execution.hasVariable(statusVar) || execution.getVariable(statusVar) == null) {
        execution.setVariable(statusVar,  "TIMEOUT")
        execution.setVariable(commentVar, "Ответ от ${name} не получен (таймаут или ошибка отправки)")

        println "===============LOG=================="
        println "### TIMEOUT: ${name} не ответил в течение 3 дней"
        println "===================================="
    }
}
</bpmn:script>
    </bpmn:scriptTask>
