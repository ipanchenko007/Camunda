def actions = "TA015_REWORK,TA39_CORRECT_ZP,TA37_SEND_FOR_PAYMENT,TA045_NEED_INFORMATION,TA050_CHANGE_DETAILS_PFD,TA049_MARK_DOUBLE,TA40_DELETE,TA070_POSTPONE";

if (!isEDO){
    actions = actions +",TA38_SEND_TO_RESCAN";
}


execution.setVariable('userActions', actions);	
//---
execution.setVariable('messageProperties', [messageTitle: title, packageId: entityGuid, lastTaskComment: lastComment, diadocComment: '', alert: '']);

execution.setVariable('prevState','DS016_VERIFICATION');

execution.setVariable('prevRole','RL026_VERIFIER_PFD');</bpmn:script>
