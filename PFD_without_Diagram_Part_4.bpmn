        <bpmn:incoming>Flow_0pgvdhq</bpmn:incoming>
        <bpmn:outgoing>Flow_1fw2hyd</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_0vfvcyh" messageRef="Message_197ih26" />
      </bpmn:intermediateCatchEvent>
      <bpmn:scriptTask id="Activity_0hjnges" name="Обработка результатов отправки" scriptFormat="groovy">
        <bpmn:incoming>Flow_0veryvh</bpmn:incoming>
        <bpmn:outgoing>Flow_1s8sow8</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonSlurper

def rawResp = execution.getVariable("sebResponsePayload")
def rawReq = execution.getVariable("sebRequestPayload")

if (rawResp != null &amp;&amp; !rawResp instanceof String) {
    rawResp = rawResp.toString()
}
if (rawReq != null &amp;&amp; !rawReq instanceof String) {
    rawReq = rawReq.toString()
}

def respBody = rawResp ? new JsonSlurper().parseText(rawResp.toString()) : null
def reqBody = rawReq ? new JsonSlurper().parseText(rawReq.toString()) : null

println "### EB_DEBUG: sebResponsePayload=${rawResp} sebRequestPayload=${rawReq}"

def resultStatus = respBody?.resultStatus != null ? respBody.resultStatus.toString() : ""
def ebResult = respBody?.ebResult != null ? respBody.ebResult.toString() : ""
def deltaRubPercent = respBody?.deltaRubPercent != null ? respBody.deltaRubPercent.toString() : ""
def deltaKwHrPercent = respBody?.deltaKwHrPercent != null ? respBody.deltaKwHrPercent.toString() : ""
def tariff = respBody?.tariff != null ? respBody.tariff.toString() : ""
def deviceTotal = respBody?.device_total != null ? respBody.device_total.toString() : ""
def deviceCalc = respBody?.device_calc != null ? respBody.device_calc.toString() : ""

def totalSumWithoutNds = reqBody?.totalSumWithoutNds != null ? reqBody.totalSumWithoutNds.toString() : ""
def totalVolume = reqBody?.totalVolume != null ? reqBody.totalVolume.toString() : ""

execution.setVariable("resultStatus", resultStatus)
execution.setVariable("ebResult", ebResult)
execution.setVariable("totalSumWithoutNds", totalSumWithoutNds)
execution.setVariable("totalVolume", totalVolume)
execution.setVariable("deltaRubPercent", deltaRubPercent)
execution.setVariable("deltaKwHrPercent", deltaKwHrPercent)
execution.setVariable("tariff", tariff)
execution.setVariable("device_total", deviceTotal)
execution.setVariable("device_calc", deviceCalc)

def comment
if (execution.hasVariable("ebRetryCount") &amp;&amp; execution.getVariable("ebRetryCount") as int &gt;= 3 &amp;&amp; execution.getVariable("ebSendSuccess") == false) {
    comment = "Не удалось отправить сообщение в систему энергобиллинга (попыток: " + execution.getVariable("ebRetryCount") + ")"
} else if (rawResp == null || rawResp.toString().trim().isEmpty()) {
    comment = "Не получено сообщение от системы энергобиллинга"
} else if (resultStatus == "SUCCESS" &amp;&amp; ebResult.toString() == "true") {
    comment = "Статус: отклонение в норме. " +
        "Сумма ЭБ: " + totalSumWithoutNds + " руб. (откл. " + deltaRubPercent + "), " +
        "объём ЭБ: " + totalVolume + " кв·ч (откл. " + deltaKwHrPercent + "), " +
        "тариф ЭБ " + tariff + " руб/кВтч, " +
        "ПУ в договоре: всего " + deviceTotal + " шт., рассчитано по " + deviceCalc + " шт."
} else if (resultStatus == "SUCCESS" &amp;&amp; ebResult.toString() == "false") {
    comment = "Статус: отклонение не в норме. " +
        "Сумма ЭБ: " + totalSumWithoutNds + " руб. (откл. " + deltaRubPercent + "), " +
        "объём ЭБ: " + totalVolume + " кв·ч (откл. " + deltaKwHrPercent + "), " +
        "тариф ЭБ " + tariff + " руб/кВтч, " +
        "ПУ в договоре: всего " + deviceTotal + " шт., рассчитано по " + deviceCalc + " шт."
} else if (resultStatus == "FAILED") {
    comment = "Статус: ошибка. В энергобиллинге не определена стоимость."
} else if (resultStatus == "TECH_ERROR") {
    comment = "Статус: ошибка. Техническая ошибка."
} else if (resultStatus == "NO_DATA") {
    comment = "Статус: ошибка. Недостаточно данных для расчета."
} else {
    comment = "Статус: " + resultStatus + ". Ответ системы энергобиллинга: ebResult=" + ebResult
}

execution.setVariable("ebComment", comment)

println "============LOG==================="
println "### SEB_RESPONSE_PROCESS: resultStatus=${resultStatus} ebResult=${ebResult} totalSumWithoutNds=${totalSumWithoutNds} totalVolume=${totalVolume} tariff=${tariff} deltaRubPercent=${deltaRubPercent} deltaKwHrPercent=${deltaKwHrPercent} deviceTotal=${deviceTotal} deviceCalc=${deviceCalc}"
println "=================================="</bpmn:script>
      </bpmn:scriptTask>
