      <bpmn:script>def title= S(document).prop("data").prop("title").stringValue();
def lastComment="";
if(execution.hasVariable("lastTaskComment")){
   lastComment = lastTaskComment;
}
//блок определения кнопок для этапа Согласовать документ
def actions = "TA007_APPROVE,TA015_REWORK,TA070_POSTPONE";
if(!allInExceptions)
    actions = actions +",TA051_REJECT_REQUEST_PFD";

execution.setVariable('userActions', actions);		
