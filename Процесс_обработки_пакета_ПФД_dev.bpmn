        <bpmn:script>import groovy.json.JsonSlurper

def raw = execution.getVariable("ebSendResponse")

def body = raw ? new JsonSlurper().parseText(raw.toString()) : null

// Обрабатываем ответ вызова EB от ПФД-сервиса  
def success = body?.success == true
def errorText = body?.error ?: ""

// guid документа
def guid = S(document).prop("data").prop("guid").stringValue()

// Устанавливаем переменную результат отправки в EB
execution.setVariable("ebSendSuccess", success)

// Статус отправки в EB для логирования
execution.setVariable("EB_SEND_STATUS", success ? "ACCEPTED" : "NOT_ACCEPTED")

// Счётчик попыток отправки в EB
def retryCount = execution.hasVariable("ebRetryCount") ? execution.getVariable("ebRetryCount") as int : 0
if (!success) {
    retryCount = retryCount + 1
    execution.setVariable("ebRetryCount", retryCount)
}
println "### EB_DEBUG: ebRetryCount=${retryCount}"

// Переменная с текстом ошибки для формирования комментария
// Если success == false, здесь будет текст из поля "error"
execution.setVariable("ebComment", errorText)

if (success) {
    println "============LOG==================="
    println "### EB_SEND STATUS=ACCEPTED guid=${guid} response=${raw}"
    println "=================================="
} else {
    println "============LOG==================="
    println "### EB_SEND STATUS=NOT_ACCEPTED guid=${guid} response=${raw}"
    println "=================================="
}

println "### EB_DEBUG: entered Activity_1svurjt, ebSendResponse=${raw}"</bpmn:script>
      </bpmn:scriptTask>
