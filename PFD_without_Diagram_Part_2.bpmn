    <bpmn:scriptTask id="Activity_0htl5iv" name="Формирование json для обновления филиала" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_15wde1o</bpmn:incoming>
      <bpmn:outgoing>Flow_080xsq6</bpmn:outgoing>
      <bpmn:script>import static org.camunda.spin.Spin.JSON

def json = execution.getVariable("basedocument")

if (json != null) {
    //добавила проверку на наличие филиала? чтобы не падали тесты
	if(json.prop("data").prop("attributes").hasProp("AB370_FILIAL_DIVIZION")){
		def divisions = json
				.prop("data")
				.prop("attributes")
				.prop("AB370_FILIAL_DIVIZION")

		if (divisions.isArray()) {

			int count = divisions.elements().size()
			execution.setVariable("divisionCount", count)

			if (count == 1) {

				def singleDivision = divisions.elements().get(0)

				def wrapped = JSON("{}")
				wrapped.prop("AB358_FILIAL_ID", singleDivision)

				execution.setVariable("singleFilialDivision", wrapped.toString())
			}
		}
	}
}</bpmn:script>
    </bpmn:scriptTask>
