      <bpmn:serviceTask id="Activity_0zbtkv1" name="Запрос данных по связанному документу в пакете" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
            <camunda:inputParameter name="path">private/documents/{guid}/relations</camunda:inputParameter>
            <camunda:inputParameter name="pathParams">
              <camunda:map>
                <camunda:entry key="guid">${S(document).prop("guid").stringValue()}</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">packDocument</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1cb3ggd</bpmn:incoming>
        <bpmn:outgoing>Flow_1k9ujkm</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:startEvent id="Event_0mc097t">
        <bpmn:outgoing>Flow_1cb3ggd</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_0pefmpf">
        <bpmn:incoming>Flow_0lt7us8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:scriptTask id="Activity_1vzxhkd" name="Проверка связи с документом основанием" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_1k9ujkm</bpmn:incoming>
        <bpmn:outgoing>Flow_0lt7us8</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonSlurper
import static org.camunda.spin.Spin.JSON

def json = new JsonSlurper().parseText(packDocument.toString())

def newGuid = json.data
        ?.find { it.relationCode == "BASE_DOCUMENT" }
        ?.targetGuid

if (newGuid) {

    def existingVar = execution.getVariable("baseDoc")

    List&lt;String&gt; guidList = []

    if (existingVar != null) {

        def existingJson = existingVar instanceof String
                ? JSON(existingVar)
                : existingVar

        if (existingJson.isArray()) {
            guidList = existingJson.elements()
                    .findAll { it.hasProp("guid") }
                    .collect { it.prop("guid").stringValue() }
        }
    }

    if (!guidList.contains(newGuid)) {

        guidList.add(newGuid)

        def resultArray = guidList.collect { [ guid: it ] }

        execution.setVariable("baseDoc", JSON(resultArray))
        execution.setVariable("baseDocCount", guidList.size())
    }
}</bpmn:script>
      </bpmn:scriptTask>
