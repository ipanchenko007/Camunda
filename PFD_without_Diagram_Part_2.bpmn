              <camunda:entry key="guid">${entityGuid}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="body">${diadokdocuments.toString()}</camunda:inputParameter>
          <camunda:inputParameter name="resultVarName">diadocRes</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
