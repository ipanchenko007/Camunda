    <bpmn:scriptTask id="Activity_1ku7ju0" name="Определяем требуется ли отправка в EDF" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_01il0w0</bpmn:incoming>
      <bpmn:outgoing>Flow_0o2fttf</bpmn:outgoing>
      <bpmn:script>// Признак ЭДО из этапа "Определить признак ЭДО"
boolean isEDO = (execution.getVariable("isEDO") as Boolean) ?: false

// Признак наличия хотя бы одного документа с AB416_KND != null
boolean hasKnd = (execution.getVariable("KND") as Boolean) ?: false

// Условие отправки в EDF: ЭДО + есть хотя бы один документ с KND
boolean sendEDF = (isEDO &amp;&amp; hasKnd)

// Сохраняем флаг в процесс
execution.setVariable("sendEDF", sendEDF)
</bpmn:script>
    </bpmn:scriptTask>
