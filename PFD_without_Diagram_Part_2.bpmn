    <bpmn:scriptTask id="Activity_0ijh5r3" name="Определяем маршрут и комментарий" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_1xqeki1</bpmn:incoming>
      <bpmn:outgoing>Flow_1acyui9</bpmn:outgoing>
      <bpmn:script>// --- Читаем накопленные флаги ---
def isTimeout          = execution.getVariable("isTimeout30d") ?: false
def unsuccessful       = execution.getVariable("hasUnsuccessful") ?: false
def reqReapproval      = execution.getVariable("hasReqReapproval") ?: false
def notReady           = execution.getVariable("hasNotReady") ?: false
def rejected           = execution.getVariable("hasRejected") ?: false
def finallyClosed      = execution.getVariable("hasFinallyClosed") ?: false
def correctionDoc      = execution.getVariable("correctionDoc") ?: false
def hasNullNfsAmounts  = execution.getVariable("hasNullNfsAmounts") ?: false
def zpForFix           = execution.getVariable("zpForFix")

def fixZP = !correctionDoc &amp;&amp; (zpForFix instanceof Collection) &amp;&amp; !zpForFix.isEmpty()

// -------------------------------------------------------
// Блок 1: МАРШРУТИЗАЦИЯ — статусный приоритет сохраняется
// -------------------------------------------------------
boolean purchase = false
boolean verification = false
String statusComment = null

if (isTimeout) {
    purchase = true
    statusComment = "СЗП в статусе ожидания утверждения больше 30 дней"

} else if (unsuccessful) {
    purchase = true
    statusComment = "Статус СЗП не получен. Проверьте номер СЗП."

} else if (reqReapproval) {
    purchase = true
    statusComment = "Документ в статусе На переутверждении"

} else if (rejected) {
    verification = true
    statusComment = "Документ в статусе Отклонено"

} else if (finallyClosed) {
    verification = true
    statusComment = "Документ в статусе Окончательно закрыто"

} else if (notReady) {
    purchase = true
    statusComment = "Требуется проверка ЗП"

} else if (fixZP || hasNullNfsAmounts) {
    purchase = true
}

// -------------------------------------------------------
// Блок 2: КОММЕНТАРИЙ — агрегат причин
// -------------------------------------------------------
def commentParts = []

if (statusComment) {
    commentParts.add(statusComment)
}

if (hasNullNfsAmounts) {
    commentParts.add("Не получена информация о сумме ЗП из НФС")
}

if (fixZP) {
    commentParts.add("Требуется корректировка суммы по СЗП № ${zpForFix.join(', ')}")
}

String commentText = commentParts ? commentParts.join(" || ") : null

// -------------------------------------------------------
// Сохраняем результаты
// -------------------------------------------------------
execution.setVariable("purchase", purchase)
execution.setVariable("verification", verification)
execution.setVariable("commentText", commentText)
execution.setVariable("fixZP", fixZP)

println "=== [Определяем маршрут] ==="
println "isTimeout30d      = ${isTimeout}"
println "correctionDoc     = ${correctionDoc}"
println "unsuccessful      = ${unsuccessful}"
println "reqReapproval     = ${reqReapproval}"
println "rejected          = ${rejected}"
println "finallyClosed     = ${finallyClosed}"
println "notReady          = ${notReady}"
println "hasNullNfsAmounts = ${hasNullNfsAmounts}"
println "fixZP             = ${fixZP}"
println "zpForFix          = ${zpForFix}"
println "→ purchase        = ${purchase}"
println "→ verification    = ${verification}"
println "→ commentText     = ${commentText}"
println "============================="</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_0mtryej">
      <bpmn:incoming>Flow_1hxf7es</bpmn:incoming>
