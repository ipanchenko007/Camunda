    <bpmn:scriptTask id="Activity_1ywkgrf" name="Проверка наличия филиала в пакете" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_01osxrl</bpmn:incoming>
      <bpmn:outgoing>Flow_0tb3dba</bpmn:outgoing>
      <bpmn:script>import static org.camunda.spin.Spin.JSON

def jsonString = execution.getVariable("document")

boolean findFilial = false

if (jsonString) {
    def json = JSON(jsonString)

    if (json.hasProp("data") &amp;&amp;
        json.prop("data").hasProp("attributes") &amp;&amp;
        json.prop("data").prop("attributes").hasProp("AB358_FILIAL_ID") &amp;&amp;
        !json.prop("data").prop("attributes").prop("AB358_FILIAL_ID").isNull()) {

        findFilial = true
    }
}

execution.setVariable("findFilial", findFilial)</bpmn:script>
    </bpmn:scriptTask>
