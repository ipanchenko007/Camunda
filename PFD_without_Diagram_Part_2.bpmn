    <bpmn:scriptTask id="Activity_0020vui" name="Проверим, менялся ли состав пакета" scriptFormat="groovy">
      <bpmn:incoming>Flow_032le80</bpmn:incoming>
      <bpmn:outgoing>Flow_07knqik</bpmn:outgoing>
      <bpmn:script>boolean areDocumentsDifferent(preDocuments, documents) {
    if (preDocuments.size() != documents.size()) {
        return true
    }

    // Собираем Set guid из documents
    Set&lt;String&gt; docGuids = documents
            .collect { it.guid }
            .toSet()

    // Проверяем каждый guid из preDocuments
    for (def item in preDocuments) {
        if (!docGuids.contains(item.guid)) {
            return true
        }
    }
    return false
}

execution.setVariable(
        "isChanged",
        areDocumentsDifferent(preDocuments, documents)
)</bpmn:script>
    </bpmn:scriptTask>
