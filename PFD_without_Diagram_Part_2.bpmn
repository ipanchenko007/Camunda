    <bpmn:subProcess id="Activity_12zx688" name="Запрос и проверка ЦБО и подписанта">
      <bpmn:incoming>Flow_0wzbrfr</bpmn:incoming>
      <bpmn:outgoing>Flow_0qa5iwv</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${S(baseDocumentsStr).elements()}" camunda:elementVariable="baseDocument" />
      <bpmn:endEvent id="Event_0u8769e">
        <bpmn:incoming>Flow_17aq2jr</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:startEvent id="Event_1qh31kb">
        <bpmn:outgoing>Flow_0k0qwdm</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_1j221jz" name="Запрос атрибутов документа" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
            <camunda:inputParameter name="path">private/documents/{guid}</camunda:inputParameter>
            <camunda:inputParameter name="pathParams">
              <camunda:map>
                <camunda:entry key="guid">${S(baseDocument).prop("guid").stringValue()}</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">contract</camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:failedJobRetryTimeCycle />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0k0qwdm</bpmn:incoming>
        <bpmn:outgoing>Flow_0vlz28u</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="Activity_0t0mhka" name="Проверка ЦБО и подписанта" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_0vlz28u</bpmn:incoming>
        <bpmn:outgoing>Flow_17aq2jr</bpmn:outgoing>
        <bpmn:script>import java.util.logging.Logger

Logger log = Logger.getLogger("PFD_CBO_CHECK")

// 1. Идентификатор текущего документа-основания
def baseDocGuid = S(baseDocument.toString()).prop("guid").stringValue()
log.info("[CBO_CHECK] guid=$baseDocGuid | pid=${execution.processInstanceId}")

// 2. Извлекаем атрибуты из ответа API 
def attributes = contract.prop("data").prop("attributes")

// 3. Проверяем наличие обоих атрибутов:AB294_CBO и AB402_PFD_RESPONSIBLE_PERSON
if (!attributes.hasProp("AB294_CBO") || !attributes.hasProp("AB402_PFD_RESPONSIBLE_PERSON")) {
    log.info("[CBO_CHECK] Нет AB294_CBO или AB402 | guid=$baseDocGuid — пропускаем")
    return
}

def cboAttr  = attributes.prop("AB294_CBO")
def respAttr = attributes.prop("AB402_PFD_RESPONSIBLE_PERSON")

// 4. Проверяем, что оба атрибута не null 
if (cboAttr.isNull() || respAttr.isNull()) {
    log.info("[CBO_CHECK] AB294_CBO или AB402 = null | guid=$baseDocGuid — пропускаем")
    return
}

// 5. Читаем код ЦБО с защитой от отсутствия вложенного свойства 
if (!cboAttr.hasProp("CBO_CODE") || cboAttr.prop("CBO_CODE").isNull()) {
    log.info("[CBO_CHECK] CBO_CODE отсутствует или null | guid=$baseDocGuid — пропускаем")
    return
}
def cboCode = cboAttr.prop("CBO_CODE").stringValue()
log.info("[CBO_CHECK] CBO_CODE=$cboCode | guid=$baseDocGuid")

// 6. Читаем логины: AB402 может быть объектом или коллекцией
def logins = []

if (respAttr.isArray()) {
    respAttr.elements().each { item -&gt;
        if (item.hasProp("login") &amp;&amp; !item.prop("login").isNull()) {
            def login = item.prop("login").stringValue()
            if (login) logins &lt;&lt; login
        }
    }
    log.info("[CBO_CHECK] AB402=коллекция logins=$logins | guid=$baseDocGuid")
} else {
    if (respAttr.hasProp("login") &amp;&amp; !respAttr.prop("login").isNull()) {
        def login = respAttr.prop("login").stringValue()
        if (login) logins &lt;&lt; login
    }
    log.info("[CBO_CHECK] AB402=объект logins=$logins | guid=$baseDocGuid")
}

// 7. Накапливаем данные по итерациям
def allCboNames        = (execution.getVariable('allCboNames')        ?: []) as List
def allInitiatorLogins = (execution.getVariable('allInitiatorLogins') ?: []) as List

allCboNames &lt;&lt; cboCode
allInitiatorLogins.addAll(logins)

execution.setVariable('allCboNames',        allCboNames)
execution.setVariable('allInitiatorLogins', allInitiatorLogins)

println "==============LOG=================="
log.info("[CBO_CHECK] Итого ЦБО=$allCboNames логинов=$allInitiatorLogins | pid=${execution.processInstanceId}")
println "===================================="</bpmn:script>
      </bpmn:scriptTask>
