        <bpmn:serviceTask id="Activity_1vgnv7v" name="Получение статусов ЗП из НФС" camunda:delegateExpression="${delegateCheckStatus}">
          <bpmn:documentation>BEEDOCS-4180</bpmn:documentation>
          <bpmn:extensionElements>
            <camunda:inputOutput>
              <camunda:inputParameter name="NumberPO">${NumberPO}</camunda:inputParameter>
            </camunda:inputOutput>
          </bpmn:extensionElements>
