    <bpmn:scriptTask id="Activity_1t8ejd6" name="Проверка возможности подписания" scriptFormat="groovy">
      <bpmn:incoming>Flow_0l4c04p</bpmn:incoming>
      <bpmn:outgoing>Flow_0w93amp</bpmn:outgoing>
      <bpmn:script>import java.util.logging.Logger
Logger logger = Logger.getLogger("PFD_SIGNING")

// BEEDOCS-4947: определим, нужен ли этап подписания
Set&lt;String&gt; exceptionTypes = Set.of(
    "TP_INVOICE",
    "TP_INVOICE_REVISION",
    "TP_INVOICE_CORRECTION",
    "TP_PROFORMAINVOICE",
    "TP_SERVICE_DETAILS"
)

def docsWithType = execution.getVariable("docsWithType")

boolean allInExceptions = false
if (docsWithType != null) {
    allInExceptions = docsWithType.stream()
        .allMatch { d -&gt; exceptionTypes.contains(d.docType) }
}

execution.setVariable("allInExceptions", allInExceptions)

logger.info("[SIGNING_CHECK] allInExceptions=" + allInExceptions +
    " | processId: " + execution.getProcessInstanceId())</bpmn:script>
    </bpmn:scriptTask>
