      <bpmn:outgoing>Flow_1xqeki1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Activity_14z9hew" name="Формирование переменных" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:documentation>Извлекаем №ЗП и проверяем наличие корректировочных документов в пакете</bpmn:documentation>
      <bpmn:incoming>Flow_1izzviz</bpmn:incoming>
      <bpmn:outgoing>Flow_0ecpdve</bpmn:outgoing>
      <bpmn:script>// Получаем массив ZP из документа
def zpElements = S(document)
    .prop("data")
    .prop("attributes")
    .prop("ZP")
    .elements()

// Преобразуем в список мап
def zpList = []

zpElements.each { el -&gt;
    def map = [:]
    
    // Получаем значение поля AB296_PURCHASE_ORDER_NUMBER
    def fieldValue = el.prop("AB296_PURCHASE_ORDER_NUMBER")
    
    // Пробуем обработать как строку, если не получается - как число
    try {
        map.AB296_PURCHASE_ORDER_NUMBER = fieldValue.stringValue()
    } catch (Exception e) {
        // Если не удалось получить как строку, пробуем как число
        try {
            map.AB296_PURCHASE_ORDER_NUMBER = fieldValue.numberValue().toString()
        } catch (Exception ex) {
            // Если оба способа не сработали, устанавливаем null или пустую строку
            map.AB296_PURCHASE_ORDER_NUMBER = null
        }
    }
    
    zpList.add(map)
}

// Сохраняем список ЗП в переменную процесса
execution.setVariable("zpList", zpList)
execution.setVariable("hasUnsuccessful", false)
execution.setVariable("hasRejected", false)
execution.setVariable("hasFinallyClosed", false)
execution.setVariable("hasNotReady", false)
execution.setVariable("hasDifferentStatus", false)
execution.setVariable("hasReqReapproval", false)

println "=====Определение корректировочных доков====="
// 1. Получаем ответ сервиса как строку
def raw = execution.getVariable('documents')
boolean correctionDoc = false

if (raw != null) {
    String text = raw.toString()

    // 2. Проверка по подстрокам
    if (text.contains('"targetType":"TP_INVOICE_CORRECTION"') ||
        text.contains('"targetType":"TP_UNIVERSAL_TRANSFER_DOCUMENT_CORRECTION"') ||
        text.contains('targetType TPINVOICECORRECTION') ||
        text.contains('targetType TPUNIVERSALTRANSFERDOCUMENTCORRECTION')) {
        correctionDoc = true
    }
}

// 3. Сохраняем флаг в переменную процесса
execution.setVariable('correctionDoc', correctionDoc)

execution.setVariable("zpForFix", [])

// Лог для отладки
println "[CheckCorrectionDoc] correctionDoc = ${correctionDoc}"
println "[CheckCorrectionDoc] documents = ${raw}"
println "===================================="</bpmn:script>
    </bpmn:scriptTask>
