      <bpmn:scriptTask id="Activity_1ki1jol" name="Получение логина подписанта" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_12uwlbn</bpmn:incoming>
        <bpmn:outgoing>Flow_0mm8keh</bpmn:outgoing>
        <bpmn:script>import static org.camunda.spin.Spin.JSON
def json = JSON(signatoryData)

json = json.prop("data");

def fullName = json.elements().get(0).prop("fullName").stringValue();
def personId = json.elements().get(0).prop("personId").stringValue();
def employeeId = json.elements().get(0).prop("personId").stringValue()

execution.setVariable('fullName', fullName);
execution.setVariable('personId', personId);
execution.setVariable('employeeId', employeeId);

</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_1m8vp8v" name="Формрование тела запроса" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_0mm8keh</bpmn:incoming>
        <bpmn:outgoing>Flow_1wz8hco</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonOutput

def jsonMap = [
    name: fullName,
    personId: personId,
    internalEmployeeId: employeeId
]


def wrappedJson = [
    AB423_SIGNATORY_EDO: jsonMap
]

def jsonString = JsonOutput.toJson(wrappedJson)

// записываем в переменную процесса
execution.setVariable("requestBody", jsonString)
</bpmn:script>
