        <bpmn:outgoing>Flow_0u88fog</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${S(baseDocumentsStr).elements()}" camunda:elementVariable="baseDocument" />
        <bpmn:startEvent id="Event_1crrmfd">
          <bpmn:outgoing>Flow_0hbymwo</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="Activity_0a6sc62" name="Удаление связи документов пакета с документом-основанием" camunda:delegateExpression="#{restClient}">
          <bpmn:extensionElements>
            <camunda:inputOutput>
              <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
              <camunda:inputParameter name="path">private/documents/{guid}/relations/{targetGuid}</camunda:inputParameter>
              <camunda:inputParameter name="pathParams">
                <camunda:map>
                  <camunda:entry key="guid">${S(document).prop("guid").stringValue()}</camunda:entry>
                  <camunda:entry key="targetGuid">${S(baseDocument).prop("guid").stringValue()}</camunda:entry>
                </camunda:map>
              </camunda:inputParameter>
              <camunda:inputParameter name="method">DELETE</camunda:inputParameter>
              <camunda:inputParameter name="handleError">true</camunda:inputParameter>
            </camunda:inputOutput>
          </bpmn:extensionElements>
