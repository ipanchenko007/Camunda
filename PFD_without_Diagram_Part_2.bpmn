    <bpmn:scriptTask id="Activity_1skk52q" name="Отмена задачи пользователя" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_09fgag1</bpmn:incoming>
      <bpmn:outgoing>Flow_07c7kvi</bpmn:outgoing>
      <bpmn:script>import org.camunda.bpm.engine.runtime.ActivityInstance
import java.util.logging.Logger

def logger = Logger.getLogger("RPA_CANCEL_TASK")
def processEngine     = execution.getProcessEngine()
def runtimeService    = processEngine.getRuntimeService()
def taskService       = processEngine.getTaskService()
def processInstanceId = execution.getProcessInstanceId()

// Ищем активный экземпляр user task Activity_1mbdowq
def rootInstance = runtimeService.getActivityInstance(processInstanceId)

def findActivity
findActivity = { ActivityInstance node -&gt;
    if (node.activityId == "Activity_1mbdowq") return node
    for (child in node.childActivityInstances) {
        def found = findActivity(child)
        if (found != null) return found
    }
    return null
}

def userTaskInstance = findActivity(rootInstance)

if (userTaskInstance != null) {

    // Получаем реальный taskId из runtime
    def tasks = taskService
        .createTaskQuery()
        .processInstanceId(processInstanceId)
        .taskDefinitionKey("Activity_1mbdowq")
        .list()

    logger.info("### состав=${tasks != null &amp;&amp; !tasks.isEmpty()}")
    if (tasks != null &amp;&amp; !tasks.isEmpty()) {
        def taskId = tasks.get(0).getId()

        // Создаём комментарий ДО отмены — после cancelActivityInstance задача недоступна
        taskService.createComment(
            taskId,
            processInstanceId,
            "Задача закрыта роботом"
        )

        logger.info("### RPA: комментарий создан для task=${taskId}")
    }

    // Отменяем user task внутри Camunda (без REST)
    runtimeService
        .createProcessInstanceModification(processInstanceId)
        .cancelActivityInstance(userTaskInstance.id)
        .execute()

    logger.info("### RPA победил: Activity_1mbdowq отменена. processInstanceId=${processInstanceId}")

} else {
    // Задача уже завершена пользователем — ничего не делаем
    logger.info("### RPA победил: Activity_1mbdowq уже не активна, пропускаем. processInstanceId=${processInstanceId}")
}</bpmn:script>
    </bpmn:scriptTask>
