      <bpmn:incoming>Flow_0blps1g</bpmn:incoming>
      <bpmn:outgoing>Flow_18apbyj</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0z8hh1g" messageRef="Message_1lbndic" />
