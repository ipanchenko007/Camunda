            <camunda:inputParameter name="body">
              <camunda:script scriptFormat="groovy">[
          "AB306_SUPPLIER_NAME": S(vendorData).prop("vendorFullName")?.stringValue()
        ]</camunda:script>
            </camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1jhoqy5</bpmn:incoming>
