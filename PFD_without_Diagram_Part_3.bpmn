              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0p3g7ik</bpmn:incoming>
        <bpmn:outgoing>Flow_1wnfbnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="Activity_0dhh3mn" name="Инициализация переменных" scriptFormat="groovy">
        <bpmn:incoming>Flow_1thgd6c</bpmn:incoming>
        <bpmn:outgoing>Flow_1hs78cq</bpmn:outgoing>
        <bpmn:script>def isHappyPath = S(response).prop("isHappyPath").boolValue()
execution.setVariable("isHappyPath", isHappyPath)

// Инициализируем retryCount только если ещё не существует
if (execution.getVariable("retryCount") == null) {
    execution.setVariable("retryCount", 0)
}

execution.setVariable("priorityResolved", false)
execution.setVariable("priority", null)
execution.setVariable("priorityCodeRaw", null)</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_11wmlhj" name="Разбор ответа НФС" scriptFormat="groovy">
        <bpmn:incoming>Flow_14cf1ua</bpmn:incoming>
        <bpmn:outgoing>Flow_0p3g7ik</bpmn:outgoing>
        <bpmn:script>def json = S(response)

// paymentDate
def paymentDateRaw = null
if (json.hasProp("paymentDate") &amp;&amp; !json.prop("paymentDate").isNull()) {
    paymentDateRaw = json.prop("paymentDate").stringValue()
    if (paymentDateRaw != null) paymentDateRaw = paymentDateRaw.trim()
}
if (paymentDateRaw != null &amp;&amp; !paymentDateRaw.isEmpty()) {
    execution.setVariable("dpp", paymentDateRaw)
} else {
    execution.setVariable("dpp", null)
}

// eventDate
def eventDateRaw = null
if (json.hasProp("eventDate") &amp;&amp; !json.prop("eventDate").isNull()) {
    eventDateRaw = json.prop("eventDate").stringValue()
    if (eventDateRaw != null) eventDateRaw = eventDateRaw.trim()
}
if (eventDateRaw != null &amp;&amp; !eventDateRaw.isEmpty()) {
    execution.setVariable("event_date", eventDateRaw)
} else {
    execution.setVariable("event_date", null)
}

// priorityStatus
def priorityCodeRaw = null
if (json.hasProp("priorityStatus") &amp;&amp; !json.prop("priorityStatus").isNull()) {
    priorityCodeRaw = json.prop("priorityStatus").stringValue()
    if (priorityCodeRaw != null) priorityCodeRaw = priorityCodeRaw.trim()
}

def priorityMap = [
    "urgent_queue_2": "Срочная очередь 2",
    "urgent_queue_1": "Срочная очередь 1",
    "not_urgent_queue": "Не срочная очередь",
    "no_processing_required": "Не требует обработки",
    "vat_refund": "Возмещение НДС"
]

if (!json.hasProp("priorityStatus") || priorityCodeRaw == null || priorityCodeRaw.isEmpty()) {
    execution.setVariable("priorityResolved", false)
    execution.setVariable("priority", null)
} else {
    def priorityName = priorityMap.get(priorityCodeRaw)
    if (priorityName != null) {
        execution.setVariable("priority", priorityName)
        execution.setVariable("priorityResolved", true)
    } else {
        execution.setVariable("priorityResolved", false)
        execution.setVariable("priority", null)
    }
}
execution.setVariable("priorityCodeRaw", priorityCodeRaw)</bpmn:script>
      </bpmn:scriptTask>
