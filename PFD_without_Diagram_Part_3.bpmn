      <bpmn:serviceTask id="Activity_1ymz818" name="Запрос связанных документов" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
            <camunda:inputParameter name="path">private/documents/{guid}/relations</camunda:inputParameter>
