    <bpmn:scriptTask id="Activity_00uesg7" name="Поиск КЗП" scriptFormat="groovy">
      <bpmn:incoming>Flow_0c99vo0</bpmn:incoming>
      <bpmn:outgoing>Flow_04jnshr</bpmn:outgoing>
      <bpmn:script>import static org.camunda.spin.Spin.JSON

def doc = execution.getVariable("document")
def result = "userLink"   // дефолт

if (doc) {
    def json = JSON(doc)

    if (json.hasProp("data")
        &amp;&amp; json.prop("data").hasProp("attributes")
        &amp;&amp; json.prop("data").prop("attributes").hasProp("ZP")
        &amp;&amp; json.prop("data").prop("attributes").prop("ZP").elements().size() &gt; 0) {

        def zpObj = json
            .prop("data")
            .prop("attributes")
            .prop("ZP")
            .elements()[0]

        def has296 = zpObj.hasProp("AB296_PURCHASE_ORDER_NUMBER")
        def has357 = zpObj.hasProp("AB357_PURCHASE_CONTRACT_NUMBER")

        if (has357) {
            result = "linkZP"
        } else if (has296) {
            result = "requestapi"
        }
    }
}

if (execution.hasVariable("linkContractPFD")) {
    result = "linkContractPFD";
}

execution.setVariable("routeVar", result)


import static org.camunda.spin.Spin.S

if (!execution.hasVariable("loginsContractPFD")) {
    return
}

def raw = execution.getVariable("loginsContractPFD")

if (raw == null) {
    return
}

def jsonArray = raw instanceof String ? S(raw) : raw

def list = jsonArray.elements()
                    .collect { it.stringValue() }

execution.setVariable("loginsContractPFDValue", list)
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_04jnshr" sourceRef="Activity_00uesg7" targetRef="Activity_0g48twm" />
    <bpmn:scriptTask id="Activity_0g48twm" name="Наличие документа-основания" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_04jnshr</bpmn:incoming>
      <bpmn:outgoing>Flow_1k86qdw</bpmn:outgoing>
      <bpmn:script>// Определяем наличие документа-основания (связь типа BASE_DOCUMENT)
def hasBaseDocument = false

// Получаем данные документа
def doc = S(documents)

def relations = []

// Проверяем наличие data
if (doc.prop("data") != null) {
    def data = doc.prop("data")
    
    // Проверяем, может быть data сама является массивом relations
    if (data.isArray()) {
        relations = data.elements()
    }
}

// Ищем BASE_DOCUMENT в relations
if (relations != null &amp;&amp; !relations.isEmpty()) {
    for (relation in relations) {
        def relationObj = S(relation)
        def relationCode = relationObj.prop("relationCode")?.stringValue()
        
        if (relationCode == "BASE_DOCUMENT") {
            hasBaseDocument = true
            break
        }
    }
}

// Устанавливаем переменную процесса
execution.setVariable("hasBaseDocument", hasBaseDocument)</bpmn:script>
    </bpmn:scriptTask>
