      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_1jgl2m7" name="Приложены документы с типом &#34;Пакет&#34;?" default="Flow_05xozmi">
        <bpmn:incoming>Flow_1mqppv9</bpmn:incoming>
        <bpmn:outgoing>Flow_0oah5h7</bpmn:outgoing>
        <bpmn:outgoing>Flow_05xozmi</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="Activity_0kntdw9" name="Проверка результата обработки атрибутов" scriptFormat="groovy">
        <bpmn:incoming>Flow_0gax0ig</bpmn:incoming>
        <bpmn:outgoing>Flow_0wdzdlm</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonOutput
println "=========Старт формирования списка документов для перемещения============="  
def log     = org.slf4j.LoggerFactory.getLogger("MoveDocDiadoc")
def pid     = execution.getProcessInstanceId()
def docList = execution.getVariable("diadocDocuments") ?: []

if (docList.isEmpty()) {
    log.warn("[MoveDocDiadoc][{}] Все документы пакета пропущены: атрибуты Диадок отсутствуют у всех документов.",
             pid)
    execution.setVariable("NoDocDiadoc", true)
} else {
    def json = JsonOutput.toJson(docList)
   
log.info("[MoveDocDiadoc][{}] Сформирован список для перемещения. Документов: {}. JSON: {}",
             pid, docList.size(), json)

    execution.setVariable("NoDocDiadoc",         false)
    execution.setVariable("diadocDocumentsJson",  json)
}
println "=========Окончание формирования списка документов для перемещения============="</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_0gq8r7l" name="Инициализация переменных" scriptFormat="groovy">
        <bpmn:incoming>Flow_0a5p2zx</bpmn:incoming>
        <bpmn:outgoing>Flow_0shah67</bpmn:outgoing>
        <bpmn:script>def log = org.slf4j.LoggerFactory.getLogger("MoveDocDiadoc")
def pid = execution.getProcessInstanceId()

execution.setVariable("diadocDocGuid",      [])
execution.setVariable("diadocDocuments",     [])
execution.setVariable("NoPackageType",       false)
execution.setVariable("NoDocDiadoc",         false)
execution.setVariable("diadocDocumentsJson", "[]")

log.info("[MoveDocDiadoc][{}] Процесс запущен. entityGuid={}", pid, execution.getVariable("entityGuid"))</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:subProcess id="Activity_1gsydfl" name="Обработка документов пакета" camunda:asyncBefore="true">
        <bpmn:incoming>Flow_05xozmi</bpmn:incoming>
        <bpmn:outgoing>Flow_0gax0ig</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${diadocDocGuid}" camunda:elementVariable="diadocDoc" />
        <bpmn:startEvent id="Event_05ljek6">
          <bpmn:outgoing>Flow_1we3n9s</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="Activity_0fgaz7w" name="Запрос атрибутов документа" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
          <bpmn:extensionElements>
            <camunda:inputOutput>
              <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
              <camunda:inputParameter name="path">private/documents/{guid}</camunda:inputParameter>
              <camunda:inputParameter name="pathParams">
                <camunda:map>
                  <camunda:entry key="guid">${diadocDoc}</camunda:entry>
                </camunda:map>
              </camunda:inputParameter>
              <camunda:inputParameter name="method">GET</camunda:inputParameter>
              <camunda:inputParameter name="resultVarName">packageDocs</camunda:inputParameter>
            </camunda:inputOutput>
            <camunda:failedJobRetryTimeCycle />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1we3n9s</bpmn:incoming>
          <bpmn:outgoing>Flow_0mv43pg</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:scriptTask id="Activity_1id8wjo" name="Обработка атрибутов документов" scriptFormat="groovy">
          <bpmn:incoming>Flow_0mv43pg</bpmn:incoming>
          <bpmn:outgoing>Flow_1f37bfx</bpmn:outgoing>
          <bpmn:script>def log = org.slf4j.LoggerFactory.getLogger("MoveDocDiadoc")
def pid = execution.getProcessInstanceId()

def attributes  = S(packageDocs).prop("data").prop("attributes")
def documentId  = attributes.hasProp("AB369_ENTITY_ID") ? attributes.prop("AB369_ENTITY_ID").stringValue() : null
def messageId   = attributes.hasProp("AB368_MESSAGE_ID") ? attributes.prop("AB368_MESSAGE_ID").stringValue() : null
def currentGuid = diadocDoc  // элементная переменная MI — уже строка

if (!documentId || !messageId) {
    log.warn("[MoveDocDiadoc][{}] Документ guid={} пропущен: AB369_ENTITY_ID='{}', AB368_MESSAGE_ID='{}'",
             pid, currentGuid, documentId, messageId)
    return
}

def docList = execution.getVariable("diadocDocuments") ?: []
docList &lt;&lt; [messageId: messageId, documentId: documentId]
execution.setVariable("diadocDocuments", docList)

log.debug("[MoveDocDiadoc][{}] Документ guid={} добавлен в коллекцию. messageId={}, documentId={}",
          pid, currentGuid, messageId, documentId)</bpmn:script>
        </bpmn:scriptTask>
