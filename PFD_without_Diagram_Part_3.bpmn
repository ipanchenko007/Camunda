    <bpmn:scriptTask id="Activity_1u2ljzh" name="Инициализация переменных" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_18joead</bpmn:incoming>
      <bpmn:outgoing>Flow_0xvnykr</bpmn:outgoing>
      <bpmn:script>import java.util.logging.Logger
import java.text.SimpleDateFormat

def createdStr = S(document).prop("data").prop("created").stringValue()
def sdfIn = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss")
def sdfOut = new SimpleDateFormat("dd.MM.yyyy HH:mm")
execution.setVariable("createDate", sdfOut.format(sdfIn.parse(createdStr)))
execution.setVariable('verificationTaskName',"Проверить документы ПФД в пакете");
execution.setVariable('checkContractTaskName',"Проверить связь с договором");
execution.setVariable('hasFilial', true);
execution.setVariable('signTaskName',"Подписать документы");
execution.setVariable('sendBeeidp', true);
execution.setVariable('revocationCanselPack', false);


Logger logger = Logger.getLogger("PFD_ECM_LOG")
logger.info("processId: " + execution.getProcessInstanceId())

// Устанавливаем переменную, что пакет относится к ЭДО
def attributes = S(document).prop("data").prop("attributes")
boolean isEDO = false

if (attributes != null &amp;&amp; !attributes.isNull()
    &amp;&amp; attributes.hasProp("AB310_EDO_OPERATOR")
    &amp;&amp; !attributes.prop("AB310_EDO_OPERATOR").isNull()) {
  isEDO = true
}
execution.setVariable("isEDO", isEDO)

//Для задачи согласования
execution.setVariable("needRework", false)
execution.setVariable("needReject", false)
//для частичного отказа от подписания
execution.setVariable("partialReject", false)
//для полного отказа от подписания
execution.setVariable("fullRejectBool", false)
//признак что найден дубль
execution.setVariable('findDuplicate', false)
//признак что кнопка дубль нажата инициатором
execution.setVariable('duplicateFromInitiator', false)
//признак что Диадок вернул ошибку
execution.setVariable('diadocError', false)
//выключение доработки BEEDOCS-4180
execution.setVariable('BEEDOCS4180', true)
//выключение доработки BEEDOCS-5177
execution.setVariable('BEEDOCS5177', true)
//выключение доработки BEEDOCS-3548
execution.setVariable('BEEDOCS3548', true)
//выключение доработки BEEDOCS-5646
execution.setVariable('BEEDOCS5646', true)
//выключение доработки BEEDOCS-6279
execution.setVariable('BEEDOCS6279', true)
//выключение доработки отправка в ЕСМ
execution.setVariable('sendECM', false)
//выключение доработки перемещение документов в Диадок
execution.setVariable('moveDiadoc', true)
//признак что подписант назначен автоматически
execution.setVariable('isNotDefaultSequence', false)
//признак что все документы подписаны
execution.setVariable('diadocFullSign', false)
//сообщение из diadoc
execution.setVariable('diadocRes','Системное сообщение: Пустой список документов. Запроса в ЭДО не было');
//taskOutcome делаем пустым
execution.setVariable('taskOutcome','')
execution.setVariable("signatory",'')
execution.setVariable('findDocumentZP', false)

//проверка налоговой ставки (включена по умолчанию)
execution.setVariable('checkTax', true)

//отправка в Энергобиллинг на доп согласование энергетиком
execution.setVariable('sendEB', true)

//определим признак закрытого пакета
def attrs = document.prop("data")?.prop("attributes")
def isLocked = false

if (attrs?.hasProp("AB374_PACKET_IS_LOCKED")) {
    def value = attrs.prop("AB374_PACKET_IS_LOCKED")
    isLocked = value?.toString()?.toBoolean()
}

execution.setVariable("packageIsClosed", isLocked)

logger.info("packageIsClosed: "+packageIsClosed);
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_1gbrkd9" name="Передача атрибута ссылка на пакет" camunda:delegateExpression="#{restClient}">
