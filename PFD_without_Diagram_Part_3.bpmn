        <bpmn:outgoing>Flow_0xtm7wn</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:scriptTask id="Activity_0gojmo7" name="Формирование json для поиска СЗП в НФС" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_0xtm7wn</bpmn:incoming>
        <bpmn:outgoing>Flow_1swfepc</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonOutput
import static org.camunda.spin.Spin.S

// Получаем исходный JSON из переменной процесса
def documentJson = execution.getVariable("document")

if (documentJson == null) {
    throw new RuntimeException("Переменная 'document' не найдена")
}

// Получаем массив ZP
def attributes = S(documentJson)
        .prop("data")
        .prop("attributes")
        .prop("ZP")

def poNumber = null

// Ищем AB296_PURCHASE_ORDER_NUMBER в массиве
if (attributes != null &amp;&amp; attributes.isArray()) {
    for (def item in attributes.elements()) {

        if (item.hasProp("AB296_PURCHASE_ORDER_NUMBER")) {

            def node = item.prop("AB296_PURCHASE_ORDER_NUMBER")

            if (node != null &amp;&amp; !node.isNull()) {
                // Работает и для string и для number
                poNumber = node.value()?.toString()
            }

            break
        }
    }
}

// Формируем внутренний payload
def innerPayload = [
        PO_SOURCE: null,
        TYPE_LOOKUP_CODE: null,
        PO_HEADER_ID: null,
        PO_NUMBER: poNumber,
        CREATION_DATE_FROM: null,
        CREATION_DATE_TO: null,
        DOC_TYPE_CODE1: null,
        CONTRACT_ID: null,
        STATUS: null,
        CLOSED_CODE: null,
        CANCEL_FLAG: null,
        SUPPLIER_ID: null,
        SUPPLIER_NAME: null,
        NUM_1099: null,
        LAST_UPDATE_FROM: null,
        LAST_UPDATE_TO: null
]

// Формируем корневой объект
def rootPayload = [
        PO_HEADERS: innerPayload
]

// Сериализуем в JSON
def finalJson = JsonOutput.toJson(rootPayload)

// Сохраняем в процесс
execution.setVariable("apiRequestBodyNFS", finalJson)
execution.setVariable("poNumber", poNumber)</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_03zjge3" name="Получение номера КЗП из ответа API" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_10r5h20</bpmn:incoming>
        <bpmn:outgoing>Flow_1cygxqz</bpmn:outgoing>
        <bpmn:script>def contractNumValue = null

if (execution.hasVariable("NFSrequest") &amp;&amp; NFSrequest != null) {

    def contractNum = S(NFSrequest).prop("po_info")

    if (contractNum != null &amp;&amp; contractNum.isArray()) {
        for (def item in contractNum.elements()) {
            if (item.hasProp("contract_num") &amp;&amp; !item.prop("contract_num").isNull()) {
                contractNumValue = item.prop("contract_num").value().toString()
                break
            }
        }
    }
}

execution.setVariable(
    "contractNumValue",contractNumValue
)

import static org.camunda.spin.Spin.JSON

// исходный документ
def json = JSON(execution.getVariable("document"))

def poNumber = execution.getVariable("poNumber")?.toString()
def NFSRequestID = execution.getVariable("NFSRequestID")?.toString()

// массив ZP
def zpArray = json
        .prop("data")
        .prop("attributes")
        .prop("ZP")

// обновляем элемент
    zpArray.elements().each { zp -&gt;

        if (zp.hasProp("AB296_PURCHASE_ORDER_NUMBER")) {

            def poNode = zp.prop("AB296_PURCHASE_ORDER_NUMBER")
            def currentPo = null

            if (poNode != null &amp;&amp; !poNode.isNull()) {
                // приводим к строке и убираем внешние кавычки
                currentPo = String.valueOf(poNode.unwrap()).replaceAll('^"|"$', '').trim()
            }

            def poNumberStr = poNumber?.trim()

execution.setVariable("currentPo", currentPo)
execution.setVariable("poNumberStr", poNumberStr)

if (currentPo != null &amp;&amp; currentPo == poNumberStr &amp;&amp; contractNumValue) {
    zp.prop("AB357_PURCHASE_CONTRACT_NUMBER", contractNumValue)
}
        }
    }




// ⬇️ ВАЖНО: формируем объект вручную строкой
def zpBody = '{ "ZP": ' + zpArray.toString() + ' }'

// сохраняем ТОЛЬКО как строку
execution.setVariable("documentZP", zpBody)

if (!contractNumValue) {
    execution.setVariable("routeVar", "userLink")
}</bpmn:script>
      </bpmn:scriptTask>
