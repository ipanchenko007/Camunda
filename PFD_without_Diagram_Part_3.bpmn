    <bpmn:serviceTask id="Activity_1flsscs" name="Проверка налоговой ставки" camunda:asyncBefore="true" camunda:delegateExpression="#{checkTaxRate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="documentGuid">${entityGuid}</camunda:inputParameter>
          <camunda:inputParameter name="package_guid">${entityGuid}</camunda:inputParameter>
          <camunda:inputParameter name="resultVarName">taxRateResult</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:failedJobRetryTimeCycle>R3/PT1M</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
