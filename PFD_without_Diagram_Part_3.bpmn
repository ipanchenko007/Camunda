              <camunda:map>
                <camunda:entry key="guid">${entityGuid}</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">documents</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0shah67</bpmn:incoming>
        <bpmn:outgoing>Flow_17jjc46</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="Activity_0jxflai" name="Формирование списка guid документов" scriptFormat="groovy">
        <bpmn:incoming>Flow_17jjc46</bpmn:incoming>
        <bpmn:outgoing>Flow_1mqppv9</bpmn:outgoing>
        <bpmn:script>println "=========Старт отбора документов для перемещения============="
def log = org.slf4j.LoggerFactory.getLogger("MoveDocDiadoc")
def pid  = execution.getProcessInstanceId()

def packageGuids = S(documents)
    .prop("data")
    .elements()
    .findAll { it.prop("relationCode").stringValue() == "PACKAGE" }
    .collect  { it.prop("targetGuid").stringValue() }

if (packageGuids.isEmpty()) {

    log.warn("[MoveDocDiadoc][{}] Документов с relationCode=PACKAGE не найдено. Пакет: {}",
             pid, execution.getVariable("entityGuid"))

    execution.setVariable("NoPackageType", true)
} else {

log.info("[MoveDocDiadoc][{}] Найдено документов с типом PACKAGE: {}. Guid-ы: {}",
             pid, packageGuids.size(), packageGuids)
    execution.setVariable("NoPackageType",  false)
    execution.setVariable("diadocDocGuid",  packageGuids)
}
println "=========Окончание отбора документов для перемещения============="</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="Activity_0nuaquk" name="Перемещение документов в папках Диадок" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">dc-connector</camunda:inputParameter>
            <camunda:inputParameter name="path">private/diadoc/api/v1/move/document</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="body">{
  "boxId": "7f4708c6-3f56-4694-b77a-0252424e7544",
  "departmentId": "46a43854-4fd2-49c3-b0bb-9eb942398047",
  "documentIds": ${diadocDocumentsJson}
}</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">responseDiadoc</camunda:inputParameter>
            <camunda:inputParameter name="handleError">true</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1neg2r1</bpmn:incoming>
        <bpmn:outgoing>Flow_0xp6k6r</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_16ofh0y">
        <bpmn:incoming>Flow_0yj9t4d</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:scriptTask id="Activity_1k3l56b" name="Лог обработки ответа Диадок" scriptFormat="groovy">
        <bpmn:incoming>Flow_0favkhx</bpmn:incoming>
        <bpmn:outgoing>Flow_09ca49w</bpmn:outgoing>
        <bpmn:script>def log      = org.slf4j.LoggerFactory.getLogger("MoveDocDiadoc")
def pid      = execution.getProcessInstanceId()
def response = execution.getVariable("responseDiadoc")
println "===============Логирование ответа Диадок=================="
// Определяем, был ли вызов Диадок вообще выполнен
def noPackage = execution.getVariable("NoPackageType") ?: false
def noDiadoc  = execution.getVariable("NoDocDiadoc")   ?: false

if (noPackage) {
    log.info("[MoveDocDiadoc][{}] Процесс завершён: документы с типом PACKAGE не найдены.", pid)
} else if (noDiadoc) {
    log.info("[MoveDocDiadoc][{}] Процесс завершён: у всех документов отсутствуют атрибуты Диадок.", pid)
} else {
    log.info("[MoveDocDiadoc][{}] Процесс завершён. Ответ Диадок: {}", pid, response?.toString() ?: "пустой ответ")
}
println "========================================="</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="Gateway_0of6abd" name="Получилось сформировать список документов к перемещению?" default="Flow_1neg2r1">
