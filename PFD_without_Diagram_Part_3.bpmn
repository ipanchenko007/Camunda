    <bpmn:exclusiveGateway id="Gateway_01rsdyy" name="Возмещение НДС?" default="Flow_14u76ds">
      <bpmn:incoming>Flow_0cwzqj9</bpmn:incoming>
      <bpmn:outgoing>Flow_07lnxlk</bpmn:outgoing>
