    <bpmn:serviceTask id="Activity_1tmt5sp" name="Поиск дублей" camunda:asyncBefore="true" camunda:delegateExpression="#{checkDuplicateInPackage}">
      <bpmn:documentation>guidPackage - guid пакета
relationType - тип связи
listCodeStatus - статусы исключения
listDocumentCodes - список типов, для которых ищем дубли
dateHistory - глубина запроса, если отсутствует, то текущая дата минус 6 месяцев</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="guid">${entityGuid}</camunda:inputParameter>
          <camunda:inputParameter name="relationType">PACKAGE</camunda:inputParameter>
          <camunda:inputParameter name="listCodeStatus">
            <camunda:script scriptFormat="groovy">def list = ["DRAFT", "DS019_DELETED","DS053_DOUBLE"];
list</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="listDocumentCodes">
            <camunda:script scriptFormat="groovy">def list = ['TP_PROFORMAINVOICE','TP_ACCEPTANCE_CERTIFICATE','TP_TRANSFER_ACCEPTANCE_CERTIFICATE','TP_INVOICE','TP_UNIVERSAL_TRANSFER_DOCUMENT','TP_EDO_DOCUMENT'];
list</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="resultVarName">duplicateResult</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ane9b0</bpmn:incoming>
      <bpmn:outgoing>Flow_1co7159</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_1xj72dj" name="Поиск КЗП" scriptFormat="groovy">
      <bpmn:incoming>Flow_0l5tebg</bpmn:incoming>
      <bpmn:outgoing>Flow_1bx0idh</bpmn:outgoing>
      <bpmn:script>import static org.camunda.spin.Spin.JSON

def doc = execution.getVariable("document")
def result = "userLink"   // дефолт

if (doc) {
    def json = JSON(doc)

    if (json.hasProp("data")
        &amp;&amp; json.prop("data").hasProp("attributes")
        &amp;&amp; json.prop("data").prop("attributes").hasProp("ZP")
        &amp;&amp; json.prop("data").prop("attributes").prop("ZP").elements().size() &gt; 0) {

        def zpObj = json
            .prop("data")
            .prop("attributes")
            .prop("ZP")
            .elements()[0]

        def has296 = zpObj.hasProp("AB296_PURCHASE_ORDER_NUMBER")
        def has357 = zpObj.hasProp("AB357_PURCHASE_CONTRACT_NUMBER")

        if (has357) {
            result = "linkZP"
        } else if (has296) {
            result = "requestapi"
        }
    }
}

if (execution.hasVariable("linkContractPFD")) {
    result = "linkContractPFD";
}

execution.setVariable("routeVar", result)


import static org.camunda.spin.Spin.S

if (!execution.hasVariable("loginsContractPFD")) {
    return
}

def raw = execution.getVariable("loginsContractPFD")

if (raw == null) {
    return
}

def jsonArray = raw instanceof String ? S(raw) : raw

def list = jsonArray.elements()
                    .collect { it.stringValue() }

execution.setVariable("loginsContractPFDValue", list)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:intermediateThrowEvent id="Event_0degjyy" name="Статус &#34;Создан&#34;">
      <bpmn:incoming>Flow_0xvnykr</bpmn:incoming>
      <bpmn:outgoing>Flow_0qayiux</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="EscalationEventDefinition_1lj3avo" escalationRef="Escalation_21rjijn" />
    </bpmn:intermediateThrowEvent>
    <bpmn:scriptTask id="Activity_0o4r72t" name="Обработка результата" scriptFormat="groovy">
      <bpmn:incoming>Flow_1co7159</bpmn:incoming>
      <bpmn:outgoing>Flow_0a5wmbf</bpmn:outgoing>
      <bpmn:script>import static org.camunda.spin.Spin.JSON

def title= S(document).prop("data").prop("title").stringValue();
def comment = "";
def dDocs = [];

if(findDuplicate){
    def bUrl = baseUrl;

    // Удаляем /api или /api/ в конце URL
    def baseUrl = bUrl.replaceAll('/api/?$', '')

    def blocks = duplicateComment.collect { 
        guid, urls -&gt;
            def links = urls.collect { url -&gt;
                """&lt;li&gt;&lt;a href="${url}"&gt;${url}&lt;/a&gt;&lt;/li&gt;"""
            }.join("\n")

            // Заголовок для каждого GUID
            return """
               &lt;p&gt;&lt;b&gt;&lt;a href="${baseUrl}/document-and-storage/list/user/${guid}/view?tab=base-info"&gt;Документ&lt;/a&gt;:&lt;/b&gt;&lt;/p&gt;
               &lt;ul style='list-style-type: none;'&gt;
                   ${links}
               &lt;/ul&gt;
            """
    }

    comment =
        '&lt;p style="color: red"&gt;Необходимо устранить дублирующие документы:&lt;/p&gt;' +
        blocks.join("\n");
		
	dDocs = duplicateComment.collect { guid, urls -&gt;
		[guid: guid]
	}
}

execution.setVariable('messageProperties',[
						messageTitle: title, 
						packageId: entityGuid, 
						duplicateComment: comment
					  ]);
execution.setVariable('duplicateDocuments',dDocs);
execution.setVariable('urlContract', '');


if (execution.hasVariable("guidFindContract") &amp;&amp; guidFindContract) {

    def baseUrlClean = (baseUrl ?: "").replaceAll('/api/?$', '')

    def guids = JSON(guidFindContract)
                    .elements()
                    .collect { it.stringValue() }

    if (guids &amp;&amp; !guids.isEmpty()) {

        def links = []

        links &lt;&lt; "Найдено несколько подходящих договоров-оснований:"

        guids.each { guid -&gt;
            links &lt;&lt; "${baseUrlClean}/document-and-storage/list/user/${guid}/view?tab=base-info"
        }

        def commentContract = links.join("\n")

        execution.setVariable('urlContract', commentContract)
    }
}</bpmn:script>
    </bpmn:scriptTask>
