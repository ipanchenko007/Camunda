      <bpmn:serviceTask id="Activity_1xq6a9i" name="Запрос справочника LD144" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">dictionaries</camunda:inputParameter>
            <camunda:inputParameter name="path">/private/dictionaries/{dictionaryCode}/values</camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">catalogResponse</camunda:inputParameter>
            <camunda:inputParameter name="pathParams">
              <camunda:map>
                <camunda:entry key="dictionaryCode">LD144_PRIORITY_STATUS</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="queryParams">
              <camunda:map>
                <camunda:entry key="all">false</camunda:entry>
                <camunda:entry key="direction">asc</camunda:entry>
                <camunda:entry key="limit">50</camunda:entry>
