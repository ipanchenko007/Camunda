    <bpmn:subProcess id="Activity_1usnc0m" name="Поиск СЗП в НФС и получение номера КЗП">
      <bpmn:incoming>Flow_067bb6c</bpmn:incoming>
      <bpmn:outgoing>Flow_1dx6uz5</bpmn:outgoing>
