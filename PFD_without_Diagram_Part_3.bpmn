      <bpmn:serviceTask id="Activity_0oplysp" name="Передача ID пакета в EDF" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">pfd-service</camunda:inputParameter>
            <camunda:inputParameter name="path">private/integration/send-to-edf-for-processing</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="body">{
  "beedocs_container_id": "${beedocsContainerId}",
  "routing_code": "rents",
  "edf_preprocessing": true
}</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">edfSendResponse</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1xd847q</bpmn:incoming>
        <bpmn:outgoing>Flow_1jgvr5w</bpmn:outgoing>
