    <bpmn:sequenceFlow id="Flow_1tmp8zx" sourceRef="Activity_0k9qam3" targetRef="Activity_0mr7ljr" />
    <bpmn:sequenceFlow id="Flow_16sm6vh" sourceRef="Activity_0vkhlz0" targetRef="Activity_0k9qam3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${retryCount &gt;= 4}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08cgpvj" sourceRef="Activity_0lehuya" targetRef="Gateway_00v69fu" />
    <bpmn:sequenceFlow id="Flow_00esla7" sourceRef="Activity_1khyrj1" targetRef="Activity_1cai990" />
    <bpmn:sequenceFlow id="Flow_1c9q92w" name="Да" sourceRef="Gateway_00v69fu" targetRef="Event_1adpr0a">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${priorityStatusValue == "Не требует обработки"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0cwzqj9" name="Иное" sourceRef="Gateway_00v69fu" targetRef="Gateway_01rsdyy">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${priorityStatusValue != "Не требует обработки"}</bpmn:conditionExpression>
