    <bpmn:scriptTask id="Activity_0zom4s9" name="RPA Counter" scriptFormat="groovy">
      <bpmn:incoming>Flow_1t4vyfw</bpmn:incoming>
      <bpmn:outgoing>Flow_0clrnyv</bpmn:outgoing>
      <bpmn:script>import java.time.LocalDateTime
import java.time.format.DateTimeFormatter
import java.util.logging.Logger

def logger = Logger.getLogger("RPA_Counter_Logger")

// 1. Формируем дату и время
def now = LocalDateTime.now()
def formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss")
def dateString = now.format(formatter)

def processInstanceId = execution.getProcessInstanceId()
def docGuid = execution.getVariable("entityGuid")

// 2. Работаем со счетчиком
def oldCounter = execution.getVariable("rpaCounter") ?: 0
def newCounter = oldCounter + 1

// 3. Логирование
def logMessage = "[RPA Counter] Time: ${dateString} | Process: ${processInstanceId} | Doc: ${docGuid} | Old: ${oldCounter} -&gt; New: ${newCounter}"
logger.info(logMessage)
println(logMessage)

// 4. Записываем переменные в контекст процесса
execution.setVariable("rpaCounter", newCounter)
execution.setVariable("rpaCounterUpdated", true)
execution.setVariable("AB1000_DATE_RPA", now) 
// --------------------------

println "&gt;&gt;&gt; Дата статуса записана в AB1000_DATE_RPA: ${dateString}"</bpmn:script>
    </bpmn:scriptTask>
