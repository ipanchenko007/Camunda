      <bpmn:scriptTask id="Activity_1dctr32" name="Фильтр документов по связи" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_0ooar8m</bpmn:incoming>
        <bpmn:outgoing>Flow_0lmk101</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import org.camunda.spin.Spin
import org.camunda.spin.json.SpinJsonNode
import com.fasterxml.jackson.databind.ObjectMapper

// Преобразуем SpinJsonNode в объект Groovy
def json = new JsonSlurper().parseText(documents.toString())

// Фильтруем только элементы с relationCode == "PACKAGE"
def mappedDocs = json.data.findAll { it.relationCode == "PACKAGE" }.collect { item -&gt;
    [guid: item.targetGuid]
}

ObjectMapper objectMapper = new ObjectMapper()

// Сохраняем в процесс (строкой)
execution.setVariable("documents", mappedDocs)
execution.setVariable("packageDocuments", objectMapper.writeValueAsString(mappedDocs))


</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:subProcess id="Activity_1vgysxi" name="Проверка документа ПФД на признак KND">
        <bpmn:incoming>Flow_0lmk101</bpmn:incoming>
        <bpmn:outgoing>Flow_11pbi2g</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${S(packageDocuments).elements()}" camunda:elementVariable="packageDoc" />
        <bpmn:startEvent id="Event_0rtg5u9">
          <bpmn:outgoing>Flow_1ffes3s</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="Activity_1kfb2kq" name="Запрос атрибутов документа" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
          <bpmn:extensionElements>
            <camunda:inputOutput>
              <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
              <camunda:inputParameter name="path">private/documents/{guid}</camunda:inputParameter>
              <camunda:inputParameter name="pathParams">
                <camunda:map>
                  <camunda:entry key="guid">${S(packageDoc).prop("guid").stringValue()}</camunda:entry>
                </camunda:map>
              </camunda:inputParameter>
              <camunda:inputParameter name="method">GET</camunda:inputParameter>
              <camunda:inputParameter name="resultVarName">documentPackage</camunda:inputParameter>
            </camunda:inputOutput>
            <camunda:failedJobRetryTimeCycle />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1ffes3s</bpmn:incoming>
          <bpmn:outgoing>Flow_11y2qcj</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:scriptTask id="Activity_0msr1wj" name="Проверка на признак KND" camunda:asyncBefore="true" scriptFormat="groovy">
          <bpmn:incoming>Flow_11y2qcj</bpmn:incoming>
          <bpmn:outgoing>Flow_0i7o77j</bpmn:outgoing>
          <bpmn:script>// текущий документ (SpinJsonNode)
def document = execution.getVariable("documentPackage")

boolean hasKndInCurrentDoc = false

if (document != null &amp;&amp;
    document.hasProp("data") &amp;&amp;
    document.prop("data").hasProp("attributes")) {

    def attributes = document.prop("data").prop("attributes")

    if (attributes.hasProp("AB416_KND")) {
        def kndValue = attributes.prop("AB416_KND")

        // Считаем, что "есть признак KND", только если значение не null
        if (!kndValue.isNull()) {
            hasKndInCurrentDoc = true
        }
    }
}

// Если нашли хотя бы один документ с KND != null
if (hasKndInCurrentDoc) {
    execution.setVariable("KND", true)
}
</bpmn:script>
        </bpmn:scriptTask>
        <bpmn:endEvent id="Event_0n4fucx">
          <bpmn:incoming>Flow_0i7o77j</bpmn:incoming>
        </bpmn:endEvent>
