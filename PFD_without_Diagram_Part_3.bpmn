    <bpmn:scriptTask id="Activity_02s5ppl" name="Обработка результата проверки ставки" scriptFormat="groovy">
      <bpmn:incoming>Flow_04ynjpg</bpmn:incoming>
      <bpmn:outgoing>Flow_0ax9wxy</bpmn:outgoing>
      <bpmn:script>import java.util.logging.Logger

Logger logger = Logger.getLogger("PFD_TAX_RATE_LOG")

def processId = execution.getProcessInstanceId()
def documentGuid = execution.getVariable("entityGuid")
def packageGuid = execution.getVariable("entityGuid")

logger.info("=== checkTaxRate INPUT === processId: " + processId + " | documentGuid: " + documentGuid + " | package_guid: " + packageGuid)

def retObject = execution.getVariable("retObject")
def code = "MIXED"

if (retObject == null) {
    logger.warning("checkTaxRate returned null (retObject is null) | processId: " + processId)
} else {
    logger.info("=== checkTaxRate RESULT === retObject: " + retObject.toString() + " | type: " + retObject.getClass().getName() + " | processId: " + processId)
    def spinRetObject = S(retObject)
    def successVal = spinRetObject.prop("success")?.boolValue()
    if (successVal != null &amp;&amp; !successVal) {
        def errorVal = spinRetObject.prop("error")?.stringValue() ?: "Неизвестная ошибка checkTaxRate"
        logger.severe("checkTaxRate error: " + errorVal)
    }
    def payloadNode = spinRetObject.prop("payload")
    if (payloadNode != null &amp;&amp; !payloadNode.isNull()) {
        code = payloadNode.prop("code")?.stringValue() ?: "MIXED"
    }
}

execution.setVariable("taxRateCode", code)
def savedCode = execution.getVariable("taxRateCode")
def savedRetObject = execution.getVariable("retObject")
logger.info("=== checkTaxRate OUTPUT === taxRateCode: " + savedCode + " | retObject: " + (savedRetObject != null ? savedRetObject.toString() : "null") + " | documentGuid: " + documentGuid + " | processId: " + processId)</bpmn:script>
    </bpmn:scriptTask>
