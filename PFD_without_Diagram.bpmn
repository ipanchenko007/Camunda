      <bpmn:scriptTask id="Activity_1hi0ol4" name="Получение КЗП из документа-основания и сравнение" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_1ikcyqv</bpmn:incoming>
        <bpmn:outgoing>Flow_1bpjqcn</bpmn:outgoing>
        <bpmn:script>def contractNumber = null

if (baseDocument != null) {
    def attrs = S(baseDocument).prop("data")?.prop("attributes")
    if (attrs != null &amp;&amp; attrs.hasProp("AB357_PURCHASE_CONTRACT_NUMBER")
            &amp;&amp; !attrs.prop("AB357_PURCHASE_CONTRACT_NUMBER").isNull()) {
        contractNumber = attrs.prop("AB357_PURCHASE_CONTRACT_NUMBER").stringValue()
    }
}

execution.setVariable("purchaseContractNumber", contractNumber)

// Сравнение только если значение атрибута получено
def contractNumValue = execution.getVariable("contractNumValue")
def contractNumbersMatch = false

if (contractNumber != null &amp;&amp; contractNumValue != null) {
    // trim на случай служебных пробелов + case-insensitive для устойчивости
    contractNumbersMatch = contractNumber.trim().equalsIgnoreCase(
        contractNumValue.toString().trim())
}

execution.setVariable("contractNumbersMatch", contractNumbersMatch)</bpmn:script>
