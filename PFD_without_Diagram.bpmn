    <bpmn:scriptTask id="Activity_00uesg7" name="Поиск КЗП" scriptFormat="groovy">
      <bpmn:incoming>Flow_0c99vo0</bpmn:incoming>
      <bpmn:outgoing>Flow_04jnshr</bpmn:outgoing>
      <bpmn:script>import static org.camunda.spin.Spin.JSON

def doc = execution.getVariable("document")
def result = "userLink"   // дефолт

if (doc) {
    def json = JSON(doc)

    if (json.hasProp("data")
        &amp;&amp; json.prop("data").hasProp("attributes")
        &amp;&amp; json.prop("data").prop("attributes").hasProp("ZP")
        &amp;&amp; json.prop("data").prop("attributes").prop("ZP").elements().size() &gt; 0) {

        def zpObj = json
            .prop("data")
            .prop("attributes")
            .prop("ZP")
            .elements()[0]

        def has296 = zpObj.hasProp("AB296_PURCHASE_ORDER_NUMBER")
        def has357 = zpObj.hasProp("AB357_PURCHASE_CONTRACT_NUMBER")

        if (has357) {
            result = "linkZP"
        } else if (has296) {
            result = "requestapi"
        }
    }
}

if (execution.hasVariable("linkContractPFD")) {
    result = "linkContractPFD";
}

execution.setVariable("routeVar", result)


import static org.camunda.spin.Spin.S

if (!execution.hasVariable("loginsContractPFD")) {
    return
}

def raw = execution.getVariable("loginsContractPFD")

if (raw == null) {
    return
}

def jsonArray = raw instanceof String ? S(raw) : raw

def list = jsonArray.elements()
                    .collect { it.stringValue() }

execution.setVariable("loginsContractPFDValue", list)
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_04jnshr" sourceRef="Activity_00uesg7" targetRef="Activity_0g48twm" />
    <bpmn:scriptTask id="Activity_0g48twm" name="Наличие документа-основания" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_04jnshr</bpmn:incoming>
      <bpmn:outgoing>Flow_1k86qdw</bpmn:outgoing>
      <bpmn:script>// Определяем наличие документа-основания (связь типа BASE_DOCUMENT)
def hasBaseDocument = false

// Получаем данные документа
def doc = S(documents)

def relations = []

// Проверяем наличие data
if (doc.prop("data") != null) {
    def data = doc.prop("data")
    
    // Проверяем, может быть data сама является массивом relations
    if (data.isArray()) {
        relations = data.elements()
    }
}

// Ищем BASE_DOCUMENT в relations
if (relations != null &amp;&amp; !relations.isEmpty()) {
    for (relation in relations) {
        def relationObj = S(relation)
        def relationCode = relationObj.prop("relationCode")?.stringValue()
        
        if (relationCode == "BASE_DOCUMENT") {
            hasBaseDocument = true
            break
        }
    }
}

// Устанавливаем переменную процесса
execution.setVariable("hasBaseDocument", hasBaseDocument)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1k86qdw" sourceRef="Activity_0g48twm" targetRef="Gateway_1sp628w" />
    <bpmn:exclusiveGateway id="Gateway_1802dqg">
      <bpmn:incoming>Flow_1ucba6s</bpmn:incoming>
      <bpmn:outgoing>Flow_067bb6c</bpmn:outgoing>
      <bpmn:outgoing>Flow_1lzw4zp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Activity_1usnc0m" name="Поиск СЗП в НФС и получение номера КЗП">
      <bpmn:incoming>Flow_067bb6c</bpmn:incoming>
      <bpmn:outgoing>Flow_1dx6uz5</bpmn:outgoing>
      <bpmn:startEvent id="Event_0ovizaq">
        <bpmn:outgoing>Flow_0xtm7wn</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:scriptTask id="Activity_0gojmo7" name="Формирование json для поиска СЗП в НФС" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_0xtm7wn</bpmn:incoming>
        <bpmn:outgoing>Flow_1swfepc</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonOutput
import static org.camunda.spin.Spin.S

// Получаем исходный JSON из переменной процесса
def documentJson = execution.getVariable("document")

if (documentJson == null) {
    throw new RuntimeException("Переменная 'document' не найдена")
}

// Получаем массив ZP
def attributes = S(documentJson)
        .prop("data")
        .prop("attributes")
        .prop("ZP")

def poNumber = null

// Ищем AB296_PURCHASE_ORDER_NUMBER в массиве
if (attributes != null &amp;&amp; attributes.isArray()) {
    for (def item in attributes.elements()) {

        if (item.hasProp("AB296_PURCHASE_ORDER_NUMBER")) {

            def node = item.prop("AB296_PURCHASE_ORDER_NUMBER")

            if (node != null &amp;&amp; !node.isNull()) {
                // Работает и для string и для number
                poNumber = node.value()?.toString()
            }

            break
        }
    }
}

// Формируем внутренний payload
def innerPayload = [
        PO_SOURCE: null,
        TYPE_LOOKUP_CODE: null,
        PO_HEADER_ID: null,
        PO_NUMBER: poNumber,
        CREATION_DATE_FROM: null,
        CREATION_DATE_TO: null,
        DOC_TYPE_CODE1: null,
        CONTRACT_ID: null,
        STATUS: null,
        CLOSED_CODE: null,
        CANCEL_FLAG: null,
        SUPPLIER_ID: null,
        SUPPLIER_NAME: null,
        NUM_1099: null,
        LAST_UPDATE_FROM: null,
        LAST_UPDATE_TO: null
]

// Формируем корневой объект
def rootPayload = [
        PO_HEADERS: innerPayload
]

// Сериализуем в JSON
def finalJson = JsonOutput.toJson(rootPayload)

// Сохраняем в процесс
execution.setVariable("apiRequestBodyNFS", finalJson)
execution.setVariable("poNumber", poNumber)</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_03zjge3" name="Получение номера КЗП из ответа API" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_10r5h20</bpmn:incoming>
        <bpmn:outgoing>Flow_1cygxqz</bpmn:outgoing>
        <bpmn:script>def contractNumValue = null

if (execution.hasVariable("NFSrequest") &amp;&amp; NFSrequest != null) {

    def contractNum = S(NFSrequest).prop("po_info")

    if (contractNum != null &amp;&amp; contractNum.isArray()) {
        for (def item in contractNum.elements()) {
            if (item.hasProp("contract_num") &amp;&amp; !item.prop("contract_num").isNull()) {
                contractNumValue = item.prop("contract_num").value().toString()
                break
            }
        }
    }
}

execution.setVariable(
    "contractNumValue",contractNumValue
)

import static org.camunda.spin.Spin.JSON

// исходный документ
def json = JSON(execution.getVariable("document"))

def poNumber = execution.getVariable("poNumber")?.toString()
def NFSRequestID = execution.getVariable("NFSRequestID")?.toString()

// массив ZP
def zpArray = json
        .prop("data")
        .prop("attributes")
        .prop("ZP")

// обновляем элемент
    zpArray.elements().each { zp -&gt;

        if (zp.hasProp("AB296_PURCHASE_ORDER_NUMBER")) {

            def poNode = zp.prop("AB296_PURCHASE_ORDER_NUMBER")
            def currentPo = null

            if (poNode != null &amp;&amp; !poNode.isNull()) {
                // приводим к строке и убираем внешние кавычки
                currentPo = String.valueOf(poNode.unwrap()).replaceAll('^"|"$', '').trim()
            }

            def poNumberStr = poNumber?.trim()

execution.setVariable("currentPo", currentPo)
execution.setVariable("poNumberStr", poNumberStr)

if (currentPo != null &amp;&amp; currentPo == poNumberStr &amp;&amp; contractNumValue) {
    zp.prop("AB357_PURCHASE_CONTRACT_NUMBER", contractNumValue)
}
        }
    }




// ⬇️ ВАЖНО: формируем объект вручную строкой
def zpBody = '{ "ZP": ' + zpArray.toString() + ' }'

// сохраняем ТОЛЬКО как строку
execution.setVariable("documentZP", zpBody)

if (!contractNumValue) {
    execution.setVariable("routeVar", "userLink")
}</bpmn:script>
