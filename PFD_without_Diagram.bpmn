    <bpmn:scriptTask id="Activity_1u3thfh" name="diadocRepeat + актуальный sdocuments без удаленных документов" scriptFormat="groovy">
      <bpmn:incoming>Flow_1o0zdh5</bpmn:incoming>
      <bpmn:outgoing>Flow_1kk9z4x</bpmn:outgoing>
      <bpmn:script>execution.setVariable("diadocRepeat",true);
//удалим из sdocuments документы, которых нет в связанных документах (пользователь мог удалить связь в открытом пакете)
def sRetryDocuments= execution.getVariable("sRetryDocuments")
def documents = execution.getVariable("documents")

def docGuids = documents.collect { it.targetGuid }

sRetryDocuments.removeIf { !docGuids.contains(it.targetGuid) }

execution.setVariable("sRetryDocuments", sRetryDocuments)
execution.setVariable("sdocuments", sRetryDocuments)
</bpmn:script>
    </bpmn:scriptTask>
