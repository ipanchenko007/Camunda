    <bpmn:userTask id="Activity_1mbdowq" name="Отправить пакет ПФД на оплату" camunda:asyncBefore="true" camunda:candidateGroups="RL024_ACCOUNTING" camunda:dueDate="#{extensions.timeService.calculateDueDate(2, 0, 0)}">
      <bpmn:documentation>${S(document).prop("data").prop("title").stringValue()}</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="actions">${userActions}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:taskListener event="complete">
          <camunda:script scriptFormat="groovy">import org.camunda.bpm.engine.RuntimeService
import org.camunda.bpm.engine.runtime.ActivityInstance

// В TaskListener доступен объект task
def execution = task.execution
def processEngine = execution.getProcessEngine()
def runtimeService = processEngine.getRuntimeService()
def processInstanceId = execution.getProcessInstanceId()

// Флаг: задачу выполнил пользователь
execution.setVariable("USER_COMPLETED_BEFORE_RPA", true)

// Ищем активный экземпляр подпроцесса Activity_0dpg8ze
def activityInstances = runtimeService.getActivityInstance(processInstanceId)

def findSubprocess
findSubprocess = { ActivityInstance node -&gt;
    if (node.activityId == "Activity_0dpg8ze") return node
    for (child in node.childActivityInstances) {
        def found = findSubprocess(child)
        if (found != null) return found
    }
    return null
}

def subprocessInstance = findSubprocess(activityInstances)

if (subprocessInstance != null) {
    println "===============LOG=================="
    println "### USER_COMPLETED: отменяем подпроцесс Activity_0dpg8ze"
    println "### subprocessInstanceId=${subprocessInstance.id}"
    println "===================================="

    runtimeService
        .createProcessInstanceModification(processInstanceId)
        .cancelActivityInstance(subprocessInstance.id)
        .execute()
} else {
    println "===============LOG=================="
    println "### USER_COMPLETED: подпроцесс Activity_0dpg8ze уже завершён или не найден"
    println "===================================="
}
</camunda:script>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0jg3zlf</bpmn:incoming>
      <bpmn:outgoing>Flow_1rrclqh</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_0wlcssu" name="Подготовка переменных" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_02adx82</bpmn:incoming>
      <bpmn:outgoing>Flow_1t4vyfw</bpmn:outgoing>
      <bpmn:script>def docGuid = S(document)?.prop("data")?.prop("guid")?.stringValue()
execution.setVariable("documentGuid", docGuid)
def title= S(document).prop("data").prop("title").stringValue();
def lastComment = lastTaskComment;

//блок определения кнопок для этапа Бухгалтерия
def actions = "TA015_REWORK,TA39_CORRECT_ZP,TA044_VERIFICATION_PFD,TA043_COMPLETED,TA045_NEED_INFORMATION,TA049_MARK_DOUBLE";

if (!isEDO){
    actions = actions +",TA38_SEND_TO_RESCAN";
}

execution.setVariable('userActions', actions);	
//---

execution.setVariable('messageProperties', [messageTitle: title, packageId: entityGuid, lastTaskComment: lastComment, diadocComment: '', alert: '']);

execution.setVariable('prevState','DS039_EXECUTION');</bpmn:script>
    </bpmn:scriptTask>
