      <bpmn:scriptTask id="Activity_18eqk9q" name="Получен статус" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_14hx042</bpmn:incoming>
        <bpmn:outgoing>Flow_0b1dwuu</bpmn:outgoing>
        <bpmn:script>import java.util.logging.Logger

Logger logger = Logger.getLogger("PFD_DIADOC_LOG_EXPECT")
String signedStatus = signedDocumentInfo
    .prop("data")
    .prop("status")
    .stringValue()
    .trim();
execution.setVariable("signedStatus",signedStatus)
Set&lt;String&gt; excludedStatuses = Set.of(
    "DS054_CANCELED",
    "DS070_REJECTED_PFD",
    "DS071_SIGNED_PFD",
    "DS029_SIGNED",
    "DS005_REJECTED"
);

if (!excludedStatuses.contains(signedStatus)) {
    execution.setVariable("diadocCompleted", false);
}
//установка переменной hasSendingError при получении ошибки подписи
if (signedStatus == "DS076_SENDING_ERROR_PFD") {
    execution.setVariable("hasSendingError", true);
}

//в скрипте "Увеличить таймер и установить переменную" tCount считает количество попаданий в скрипт: через первый час после запуска tCount = 60, 
//так как таймер сначала установлен на каждую минуту
//затем таймер переводится в запуск "каждый час". 
//далее ждем еще 2 дня (пока не дойдем до целевого решения, реализация такая). 108 = 60 минут + 48 часов (2 дня)


if(tCount&gt;=108){
  execution.setVariable("diadocCompleted",true);
}

println "### CALLBACK_DIADOC: signedStatus=" + signedStatus + ", guid документа=" + signedDocumentInfo.prop('data').prop("guid") + ", entityGuid=" + entityGuid + ", diadocCompleted=" + diadocCompleted + ", processId=" + execution.getProcessInstanceId()
logger.info("Получен статус проверки подписи от Диадока: signedStatus=" + signedStatus + ", guid документа=" + signedDocumentInfo.prop('data').prop("guid") + ", entityGuid=" + entityGuid + ", diadocCompleted=" + diadocCompleted + ", processId=" + execution.getProcessInstanceId())</bpmn:script>
      </bpmn:scriptTask>
