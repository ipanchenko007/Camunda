    <bpmn:serviceTask id="Activity_1sc1cj3" name="Запрос атрибутов документа" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
          <camunda:inputParameter name="path">private/documents/{guid}</camunda:inputParameter>
          <camunda:inputParameter name="pathParams">
            <camunda:map>
              <camunda:entry key="guid">${entityGuid}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="resultVarName">document</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:failedJobRetryTimeCycle />
      </bpmn:extensionElements>
