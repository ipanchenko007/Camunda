        <bpmn:scriptTask id="Activity_1id8wjo" name="Обработка атрибутов документов" scriptFormat="groovy">
          <bpmn:incoming>Flow_0mv43pg</bpmn:incoming>
          <bpmn:outgoing>Flow_1f37bfx</bpmn:outgoing>
          <bpmn:script>def log = org.slf4j.LoggerFactory.getLogger("MoveDocDiadoc")
def pid = execution.getProcessInstanceId()

def attributes  = S(packageDocs).prop("data").prop("attributes")
def documentId  = attributes.hasProp("AB369_ENTITY_ID") ? attributes.prop("AB369_ENTITY_ID").stringValue() : null
def messageId   = attributes.hasProp("AB368_MESSAGE_ID") ? attributes.prop("AB368_MESSAGE_ID").stringValue() : null
def currentGuid = diadocDoc  // элементная переменная MI — уже строка

if (!documentId || !messageId) {
    log.warn("[MoveDocDiadoc][{}] Документ guid={} пропущен: AB369_ENTITY_ID='{}', AB368_MESSAGE_ID='{}'",
             pid, currentGuid, documentId, messageId)
    return
}

def docList = execution.getVariable("diadocDocuments") ?: []
docList &lt;&lt; [messageId: messageId, documentId: documentId]
execution.setVariable("diadocDocuments", docList)

log.debug("[MoveDocDiadoc][{}] Документ guid={} добавлен в коллекцию. messageId={}, documentId={}",
          pid, currentGuid, messageId, documentId)</bpmn:script>
