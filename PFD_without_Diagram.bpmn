            <camunda:inputParameter name="pathParams">
              <camunda:map>
                <camunda:entry key="dictionaryCode">LD144_PRIORITY_STATUS</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="queryParams">
              <camunda:map>
                <camunda:entry key="all">false</camunda:entry>
                <camunda:entry key="direction">asc</camunda:entry>
                <camunda:entry key="limit">50</camunda:entry>
