    <bpmn:subProcess id="Activity_0v8bdk9" name="Удаление связей с документом основанием">
      <bpmn:incoming>Flow_0ia87me</bpmn:incoming>
      <bpmn:outgoing>Flow_14b0kzj</bpmn:outgoing>
      <bpmn:startEvent id="Event_1axzakd">
        <bpmn:outgoing>Flow_0ulct3m</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_1ukw36r" name="Запрос связанных документов" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
            <camunda:inputParameter name="path">private/documents/{guid}/relations</camunda:inputParameter>
            <camunda:inputParameter name="pathParams">
              <camunda:map>
                <camunda:entry key="guid">${entityGuid}</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">LinkDocuments</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0ulct3m</bpmn:incoming>
        <bpmn:outgoing>Flow_1s00hbr</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="Activity_0crx2lt" name="Фильтр документов по связи" scriptFormat="groovy">
        <bpmn:incoming>Flow_1s00hbr</bpmn:incoming>
        <bpmn:outgoing>Flow_0putqbd</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonSlurper
import com.fasterxml.jackson.databind.ObjectMapper

def raw = execution.getVariable("LinkDocuments")
def json = new JsonSlurper().parseText(raw.toString())
def relations = json?.data ?: []

def packageDocs = relations
    .findAll { it.relationCode == 'PACKAGE' }
    .collect { [guid: it.targetGuid] }

def baseDocs = relations
    .findAll { it.relationCode == 'BASE_DOCUMENT' }
    .collect { [guid: it.targetGuid] }

def parentBaseDocumentGuids = baseDocs
    .collect { it.guid }
    .findAll { it != null }
    .unique()

def objectMapper = new ObjectMapper()

// JSON-строки для S(...).elements() если где-то ещё используются
execution.setVariable("packageDocuments", objectMapper.writeValueAsString(packageDocs))
execution.setVariable("baseDocuments",    objectMapper.writeValueAsString(baseDocs))

// Java List&lt;Map&gt; — для multi-instance Activity_1vahct4 напрямую
def baseDocsList = new ArrayList()
baseDocs.each { doc -&gt;
    def entry = new java.util.LinkedHashMap()
    entry.put("guid", doc.guid)
    baseDocsList.add(entry)
}
execution.setVariable("baseDocsList", baseDocsList)

execution.setVariable("parentBaseDocumentGuids", parentBaseDocumentGuids)
execution.setVariable("hasPackageDocuments", !packageDocs.isEmpty())
execution.setVariable("hasBaseDocuments", !baseDocs.isEmpty())</bpmn:script>
      </bpmn:scriptTask>
