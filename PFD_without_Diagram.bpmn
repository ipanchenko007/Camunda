    <bpmn:scriptTask id="Activity_179zzvu" name="Определение наименования задачи" scriptFormat="groovy">
      <bpmn:incoming>Flow_029v8dl</bpmn:incoming>
      <bpmn:outgoing>Flow_1wc9j8d</bpmn:outgoing>
      <bpmn:script>// Входные переменные
def purchaseOrderNumber    = execution.getVariable('purchaseOrderNumber')
def taskOutcome = execution.getVariable('taskOutcome')
def document    = execution.getVariable('document')
def createDate  = execution.getVariable('createDate')
// Парсим document
def docSpin = document ? S(document) : null
def data    = docSpin ? docSpin.prop("data") : null
def attributes = data ? data.prop("attributes") : null
// Определяем заголовок документа
def documentTitle = (data &amp;&amp; !data.prop("title").isNull())
        ? data.prop("title").stringValue()
        : "документ"
// Устанавливаем переменные "ИНН" и "Наименование поставщика"
def supplierInn  = ""
def supplierName = ""
if (attributes) {
    if (attributes.hasProp('AB307_SUPPLIER_INN')
            &amp;&amp; !attributes.prop('AB307_SUPPLIER_INN').isNull()) {
        supplierInn = attributes.prop('AB307_SUPPLIER_INN').stringValue()
    }
    if (attributes.hasProp('AB306_SUPPLIER_NAME')
            &amp;&amp; !attributes.prop('AB306_SUPPLIER_NAME').isNull()) {
        supplierName = attributes.prop('AB306_SUPPLIER_NAME').stringValue()
    }
}
// Формирует заголовок задачи
def taskName = "Скорректировать ЗП: ${documentTitle}, от ${createDate}".toString()
if (purchaseOrderNumber == false) {
    taskName = "Создание ЗП по пакету: ИНН ${supplierInn}, от ${supplierName}".toString()
}
execution.setVariable('zpTaskName', taskName)
// Добавляем переменную notificationCode
def notificationCode = "PACKAGE_USER_TASK_CREATED"
if (taskOutcome == 'TA39_CORRECT_ZP') {
    notificationCode = "ZP_CORRECTION"
}
execution.setVariable('notificationCode', notificationCode)
// Логирование
println "=== SUMMARY ==="
println "zpTaskName: '${taskName}'"
println "notificationCode: '${notificationCode}'"
println "purchaseOrderNumber: ${purchaseOrderNumber}"
println "supplierInn: '${supplierInn}'"
println "supplierName: '${supplierName}'"
println "================="</bpmn:script>
    </bpmn:scriptTask>
