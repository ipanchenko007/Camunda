            <camunda:inputParameter name="body">{
  "boxId": "7f4708c6-3f56-4694-b77a-0252424e7544",
  "departmentId": "46a43854-4fd2-49c3-b0bb-9eb942398047",
  "documentIds": ${diadocDocumentsJson}
}</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">responseDiadoc</camunda:inputParameter>
            <camunda:inputParameter name="handleError">true</camunda:inputParameter>
          </camunda:inputOutput>
