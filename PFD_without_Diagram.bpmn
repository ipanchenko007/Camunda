      <bpmn:serviceTask id="Activity_1rxlwda" name="Запрос связанных документов" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
            <camunda:inputParameter name="path">private/documents/{guid}/relations</camunda:inputParameter>
            <camunda:inputParameter name="pathParams">
              <camunda:map>
                <camunda:entry key="guid">${entityGuid}</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">packageRelations</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0ykd5x6</bpmn:incoming>
        <bpmn:outgoing>Flow_0obxa16</bpmn:outgoing>
