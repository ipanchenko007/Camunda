      <bpmn:scriptTask id="Activity_1oh9i14" name="Обработка ответа робота-Создание СФ" scriptFormat="groovy">
        <bpmn:incoming>Flow_1khsirt</bpmn:incoming>
        <bpmn:outgoing>Flow_1czo055</bpmn:outgoing>
        <bpmn:script>def statusRaw = execution.getVariable("RPA_SF_PROCESSING_STATUS")
def comment   = execution.getVariable("RPA_SF_PROCESSING_COMMENT")

// Приводим статус к строке и верхнему регистру (учитываем true/false/null)
def statusStr = statusRaw == null ? null : statusRaw.toString().toUpperCase()

String normalizedStatus

switch (statusStr) {
    case "OK":
        normalizedStatus = "OK"
        break
    case "NOT_APPLICABLE":
        normalizedStatus = "NOT_APPLICABLE"
        break
    case "ERROR":
        normalizedStatus = "ERROR"
        break
    default:
        // Любое другое значение или null считаем ошибкой
        normalizedStatus = "ERROR"
}

execution.setVariable("RPA_SF_STATUS", normalizedStatus)

// Комментарий сохраняем как есть, null допускается
execution.setVariable("RPA_SF_COMMENT", comment)

println "===============LOG=================="
println "### CALLBACK_RPA_SF: rawStatus=${statusRaw}, normalized=${normalizedStatus}, comment=${comment}"
println "===================================="
</bpmn:script>
      </bpmn:scriptTask>
