    <bpmn:scriptTask id="Activity_0ei8s2w" name="Очистка duplicateDocuments при частичном отказе" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_1cwyd7v</bpmn:incoming>
      <bpmn:outgoing>Flow_0ar587h</bpmn:outgoing>
      <bpmn:script>if(execution.hasVariable("duplicateDocuments")){
  def guidsToDelete = sOKdocuments.collect { it['guid'] }

  execution.setVariable("guidsToDelete", guidsToDelete);
  def filteredDuplicateDocuments = duplicateDocuments.findAll { doc -&gt;
    !guidsToDelete.contains(doc.guid)
  }
  execution.setVariable("duplicateDocuments", filteredDuplicateDocuments)
}</bpmn:script>
