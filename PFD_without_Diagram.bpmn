    <bpmn:scriptTask id="Activity_0idlp79" name="Обработка результатов отправки в EDF" scriptFormat="groovy">
      <bpmn:incoming>Flow_02182bq</bpmn:incoming>
      <bpmn:outgoing>Flow_1pob6li</bpmn:outgoing>
      <bpmn:script>// 1. GUID документа
def guid = execution.getVariable('beedocsContainerId')

if (!guid) {
    println '=== EDF_LOG ==='
    println 'ERROR: beedocsContainerId not found, fallback to MISSING_GUID'
    guid = 'MISSING_GUID'
}
execution.setVariable('documentGuid', guid)

// 2. Базовый комментарий (если ничего не пришло)
def edfComment = execution.getVariable('edfComment')

// 3. Комментарий при ошибке отправки в EDF 
if (execution.hasVariable('edfSendSuccess') &amp;&amp; execution.getVariable('edfSendSuccess') == false) {
    def errorText = execution.getVariable('errorText')
    if (errorText) {
        edfComment = errorText
    } else {
        edfComment = 'Ошибка отправки в EDF'
    }
}

// 4. Результат обработки EDF
if (execution.hasVariable('EDF_PROCESSING_SUCCEDDED')) {
    def succeeded = execution.getVariable('EDF_PROCESSING_SUCCEDDED')

    if (succeeded == true) {
        edfComment = 'Пакет документов обработан в EDF'
    } else if (succeeded == false) {
        def processingComment = execution.getVariable('EDF_PROCESSING_COMMENT')
        if (processingComment) {
            edfComment = processingComment
        } else {
            edfComment = 'Ошибка обработки в EDF'
        }
    } else {
        // если EDF прислал переменную, но она == null
        execution.setVariable('EDF_PROCESSING_SUCCEDDED', false)

        println '=== EDF_LOG ==='
        println 'WARN: EDF_PROCESSING_SUCCEDDED is null, set to false for default flow Flow_1c2gj5p'
    }
} else {
    // если EDF не прислал переменную (например, сработал таймаут)
    execution.setVariable('EDF_PROCESSING_SUCCEDDED', false)

    println '=== EDF_LOG ==='
    println 'WARN: EDF_PROCESSING_SUCCEDDED not found, set to false for default flow Flow_1c2gj5p'
}

// 5. Фолбэк, если комментарий так и не был заполнен
if (!edfComment) {
    edfComment = 'Ответ EDF не получен (таймаут или ошибка отправки)'
}
execution.setVariable('edfComment', edfComment)

// 6. Флаг ошибки обработки EDF
boolean edfErrorFlag =
        (execution.hasVariable('EDF_PROCESSING_SUCCEDDED')
                &amp;&amp; execution.getVariable('EDF_PROCESSING_SUCCEDDED') == false) ||
        (execution.hasVariable('edfSendSuccess')
                &amp;&amp; execution.getVariable('edfSendSuccess') == false)

execution.setVariable('edfErrorFlag', edfErrorFlag)

// Логи
println '=== EDF_LOG ==='
println "documentGuid=${guid}"
println "edfSendSuccess=${execution.getVariable('edfSendSuccess')}"
println "EDF_PROCESSING_SUCCEDDED=${execution.getVariable('EDF_PROCESSING_SUCCEDDED')}"
println "edfErrorFlag=${edfErrorFlag}"
println "edfComment=${edfComment}"

//Получение ССФ
if (execution.hasVariable('EDF_PROCESSING_TRANSACTIONS'))
{
def transactions = S(execution.getVariable("EDF_PROCESSING_TRANSACTIONS")).elements()
def ids = transactions.findAll { 
    def type = it.prop("type_transaction").stringValue()
    type == "созданиеССФ" || type == "созданиеПСФ"
}.collect { 
    it.prop("transaction_id").stringValue() 
}.join(",")
execution.setVariable("ssfTransactionIds", ids)
}

//Получение СЗП
import static org.camunda.spin.Spin.JSON

if (execution.hasVariable('EDF_PROCESSING_SZP_LIST')) {
    def json = JSON(execution.getVariable("document"))

    def dataAttrs = json.prop("data").prop("attributes")
    def existingZp = []

    if (dataAttrs.hasProp("ZP")) {
        def zpProp = dataAttrs.prop("ZP")
        if (zpProp != null &amp;&amp; !zpProp.isNull()) {
            existingZp = zpProp.elements().collect { row -&gt;
                ["AB296_PURCHASE_ORDER_NUMBER": row.prop("AB296_PURCHASE_ORDER_NUMBER").stringValue()]
            }
        }
    }

    def szpList = JSON(execution.getVariable("EDF_PROCESSING_SZP_LIST").toString()).elements().collect { it.stringValue() }

    szpList.each { szp -&gt;
        existingZp &lt;&lt; ["AB296_PURCHASE_ORDER_NUMBER": szp]
    }

    def body = ["ZP": existingZp]
    execution.setVariable("szpTableBody", new groovy.json.JsonBuilder(body).toString())
}</bpmn:script>
    </bpmn:scriptTask>
