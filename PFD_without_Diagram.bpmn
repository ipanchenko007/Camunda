    <bpmn:scriptTask id="Activity_1c8cfpb" name="Определить согласующих " camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_1yer4po</bpmn:incoming>
      <bpmn:outgoing>Flow_12frvp6</bpmn:outgoing>
      <bpmn:script>def attributes = S(document).prop("data").prop("attributes")
def isEDO = execution.getVariable("isEDO") as Boolean

if (attributes.hasProp("AB033_APPROVER") &amp;&amp; isEDO) {

  def logins = []

  def approvers = attributes.prop("AB033_APPROVER")

  if (approvers.isArray()) {
    for (def approver : approvers.elements()) {
      if (approver.hasProp("login")) {
        def login = approver.prop("login").stringValue()
        if (login) {
          logins.add(login)
        }
      }
    }
  } else {
    if (approvers.hasProp("login")) {
      def login = approvers.prop("login").stringValue()
      if (login) {
        logins.add(login)
      }
    }
  }

  execution.setVariable("approvers", logins)
}</bpmn:script>
    </bpmn:scriptTask>
