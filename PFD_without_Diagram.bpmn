      <bpmn:subProcess id="Activity_0txy85b" name="Поиск СЗП в НФС и получение номера КЗП">
        <bpmn:incoming>Flow_0n81uhj</bpmn:incoming>
        <bpmn:outgoing>Flow_0erm8zf</bpmn:outgoing>
        <bpmn:outgoing>Flow_1li7kxs</bpmn:outgoing>
