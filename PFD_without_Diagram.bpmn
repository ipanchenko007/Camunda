      <bpmn:script>def isHappyPath = execution.getVariable("isHappyPath") ?: false

String finalComment = ""

if (!isHappyPath) {
    // Ошибка: определяем текст комментария
    if (errorText != null &amp;&amp; errorText.toString().trim().length() &gt; 0) {
        finalComment = "Расчет ДПП. " + errorText.toString().trim()
    } else {
        finalComment = "Не получен ответ от НФС, повторите позднее"
    }
} else {
    // Успех — можно оставить пустым или не создавать комментарий
    finalComment = ""
}

execution.setVariable("NFS_ERROR_COMMENT", finalComment)</bpmn:script>
