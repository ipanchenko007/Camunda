    <bpmn:scriptTask id="Activity_0wmi3by" name="ЛОГ_вызова метода" scriptFormat="groovy">
      <bpmn:incoming>Flow_1uea3b9</bpmn:incoming>
      <bpmn:outgoing>Flow_0foif90</bpmn:outgoing>
      <bpmn:script>println "===============LOG=================="
println "### EDF_DEBUG: before send-to-edf-for-processing, guid=" +
        S(document).prop("data").prop("guid").stringValue()
println "===================================="</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_1ds3s39" name="Передача ID пакета в EDF" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="serviceName">pfd-service</camunda:inputParameter>
          <camunda:inputParameter name="path">private/integration/send-to-edf-for-processing</camunda:inputParameter>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="body">{
  "beedocs_container_id": "${beedocsContainerId}"
}</camunda:inputParameter>
          <camunda:inputParameter name="resultVarName">edfSendResponse</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0foif90</bpmn:incoming>
      <bpmn:outgoing>Flow_0ncq5pq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_1svurjt" name="ЛОГ результат отправки в EDF" scriptFormat="groovy">
      <bpmn:incoming>Flow_0ncq5pq</bpmn:incoming>
      <bpmn:outgoing>Flow_0lcfjiy</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper

def raw = execution.getVariable("edfSendResponse")

def body = raw ? new JsonSlurper().parseText(raw.toString()) : null

// Обрабатываем ответ вызова EDF от ПФД-сервиса  
def success = body?.success == true
def errorText = body?.error ?: ""

// guid документа
def guid = S(document).prop("data").prop("guid").stringValue()

// Устанавливаем переменную результат отправки в EDF
execution.setVariable("edfSendSuccess", success)

// Переменная с текстом ошибки для формирования комментария
// Если success == false, здесь будет текст из поля "error"
execution.setVariable("edfComment", errorText)

if (success) {
    println "============LOG==================="
    println "### EDF_SEND STATUS=ACCEPTED guid=${guid} response=${raw}"
    println "=================================="
} else {
    println "============LOG==================="
    println "### EDF_SEND STATUS=NOT_ACCEPTED guid=${guid} response=${raw}"
    println "=================================="
}

println "### EDF_DEBUG: entered Activity_1svurjt, edfSendResponse=${raw}"</bpmn:script>
    </bpmn:scriptTask>
