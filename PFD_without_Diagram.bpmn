        <bpmn:script>import groovy.json.JsonOutput
println "=========Старт формирования списка документов для перемещения============="  
def log     = org.slf4j.LoggerFactory.getLogger("MoveDocDiadoc")
def pid     = execution.getProcessInstanceId()
def docList = execution.getVariable("diadocDocuments") ?: []

if (docList.isEmpty()) {
    log.warn("[MoveDocDiadoc][{}] Все документы пакета пропущены: атрибуты Диадок отсутствуют у всех документов.",
             pid)
    execution.setVariable("NoDocDiadoc", true)
} else {
    def json = JsonOutput.toJson(docList)
   
log.info("[MoveDocDiadoc][{}] Сформирован список для перемещения. Документов: {}. JSON: {}",
             pid, docList.size(), json)

    execution.setVariable("NoDocDiadoc",         false)
    execution.setVariable("diadocDocumentsJson",  json)
}
println "=========Окончание формирования списка документов для перемещения============="</bpmn:script>
