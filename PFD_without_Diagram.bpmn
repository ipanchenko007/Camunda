    <bpmn:scriptTask id="Activity_1xxkyjg" name="Подготовка документов к подписанию" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_1xg5crl</bpmn:incoming>
      <bpmn:outgoing>Flow_0da9kc8</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import org.camunda.spin.Spin
import org.camunda.spin.json.SpinJsonNode
import java.util.logging.Logger

Logger logger = Logger.getLogger("PFD_DIADOC_LOG")
logger.info ("status change"+" processId: "+execution.getProcessInstanceId());

def docs = sdocuments;
def mappedDocs = docs.collect { item -&gt;
    [
        documentGuid: item.guid, 
        sendType: sType
    ]
}
def sdocsJson = JsonOutput.toJson(mappedDocs)
// Сохраняем в процесс (строкой)
execution.setVariable("diadokdocuments", sdocsJson)

logger.info ("preparedSignature: "+sdocsJson+" processId: "+execution.getProcessInstanceId())


</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_0n7xecj" name="Обработка результата" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_0y625i2</bpmn:incoming>
      <bpmn:outgoing>Flow_1qddgiz</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import java.util.logging.Logger
import com.fasterxml.jackson.databind.ObjectMapper

Logger logger = Logger.getLogger("PFD_DIADOC_LOG")
ObjectMapper objectMapper = new ObjectMapper()

def json = execution.getVariable("diadocRes")
logger.info("docResult: " + json + " processId " + execution.getProcessInstanceId())

def diadocError = false
def messages = []
def sOKdocuments = []
def sRetryDocuments = []
json.elements().each { item -&gt;
    def guid = item.prop("documentGuid").stringValue()
    def message = item.hasProp("message") &amp;&amp; !item.prop("message").isNull() 
    ? item.prop("message").stringValue() 
    : ""

    messages &lt;&lt; "documentGuid=${guid}; message=${message}"
    if (message != "OK") {
        diadocError = true
        //эти документы будем заново отправлять в диадок с доработки
        sRetryDocuments &lt;&lt; [guid: guid]
    } else {
        //если был отказ от подписания, то такие документы надо отвязать от пакета
		sOKdocuments &lt;&lt; [guid: guid]

    }
}

//если пакет закрытый, то в случае ошибки повторно отправять в диадок будем все документы пакета
if(diadocError&amp;&amp;packageIsClosed){
    execution.setVariable("sRetryDocuments",sdocuments);
    execution.setVariable("signedRetryDocuments", objectMapper.writeValueAsString(sdocuments));	
}else{
	execution.setVariable("sRetryDocuments",sRetryDocuments);
	execution.setVariable("signedRetryDocuments", objectMapper.writeValueAsString(sRetryDocuments));
}

execution.setVariable("sOKdocuments",sOKdocuments);
execution.setVariable("signedOKDocuments", objectMapper.writeValueAsString(sOKdocuments));
// Строка, которая пойдёт в комментарий документа 
def diadocStr = diadocRepeat?" (повторная отправка)":"";
def commentText = "Ответ от ЭДО"+diadocStr+": " + messages.join("; ");
execution.setVariable("diadocError", diadocError)
execution.setVariable("diadocComment", commentText.replace("\\", "").replace("\"", ""));

logger.info("prepared diadocComment: " + diadocComment)</bpmn:script>
    </bpmn:scriptTask>
