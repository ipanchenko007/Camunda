        <bpmn:incoming>Flow_02c7uwr</bpmn:incoming>
        <bpmn:outgoing>Flow_00m6aqu</bpmn:outgoing>
        <bpmn:outgoing>Flow_0rvju58</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_00m6aqu" sourceRef="Gateway_1tcog2k" targetRef="Activity_0vaubkq">
