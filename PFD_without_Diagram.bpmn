                <camunda:entry key="guid">${S(signedDocument).prop("guid").stringValue()}</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">signedDocumentInfo</camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:failedJobRetryTimeCycle />
