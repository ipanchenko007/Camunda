      <bpmn:sequenceFlow id="Flow_1lys9gn" sourceRef="Activity_1o7nrhu" targetRef="Activity_0cfkhqp" />
      <bpmn:sequenceFlow id="Flow_0ca2otd" sourceRef="Activity_0cfkhqp" targetRef="Event_0oky5ye" />
    </bpmn:subProcess>
