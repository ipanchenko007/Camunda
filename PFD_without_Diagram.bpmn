        <bpmn:scriptTask id="Activity_05s9esz" name="Сохранение переменных" scriptFormat="groovy">
          <bpmn:incoming>Flow_1qzr65w</bpmn:incoming>
          <bpmn:outgoing>Flow_0ztsqa6</bpmn:outgoing>
          <bpmn:script>import java.util.logging.Logger
import java.util.logging.Level

def log = Logger.getLogger("NfsStatusScript")

// Номер текущей ЗП из multi‑instance
def numberPO = execution.getVariable("NumberPO") as String

log.info("===== Activity_05s9esz: обработка ЗП ${numberPO} =====")
log.info("[NFS] raw response = " + (response != null ? response.toString() : "NULL"))

// Безопасно парсим тело ответа
def body     = S(response).prop("body")
def success  = !body.prop("success").isNull() &amp;&amp; body.prop("success").boolValue()
def payload  = body.prop("payload")

def statusNode     = payload.prop("status")
def closedCodeNode = payload.prop("closed_code")

def apiResultStatus     = statusNode.isNull()     ? null : statusNode.stringValue()
def apiResultClosedCode = closedCodeNode.isNull() ? null : closedCodeNode.stringValue()

log.info("[NFS] success      = ${success}")
log.info("[NFS] status       = ${apiResultStatus}")
log.info("[NFS] closed_code  = ${apiResultClosedCode}")

// --- Установка флагов процесса ---
if (!success) {
    execution.setVariable("hasUnsuccessful", true)
}
if ("REJECTED".equals(apiResultStatus)) {
    execution.setVariable("hasRejected", true)
}
if ("INCOMPLETE".equals(apiResultStatus)) {
    execution.setVariable("hasNotReady", true)
}
if ("FINALLY CLOSED".equals(apiResultClosedCode)) {
    execution.setVariable("hasFinallyClosed", true)
}
if ("REQUIRES REAPPROVAL".equals(apiResultStatus)) {
    execution.setVariable("hasReqReapproval", true)
}
if (!["REJECTED", "APPROVED", "INCOMPLETE", "REQUIRES REAPPROVAL"].contains(apiResultStatus)) {
    execution.setVariable("hasDifferentStatus", true)
}

log.info("===== Activity_05s9esz: завершение для ЗП ${numberPO} =====")</bpmn:script>
        </bpmn:scriptTask>
        <bpmn:endEvent id="Event_0qoh057">
          <bpmn:incoming>Flow_01s7k7v</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:scriptTask id="Activity_0r6nltl" name="Проверка сумм по ЗП" scriptFormat="groovy">
          <bpmn:incoming>Flow_0ztsqa6</bpmn:incoming>
          <bpmn:outgoing>Flow_01s7k7v</bpmn:outgoing>
          <bpmn:script>import java.util.logging.Logger
import java.util.logging.Level

def log = Logger.getLogger("SumCheckScript")

// Номер ЗП текущей итерации multi-instance
def numberPO = execution.getVariable("NumberPO") as String

log.info("===== Проверка сумм ЗП: старт (ЗП ${numberPO}) =====")

// --- 1. Проверка корректировочного пакета ---
def correctionDoc = execution.getVariable("correctionDoc") ?: false
if (correctionDoc) {
    log.info("[SumCheck] correctionDoc=true — проверка суммы пропускается")
    execution.setVariable("hasNullNfsAmounts", false)
    return
}

// --- 2. Проверяем успешность ответа НФС ---
def body
try {
    body = S(response).prop("body")
} catch (Exception e) {
    log.log(Level.WARNING, "[SumCheck] Не удалось прочитать body из response", e)
    execution.setVariable("hasNullNfsAmounts", true)
    return
}

def successNode = body.prop("success")
def apiResultSuccess = !successNode.isNull() &amp;&amp; successNode.boolValue()

if (!apiResultSuccess) {
    log.info("[SumCheck] success=false — проверка суммы пропускается")
    execution.setVariable("hasNullNfsAmounts", false)
    return
}

// --- 3. Читаем суммы из payload текущей ЗП ---
def payload = body.prop("payload")

def readDecimal = { String name -&gt;
    def node = payload.prop(name)
    if (node == null || node.isNull()) {
        log.warning("[SumCheck] В payload поле ${name} = null")
        return null
    }
    try {
        return new BigDecimal(node.toString())
    } catch (Exception e) {
        log.log(Level.WARNING, "[SumCheck] Некорректное значение в поле ${name}: '${node.toString()}'", e)
        return null
    }
}

def totalAmount  = readDecimal("amount")
def billedAmount = readDecimal("amount_billed")
def balanceBD    = readDecimal("amount_balance")

if (totalAmount == null || billedAmount == null || balanceBD == null) {
    log.warning("[SumCheck] В ответе НФС не получены/некорректны суммы: " +
            "amount=${totalAmount}, amount_billed=${billedAmount}, amount_balance=${balanceBD}")
    execution.setVariable("hasNullNfsAmounts", true)
    return
}

execution.setVariable("hasNullNfsAmounts", false)
log.info("[SumCheck] amount=${totalAmount}, amount_billed=${billedAmount}, amount_balance=${balanceBD}")

// --- 4. Ищем в документе ТОЛЬКО текущую ЗП по NumberPO ---
def docSpin
try {
    docSpin = S(execution.getVariable("document"))
} catch (Exception e) {
    log.log(Level.WARNING, "[SumCheck] Не удалось прочитать переменную document", e)
    execution.setVariable("hasNullNfsAmounts", true)
    return
}

def zpElements = docSpin
    .prop("data")
    .prop("attributes")
    .prop("ZP")
    .elements()

// Читаем накопленный список из предыдущих итераций — НЕ создаём новый!
def zpForFix = execution.getVariable("zpForFix")
if (!(zpForFix instanceof Collection)) {
    zpForFix = []
}

def found = false

zpElements.each { el -&gt;
    def poNumber = el.hasProp("AB296_PURCHASE_ORDER_NUMBER") &amp;&amp; !el.prop("AB296_PURCHASE_ORDER_NUMBER").isNull()
        ? (el.prop("AB296_PURCHASE_ORDER_NUMBER").isString()
            ? el.prop("AB296_PURCHASE_ORDER_NUMBER").stringValue()
            : el.prop("AB296_PURCHASE_ORDER_NUMBER").numberValue().toString())
        : "UNKNOWN_PO"

    // Пропускаем все ЗП кроме текущей итерации
    if (poNumber != numberPO) {
        return
    }

    found = true

    def contractType = el.hasProp("AB447_DOC_TYPE_NAME") &amp;&amp; !el.prop("AB447_DOC_TYPE_NAME").isNull()
        ? (el.prop("AB447_DOC_TYPE_NAME").isString()
            ? el.prop("AB447_DOC_TYPE_NAME").stringValue()
            : el.prop("AB447_DOC_TYPE_NAME").numberValue().toString())
        : null

    log.info("[SumCheck] Обработка ЗП ${poNumber}, AB447_DOC_TYPE_NAME=${contractType}")

    if (contractType != "Договор с периодической оплатой") {
        log.info("[SumCheck] ЗП ${poNumber} пропущена: тип договора не подходит")
        return
    }

    def sumNode = el.hasProp("AB419_PURCHASE_ORDER_SUM") &amp;&amp; !el.prop("AB419_PURCHASE_ORDER_SUM").isNull()
        ? (el.prop("AB419_PURCHASE_ORDER_SUM").isString()
            ? el.prop("AB419_PURCHASE_ORDER_SUM").stringValue()
            : el.prop("AB419_PURCHASE_ORDER_SUM").numberValue().toString())
        : null

    if (sumNode == null) {
        log.warning("[SumCheck] ЗП ${poNumber} пропущена: AB419_PURCHASE_ORDER_SUM не заполнен")
        return
    }

    def purchaseOrderSum
    try {
        purchaseOrderSum = new BigDecimal(sumNode.toString())
    } catch (Exception e) {
        log.log(Level.WARNING,
                "[SumCheck] ЗП ${poNumber} пропущена: некорректный формат суммы AB419_PURCHASE_ORDER_SUM='${sumNode}'", e)
        return
    }

    def enoughForCurrent = (purchaseOrderSum.compareTo(balanceBD) &lt;= 0)
    log.info("[SumCheck] ЗП ${poNumber}: сумма по карточке=${purchaseOrderSum}, баланс НФС=${balanceBD}, достаточно баланса=${enoughForCurrent}")

    if (!enoughForCurrent) {
        if (!zpForFix.contains(poNumber)) {
            zpForFix.add(poNumber)
        }
        log.warning("[SumCheck] ПРОБЛЕМНАЯ ЗП: номер=${poNumber}, сумма по карточке=${purchaseOrderSum}, баланс НФС=${balanceBD}")
    }
}

if (!found) {
    log.warning("[SumCheck] ЗП ${numberPO} не найдена в документе — пропускаем")
}

// --- 5. Обновляем накопленный zpForFix ---
execution.setVariable("zpForFix", zpForFix)

log.info("[SumCheck] Накопленный zpForFix = ${zpForFix}")
log.info("===== Проверка сумм ЗП: завершение (ЗП ${numberPO}) =====")</bpmn:script>
        </bpmn:scriptTask>
