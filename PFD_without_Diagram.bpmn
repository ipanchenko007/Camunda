    <bpmn:scriptTask id="Activity_1wzbtb5" name="Извлечение ЦБО из AB328_CBO" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_0h20ibm</bpmn:incoming>
      <bpmn:outgoing>Flow_0t50eos</bpmn:outgoing>
      <bpmn:script>
import static org.camunda.spin.Spin.S

def documentJson = execution.getVariable("document")

if (documentJson == null) {
    throw new RuntimeException("Переменная 'document' не найдена")
}

def cboCodeValue = null

def zpArray = S(documentJson)
        .prop("data")
        .prop("attributes")
        .prop("ZP")

if (zpArray != null &amp;&amp; zpArray.isArray()) {
    for (def item in zpArray.elements()) {
        if (item.hasProp("AB328_CBO") &amp;&amp; !item.prop("AB328_CBO").isNull()) {
            def node = item.prop("AB328_CBO")
            cboCodeValue = node.value()?.toString()?.trim()
            if (cboCodeValue) {
                break
            }
        }
    }
}

execution.setVariable("CBO_CODE", cboCodeValue)
      </bpmn:script>
    </bpmn:scriptTask>
