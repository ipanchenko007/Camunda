    <bpmn:userTask id="Activity_1wq1r4q" name="Скорректировать пакет документов" camunda:asyncBefore="true" camunda:assignee="${initiator}" camunda:dueDate="P30D">
      <bpmn:documentation>${S(document).prop("data").prop("title").stringValue()}</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="actions">TA043_COMPLETED,TA40_DELETE,TA049_MARK_DOUBLE</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:taskListener delegateExpression="#{userTaskNotificationListener}" event="create">
          <camunda:field name="messageCode">
            <camunda:expression>${templateCode}</camunda:expression>
          </camunda:field>
          <camunda:field name="addresseeLogins">
            <camunda:string>initiator</camunda:string>
          </camunda:field>
          <camunda:field name="properties">
            <camunda:expression>${messageProperties}</camunda:expression>
          </camunda:field>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1k0ub15</bpmn:incoming>
      <bpmn:outgoing>Flow_0rz5ve6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_0h4gdi8" name="Подготовка переменных" scriptFormat="groovy">
      <bpmn:incoming>Flow_150c8ap</bpmn:incoming>
      <bpmn:incoming>Flow_1w9s19o</bpmn:incoming>
      <bpmn:outgoing>Flow_1k0ub15</bpmn:outgoing>
      <bpmn:script>import static org.camunda.spin.Spin.JSON

def title= S(document).prop("data").prop("title").stringValue();
def comment = "";
def dComment = "";
def dDocs = [];
def lastComment = lastTaskComment;
def messageCode = "PACKAGE_USER_TASK_CREATED";
def alert = "&lt;p&gt;Работа с пакетом будет завершена автоматически через 30 дней, если данная задача не будет закрыта&lt;/p&gt;";

if(execution.hasVariable("isChanged")&amp;&amp;isChanged){
	alert = alert + "&lt;p color='red'&gt;Во время корректировки был изменен состав документов в закрытом пакете. Состав закрытого пакета менять нельзя&lt;/p&gt;";
        execution.removeVariable("isChanged");
}

if(diadocError){
	dComment = 
		'&lt;p style="color: red"&gt;По части документов не удалось выполнить подписание/отказ от подписания в диадок (см. комментарий в пакете документов). Обратитесь к администратору, затем выполните задачу, чтобы продолжить работу с пакетом&lt;/p&gt;';	
}
//если это частичный отказ
if(taskOutcome == 'TA010_REJECT' &amp;&amp; !fullRejectBool){
	def blocks = sOKdocuments.collect { 
		def link = """&lt;li&gt;&lt;a href="${baseUrl}/document-and-storage/list/user/${it['guid']}/view?tab=base-info"&gt;Документ&lt;/a&gt;&lt;/li&gt;"""
		return link;
	}

	comment =
		'&lt;p style="color: red"&gt;По следующим документам выполнен отказ от подписания:&lt;/p&gt;' +
		"&lt;ul style='list-style-type: none;'&gt;" +
		blocks.join("\n") +
		"&lt;/ul&gt;"
		;
	
	messageCode = "PACKAGE_PROCESSING_PARTIALY_REJECTED";	
	execution.setVariable('messageProperties', [
						messageTitle: title, 
						packageId: entityGuid, 
						lastTaskComment: lastComment, 
						rejectComment: comment,
						diadocComment: dComment,
						alert: alert])			
}else{
	//полный отказ или другое
	execution.setVariable('messageProperties', [
							messageTitle: title, 
							packageId: entityGuid, 
							lastTaskComment: lastComment,
							diadocComment: dComment,
							alert: alert])	
}

execution.setVariable("templateCode", messageCode)
//Для задачи согласования
execution.setVariable("needRework", false)
execution.setVariable("autoClosed", false)</bpmn:script>
    </bpmn:scriptTask>
