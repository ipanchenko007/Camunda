def actions = "TA015_REWORK,TA044_VERIFICATION_PFD,TA37_SEND_FOR_PAYMENT,TA045_NEED_INFORMATION,TA050_CHANGE_DETAILS_PFD";

if (!isEDO)
    actions = actions +",TA38_SEND_TO_RESCAN";

execution.setVariable('userActions', actions);	
//---

execution.setVariable('prevState','CORRECT_ZP');

execution.setVariable('prevRole','RL023_PURCHASES');</bpmn:script>
