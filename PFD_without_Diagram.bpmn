      <bpmn:serviceTask id="Activity_1r99hkr" name="Запрос связанных документов" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
            <camunda:inputParameter name="path">private/documents/{guid}/relations</camunda:inputParameter>
            <camunda:inputParameter name="pathParams">
              <camunda:map>
                <camunda:entry key="guid">${entityGuid}</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">documents</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1keponf</bpmn:incoming>
        <bpmn:outgoing>Flow_1de4b5g</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_1de4b5g" sourceRef="Activity_1r99hkr" targetRef="Activity_09a1yhn" />
      <bpmn:scriptTask id="Activity_09a1yhn" name="Фильтр документов по связи" scriptFormat="groovy">
        <bpmn:incoming>Flow_1de4b5g</bpmn:incoming>
        <bpmn:outgoing>Flow_09blejj</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import org.camunda.spin.Spin
import org.camunda.spin.json.SpinJsonNode
import com.fasterxml.jackson.databind.ObjectMapper

// Преобразуем SpinJsonNode в объект Groovy
def json = new JsonSlurper().parseText(documents.toString())

// Фильтруем только элементы с relationCode == "PACKAGE"
def mappedDocs = json.data.findAll { it.relationCode == "PACKAGE" }.collect { item -&gt;
    [
        guid: item.targetGuid,
    ]
}

ObjectMapper objectMapper = new ObjectMapper()
// Сохраняем в процесс (строкой)
execution.setVariable("pdocuments", mappedDocs)
execution.setVariable("packageDocuments", objectMapper.writeValueAsString(mappedDocs));

mappedDocs = json.data.findAll { it.relationCode == "BASE_DOCUMENT" }.collect { item -&gt;
    [guid: item.targetGuid]
}

execution.setVariable("baseDocuments", mappedDocs)
execution.setVariable("baseDocumentsStr", objectMapper.writeValueAsString(mappedDocs))

/* =========================
   LOGS
   ========================= */

def processInstanceId = execution.getProcessInstanceId()

def pdocumentGuids = (pdocuments ?: []).collect { it.guid }.findAll { it != null }
def baseDocumentGuids = (baseDocuments ?: []).collect { it.guid }.findAll { it != null }

println "=============DOCUMENTS MAPPING RESULT===================="
println "ProcessInstanceId : ${processInstanceId}"
println "pdocuments guids:"
if (pdocumentGuids) {
    pdocumentGuids.each { println "  - ${it}" }
} else {
    println "  [empty]"
}

println "baseDocuments guids:"
if (baseDocumentGuids) {
    baseDocumentGuids.each { println "  - ${it}" }
} else {
    println "  [empty]"
}
println "=================================================="
</bpmn:script>
      </bpmn:scriptTask>
