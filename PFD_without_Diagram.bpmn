      <bpmn:scriptTask id="Activity_1io8b7y" name="Обработка ответа робота-Создание ПСФ" scriptFormat="groovy">
        <bpmn:incoming>Flow_1668d28</bpmn:incoming>
        <bpmn:outgoing>Flow_15l67m7</bpmn:outgoing>
        <bpmn:script>def statusRaw = execution.getVariable("RPA_PSF_PROCESSING_STATUS")
def comment   = execution.getVariable("RPA_PSF_PROCESSING_COMMENT")

// ИСПРАВЛЕНИЕ: Добавляем .trim()
def statusStr = statusRaw != null ? statusRaw.toString().trim().toUpperCase() : null

String normalizedStatus

switch (statusStr) {
    case "OK":
        normalizedStatus = "OK"
        break
    case "NOT_APPLICABLE":
        normalizedStatus = "NOT_APPLICABLE"
        break
    case "ERROR":
        normalizedStatus = "ERROR"
        break
    default:
        // Логика для отладки: если статус не распознан, лучше узнать, что пришло
        if (statusStr != null) {
            println "WARNING: Unknown status for RPA_PSF: '${statusStr}' (raw was: '${statusRaw}')"
        } else {
            println "WARNING: statusRaw was null"
        }
        // Опционально: если хотите считать неизвестные статусы как NOT_APPLICABLE, чтобы не блокировать процесс
        // normalizedStatus = "NOT_APPLICABLE"
        // Но пока оставим ERROR для явных ошибок, как было в оригинале, чтобы не замаскировать новые баги
        normalizedStatus = "ERROR"
}

execution.setVariable("RPA_PSF_STATUS", normalizedStatus)
execution.setVariable("RPA_PSF_COMMENT", comment)

println "===============LOG=================="
println "### CALLBACK_RPA_PSF: rawStatus=${statusRaw}, normalized=${normalizedStatus}, comment=${comment}"
println "===================================="</bpmn:script>
      </bpmn:scriptTask>
