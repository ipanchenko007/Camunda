      <bpmn:incoming>Flow_0v6nhez</bpmn:incoming>
      <bpmn:outgoing>Flow_09ajeh8</bpmn:outgoing>
      <bpmn:script>//первый час проверяем статус каждую минуту, потом каждый час
execution.setVariable("diadocCompleted", true);
tCount = tCount + 1;
if(tCount&lt;60){
  execution.setVariable("tCount", tCount);
}else{ 
  execution.setVariable("tDelay", "PT1H");
}
</bpmn:script>
