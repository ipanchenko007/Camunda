        </bpmn:endEvent>
        <bpmn:startEvent id="Event_0eu9vkv">
          <bpmn:outgoing>Flow_1am7akj</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="Activity_0q8t5ew" name="Удаление связи документов пакета с документом-основанием" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
          <bpmn:extensionElements>
            <camunda:inputOutput>
              <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
              <camunda:inputParameter name="path">private/documents/{guid}/relations/{targetGuid}</camunda:inputParameter>
              <camunda:inputParameter name="method">DELETE</camunda:inputParameter>
            </camunda:inputOutput>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_0uo0w4s</bpmn:incoming>
          <bpmn:outgoing>Flow_1pc61tb</bpmn:outgoing>
          <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${deleteRelationParamsList}" camunda:elementVariable="pathParams" />
        </bpmn:serviceTask>
        <bpmn:serviceTask id="Activity_0vm7v25" name="Запрос связанных документов" camunda:delegateExpression="#{restClient}">
          <bpmn:extensionElements>
            <camunda:inputOutput>
              <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
              <camunda:inputParameter name="path">private/documents/{guid}/relations</camunda:inputParameter>
              <camunda:inputParameter name="pathParams">
                <camunda:map>
                  <camunda:entry key="guid">${document.prop("guid").stringValue()}</camunda:entry>
                </camunda:map>
              </camunda:inputParameter>
              <camunda:inputParameter name="method">GET</camunda:inputParameter>
              <camunda:inputParameter name="resultVarName">LinkDocumentsPFD</camunda:inputParameter>
            </camunda:inputOutput>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1am7akj</bpmn:incoming>
          <bpmn:outgoing>Flow_1xozbte</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:scriptTask id="Activity_134smy5" name="Проверка наличия документов основания" scriptFormat="groovy">
          <bpmn:incoming>Flow_1xozbte</bpmn:incoming>
          <bpmn:outgoing>Flow_0egv2xo</bpmn:outgoing>
          <bpmn:script>import groovy.json.JsonSlurper
import com.fasterxml.jackson.databind.ObjectMapper
import java.util.logging.Logger

Logger logger = Logger.getLogger("DELETE_RELATIONS_SCRIPT")
def pid = execution.getProcessInstanceId()

def raw = execution.getVariable("LinkDocumentsPFD")
if (raw == null) {
    logger.warning("[${pid}] LinkDocumentsPFD пустой — пропускаем")
    execution.setVariable("deleteRelationParamsList", new ArrayList())
    execution.setVariable("noBaseDocs", true)
    return
}

def json = new JsonSlurper().parseText(raw.toString())
def relations = json?.data ?: []

def parentBaseGuids = execution.getVariable("parentBaseDocumentGuids") ?: []
def currentDocGuid = execution.getVariable("document").prop("guid").stringValue()

println "==========Список документов оснований у документов ПФД================="
logger.info("[${pid}] currentDocGuid: ${currentDocGuid}")
logger.info("[${pid}] parentBaseGuids: ${parentBaseGuids}")
logger.info("[${pid}] Коды связей у ПФД: ${relations.collect { it.relationCode }}")
println "======================================================"

def currentBaseGuids = relations
    .findAll { it.relationCode == 'BASE_DOCUMENT' }
    .collect { it.targetGuid }
    .findAll { it != null }
    .unique()

logger.info("[${pid}] BASE_DOCUMENT у ПФД: ${currentBaseGuids}")

def matchedGuids = currentBaseGuids.findAll { parentBaseGuids.contains(it) }
logger.info("[${pid}] Совпавшие GUID: ${matchedGuids}")

// Формируем List&lt;Map&gt; — обычные Java-объекты, НЕ Spin, НЕ JSON-строка
def deleteRelationParamsList = new ArrayList()
matchedGuids.each { tGuid -&gt;
    def entry = new java.util.LinkedHashMap()
    entry.put("guid", currentDocGuid)
    entry.put("targetGuid", tGuid)
    deleteRelationParamsList.add(entry)
}
println "============Список документов для удаления связей===================="
logger.info("[${pid}] deleteRelationParamsList: ${deleteRelationParamsList}")
println "====================================================================="

execution.setVariable("deleteRelationParamsList", deleteRelationParamsList)
execution.setVariable("noBaseDocs", deleteRelationParamsList.isEmpty())</bpmn:script>
        </bpmn:scriptTask>
        <bpmn:exclusiveGateway id="Gateway_1fo3xp8" default="Flow_1cos733">
          <bpmn:incoming>Flow_0egv2xo</bpmn:incoming>
          <bpmn:outgoing>Flow_1cos733</bpmn:outgoing>
          <bpmn:outgoing>Flow_0uo0w4s</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:scriptTask id="Activity_0eco8ba" name="Лог обработки ошибки" scriptFormat="groovy">
