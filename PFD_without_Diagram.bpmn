      <bpmn:scriptTask id="Activity_0d4lp6i" name="Проверка наличия СЗП в документе" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_13zmigk</bpmn:incoming>
        <bpmn:outgoing>Flow_0tw26zc</bpmn:outgoing>
        <bpmn:script>import static org.camunda.spin.Spin.S

def hasAb296 = false
def ab296Value = null

def doc = execution.getVariable("document")

if (doc != null) {
    def attrs = S(doc).prop("data")?.prop("attributes")

    if (attrs != null
            &amp;&amp; attrs.hasProp("ZP")
            &amp;&amp; !attrs.prop("ZP").isNull()
            &amp;&amp; attrs.prop("ZP").isArray()
            &amp;&amp; attrs.prop("ZP").elements().size() &gt; 0) {

        def zpObj = attrs.prop("ZP").elements()[0]

        if (zpObj.hasProp("AB296_PURCHASE_ORDER_NUMBER")
                &amp;&amp; !zpObj.prop("AB296_PURCHASE_ORDER_NUMBER").isNull()) {
            ab296Value = zpObj.prop("AB296_PURCHASE_ORDER_NUMBER").stringValue()
            hasAb296 = ab296Value != null &amp;&amp; !ab296Value.trim().isEmpty()
        }
    }
}

execution.setVariable("hasAb296", hasAb296)
execution.setVariable("ab296Value", ab296Value)</bpmn:script>
      </bpmn:scriptTask>
