    <bpmn:scriptTask id="Activity_118o41w" name="Инициализация переменных проверки ЦБО" scriptFormat="groovy">
      <bpmn:incoming>Flow_0f2jbqz</bpmn:incoming>
      <bpmn:outgoing>Flow_0wzbrfr</bpmn:outgoing>
      <bpmn:script>import java.util.logging.Logger
Logger logger = Logger.getLogger("PFD_CBO_CHECK")

logger.info("[CBO_INIT] Инициализация переменных перед проверкой ЦБО. processId: " +
    execution.getProcessInstanceId())

// Накопительные списки по всем документам-основаниям
execution.setVariable('allCboNames', [])
execution.setVariable('allInitiatorLogins', [])

// Сбрасываем флаг — будет установлен только при выполнении всех условий
execution.setVariable('isNotDefaultSequence', false)
execution.setVariable('signatory', null)
execution.setVariable('cboName', '')
execution.setVariable('initiatorLogin', '')

logger.info("[CBO_INIT] Переменные инициализированы. processId: " +
    execution.getProcessInstanceId())</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0wzbrfr" sourceRef="Activity_118o41w" targetRef="Activity_12zx688" />
    <bpmn:scriptTask id="Activity_12osbr3" name="Определение маршрута" scriptFormat="groovy">
      <bpmn:incoming>Flow_0qa5iwv</bpmn:incoming>
      <bpmn:outgoing>Flow_15vhxil</bpmn:outgoing>
      <bpmn:script>import java.util.logging.Logger

Logger log = Logger.getLogger("PFD_CBO_ROUTE")

//  Константы правил маршрутизации 
final String TARGET_CBO   = "0187"
final String TARGET_LOGIN = "ivashevchenko"

// Читаем накопленные данные из итерационного подпроцесса 
def allCboNames        = (execution.getVariable('allCboNames')        ?: []) as List
def allInitiatorLogins = (execution.getVariable('allInitiatorLogins') ?: []) as List

log.info("[CBO_ROUTE] Накоплено: ЦБО=$allCboNames логины=$allInitiatorLogins" +
    " | pid=${execution.processInstanceId}")

// Вычисляем уникальные значения 
def uniqueCboNames = allCboNames.unique(false)
def uniqueLogins   = allInitiatorLogins.unique(false)

// Проверяем условие нестандартного маршрута 
// Нестандартный маршрут: ровно 1 уникальный ЦБО = "0187"
//                    И ровно 1 уникальный логин = "ivashevchenko"
boolean isNonStandard = (uniqueCboNames  == [TARGET_CBO])   &amp;&amp;
                        (uniqueLogins    == [TARGET_LOGIN])

if (isNonStandard) {
    execution.setVariable('isNotDefaultSequence', true)
    execution.setVariable('signatory', TARGET_LOGIN)
    log.info("[CBO_ROUTE] - Нестандартный маршрут | signatory=$TARGET_LOGIN" +
        " | pid=${execution.processInstanceId}")
} else {
    execution.setVariable('isNotDefaultSequence', false)
    execution.setVariable('signatory', "")

    def reason = defineStandardRouteReason(uniqueCboNames, uniqueLogins, TARGET_CBO, TARGET_LOGIN)
    log.info("[CBO_ROUTE] ❌ Стандартный маршрут | причина: $reason" +
        " | pid=${execution.processInstanceId}")
}

// Диагностические переменные для Cockpit 
execution.setVariable('cboName',       uniqueCboNames.size() == 1 ? uniqueCboNames[0]   : uniqueCboNames.join(', '))
execution.setVariable('initiatorLogin', uniqueLogins.size()  == 1 ? uniqueLogins[0]     : uniqueLogins.join(', '))

//  Вспомогательная функция: причина стандартного маршрута 
def defineStandardRouteReason(List cbos, List logins, String targetCbo, String targetLogin) {
    if (cbos.isEmpty() || logins.isEmpty()) return "данные не собраны (пустые списки)"
    if (cbos.size()   &gt; 1)                  return "несколько уникальных ЦБО: $cbos"
    if (logins.size() &gt; 1)                  return "несколько уникальных логинов: $logins"
    if (cbos[0]   != targetCbo)             return "ЦБО не $targetCbo, получен: ${cbos[0]}"
    if (logins[0] != targetLogin)           return "логин не $targetLogin, получен: ${logins[0]}"
    return "неизвестная причина"
}</bpmn:script>
    </bpmn:scriptTask>
