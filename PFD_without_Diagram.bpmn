    <bpmn:serviceTask id="Activity_0jy6r2f" name="Добавление комментария из ECM" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
          <camunda:inputParameter name="path">private/documents/{documentGuid}/comments</camunda:inputParameter>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="body">{
  "author":null,
