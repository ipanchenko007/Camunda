      <bpmn:scriptTask id="Activity_0wg5v3s" name="Проверка удаления документа из пакета" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_0omi0dx</bpmn:incoming>
        <bpmn:outgoing>Flow_0cyztux</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def oldJson = new JsonSlurper().parseText(JsonOutput.toJson(duplicateDocuments))
//def relationsJson = document.prop("data").prop("relations").toString()
def newJson = new JsonSlurper().parseText(JsonOutput.toJson(documents))

def relationGuids = newJson.collect { it.guid }
execution.setVariable("relationGuids", relationGuids)
def deleteDocs = oldJson
        .collect { [guid: it.guid] }
        .findAll { item -&gt; !relationGuids.contains(item.guid) }

execution.setVariable("deleteDocs", deleteDocs)
</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="Activity_00wh5d4" name="Установка статуса &#34;Дубль&#34;" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
            <camunda:inputParameter name="path">private/documents/{guid}/_status</camunda:inputParameter>
            <camunda:inputParameter name="method">PUT</camunda:inputParameter>
            <camunda:inputParameter name="body">
              <camunda:map>
                <camunda:entry key="statusCode">DS053_DOUBLE</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0cyztux</bpmn:incoming>
        <bpmn:outgoing>Flow_09fkmir</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:asyncBefore="true" camunda:collection="deleteDocs" camunda:elementVariable="pathParams">
          <bpmn:extensionElements>
            <camunda:failedJobRetryTimeCycle />
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="Activity_15n5wqx" name="Очистка duplicateDocuments" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_09fkmir</bpmn:incoming>
        <bpmn:outgoing>Flow_14h9b9f</bpmn:outgoing>
        <bpmn:script>if(execution.hasVariable("duplicateDocuments")){
  def guidsToDelete = deleteDocs*.guid

  def filteredDuplicateDocuments = duplicateDocuments.findAll { doc -&gt;
    !guidsToDelete.contains(doc.guid)
  }
  execution.setVariable("duplicateDocuments", filteredDuplicateDocuments)
}</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:endEvent id="Event_0kb0rre">
        <bpmn:incoming>Flow_14h9b9f</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:scriptTask id="Activity_1j16ixx" name="Фильтр документов по связи" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_04kmflm</bpmn:incoming>
        <bpmn:outgoing>Flow_0omi0dx</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import org.camunda.spin.Spin
import org.camunda.spin.json.SpinJsonNode
import com.fasterxml.jackson.databind.ObjectMapper

// Преобразуем SpinJsonNode в объект Groovy
def json = new JsonSlurper().parseText(documents.toString())

// Фильтруем только элементы с relationCode == "PACKAGE". Запоминаем guid и тип для BEEDOCS-4947
def mappedDocs = json.data.findAll { it.relationCode == "PACKAGE" }.collect { item -&gt;
    [
		guid: item.targetGuid,
		docType: item.targetType
	]
}
// Сохраняем в процесс (строкой)
execution.setVariable("docsWithType", mappedDocs);
//для использования в multi-instance оставим только guid
docs = mappedDocs.collect { item -&gt;
    [
		guid: item.guid
	]
}

execution.setVariable("documents", docs);
//для использования в expanded sub process
ObjectMapper objectMapper = new ObjectMapper();
execution.setVariable("packageDocuments", objectMapper.writeValueAsString(mappedDocs));

mappedDocs = json.data.findAll { it.relationCode == "BASE_DOCUMENT" }.collect { item -&gt;
    [guid: item.targetGuid]
}

execution.setVariable("baseDocuments", mappedDocs)
execution.setVariable("baseDocumentsStr", objectMapper.writeValueAsString(mappedDocs))

</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="Activity_1i5js7r" name="Запрос атрибутов документа" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
            <camunda:inputParameter name="path">private/documents/{guid}</camunda:inputParameter>
            <camunda:inputParameter name="pathParams">
              <camunda:map>
                <camunda:entry key="guid">${entityGuid}</camunda:entry>
