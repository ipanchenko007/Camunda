      <bpmn:scriptTask id="Activity_1dctr32" name="Фильтр документов по связи" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_0ooar8m</bpmn:incoming>
        <bpmn:outgoing>Flow_0lmk101</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import org.camunda.spin.Spin
import org.camunda.spin.json.SpinJsonNode
import com.fasterxml.jackson.databind.ObjectMapper

// Преобразуем SpinJsonNode в объект Groovy
def json = new JsonSlurper().parseText(documents.toString())

// Фильтруем только элементы с relationCode == "PACKAGE"
def mappedDocs = json.data.findAll { it.relationCode == "PACKAGE" }.collect { item -&gt;
    [guid: item.targetGuid]
}

ObjectMapper objectMapper = new ObjectMapper()

// Сохраняем в процесс (строкой)
execution.setVariable("documents", mappedDocs)
execution.setVariable("packageDocuments", objectMapper.writeValueAsString(mappedDocs))


</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:subProcess id="Activity_1vgysxi" name="Проверка документа ПФД на признак KND">
        <bpmn:incoming>Flow_0lmk101</bpmn:incoming>
        <bpmn:outgoing>Flow_11pbi2g</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${S(packageDocuments).elements()}" camunda:elementVariable="packageDoc" />
        <bpmn:startEvent id="Event_0rtg5u9">
          <bpmn:outgoing>Flow_1ffes3s</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="Activity_1kfb2kq" name="Запрос атрибутов документа" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
          <bpmn:extensionElements>
            <camunda:inputOutput>
              <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
              <camunda:inputParameter name="path">private/documents/{guid}</camunda:inputParameter>
              <camunda:inputParameter name="pathParams">
                <camunda:map>
                  <camunda:entry key="guid">${S(packageDoc).prop("guid").stringValue()}</camunda:entry>
                </camunda:map>
              </camunda:inputParameter>
              <camunda:inputParameter name="method">GET</camunda:inputParameter>
              <camunda:inputParameter name="resultVarName">documentPackage</camunda:inputParameter>
            </camunda:inputOutput>
            <camunda:failedJobRetryTimeCycle />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1ffes3s</bpmn:incoming>
          <bpmn:outgoing>Flow_11y2qcj</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:scriptTask id="Activity_0msr1wj" name="Проверка на признак KND" camunda:asyncBefore="true" scriptFormat="groovy">
          <bpmn:incoming>Flow_11y2qcj</bpmn:incoming>
          <bpmn:outgoing>Flow_0i7o77j</bpmn:outgoing>
          <bpmn:script>// текущий документ (SpinJsonNode)
def document = execution.getVariable("documentPackage")

boolean hasKndInCurrentDoc = false

if (document != null &amp;&amp;
    document.hasProp("data") &amp;&amp;
    document.prop("data").hasProp("attributes")) {

    def attributes = document.prop("data").prop("attributes")

    if (attributes.hasProp("AB416_KND")) {
        def kndValue = attributes.prop("AB416_KND")

        // Считаем, что "есть признак KND", только если значение не null
        if (!kndValue.isNull()) {
            hasKndInCurrentDoc = true
        }
    }
}

// Если нашли хотя бы один документ с KND != null
if (hasKndInCurrentDoc) {
    execution.setVariable("KND", true)
}
</bpmn:script>
        </bpmn:scriptTask>
        <bpmn:endEvent id="Event_0n4fucx">
          <bpmn:incoming>Flow_0i7o77j</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_1ffes3s" sourceRef="Event_0rtg5u9" targetRef="Activity_1kfb2kq" />
        <bpmn:sequenceFlow id="Flow_11y2qcj" sourceRef="Activity_1kfb2kq" targetRef="Activity_0msr1wj" />
        <bpmn:sequenceFlow id="Flow_0i7o77j" sourceRef="Activity_0msr1wj" targetRef="Event_0n4fucx" />
      </bpmn:subProcess>
      <bpmn:intermediateThrowEvent id="Event_18t3ka1" name="Статус &#34;Обработка в EDF&#34;">
        <bpmn:incoming>Flow_03mn0i3</bpmn:incoming>
        <bpmn:outgoing>Flow_0vo21cl</bpmn:outgoing>
        <bpmn:escalationEventDefinition id="EscalationEventDefinition_1qqhpbk" escalationRef="Escalation_21rjijn" />
      </bpmn:intermediateThrowEvent>
      <bpmn:scriptTask id="Activity_00f2jsj" name="Подготовка переменных" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_0xh8ln5</bpmn:incoming>
        <bpmn:outgoing>Flow_03mn0i3</bpmn:outgoing>
        <bpmn:script>def docGuid = S(document)?.prop("data")?.prop("guid")?.stringValue()
execution.setVariable("beedocsContainerId", docGuid)

// Счётчик попыток переотправки в EDF
execution.setVariable("edfRetryCount", 0)

</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_0ajyz8x" name="Обработка результатов отправки в EDF" scriptFormat="groovy">
        <bpmn:incoming>Flow_0q2nivi</bpmn:incoming>
        <bpmn:outgoing>Flow_078dzmy</bpmn:outgoing>
        <bpmn:script>// 1. GUID документа
def guid = execution.getVariable('beedocsContainerId')

if (!guid) {
    println '=== EDF_LOG ==='
    println 'ERROR: beedocsContainerId not found, fallback to MISSING_GUID'
    guid = 'MISSING_GUID'
}
execution.setVariable('documentGuid', guid)

// 2. Базовый комментарий (если ничего не пришло)
def edfComment = execution.getVariable('edfComment')

// 3. Комментарий при ошибке отправки в EDF 
if (execution.hasVariable('edfSendSuccess') &amp;&amp; execution.getVariable('edfSendSuccess') == false) {
    def errorText = execution.getVariable('errorText')
    if (errorText) {
        edfComment = errorText
    } else {
        edfComment = 'Ошибка отправки в EDF'
    }
}

// 4. Результат обработки EDF
if (execution.hasVariable('EDF_PROCESSING_SUCCEDDED')) {
    def succeeded = execution.getVariable('EDF_PROCESSING_SUCCEDDED')

    if (succeeded == true) {
        edfComment = 'Пакет документов обработан в EDF'
    } else if (succeeded == false) {
        def processingComment = execution.getVariable('EDF_PROCESSING_COMMENT')
        if (processingComment) {
            edfComment = processingComment
        } else {
            edfComment = 'Ошибка обработки в EDF'
        }
    } else {
        // если EDF прислал переменную, но она == null
        execution.setVariable('EDF_PROCESSING_SUCCEDDED', false)

        println '=== EDF_LOG ==='
        println 'WARN: EDF_PROCESSING_SUCCEDDED is null, set to false for default flow Flow_1c2gj5p'
    }
} else {
    // если EDF не прислал переменную (например, сработал таймаут)
    execution.setVariable('EDF_PROCESSING_SUCCEDDED', false)

    println '=== EDF_LOG ==='
    println 'WARN: EDF_PROCESSING_SUCCEDDED not found, set to false for default flow Flow_1c2gj5p'
}

// 5. Фолбэк, если комментарий так и не был заполнен
if (!edfComment) {
    edfComment = 'Ответ EDF не получен (таймаут или ошибка отправки)'
}
execution.setVariable('edfComment', edfComment)

// 6. Флаг ошибки обработки EDF
boolean edfErrorFlag =
        (execution.hasVariable('EDF_PROCESSING_SUCCEDDED')
                &amp;&amp; execution.getVariable('EDF_PROCESSING_SUCCEDDED') == false) ||
        (execution.hasVariable('edfSendSuccess')
                &amp;&amp; execution.getVariable('edfSendSuccess') == false)

execution.setVariable('edfErrorFlag', edfErrorFlag)

// Логи
println '=== EDF_LOG ==='
println "documentGuid=${guid}"
println "edfSendSuccess=${execution.getVariable('edfSendSuccess')}"
println "EDF_PROCESSING_SUCCEDDED=${execution.getVariable('EDF_PROCESSING_SUCCEDDED')}"
println "edfErrorFlag=${edfErrorFlag}"
println "edfComment=${edfComment}"

//Получение ССФ
if (execution.hasVariable('EDF_PROCESSING_TRANSACTIONS'))
{
def transactions = S(execution.getVariable("EDF_PROCESSING_TRANSACTIONS")).elements()
def ids = transactions.findAll { 
    def type = it.prop("type_transaction").stringValue()
    type == "созданиеССФ" || type == "созданиеПСФ"
}.collect { 
    it.prop("transaction_id").stringValue() 
}.join(",")
execution.setVariable("ssfTransactionIds", ids)
}

//Получение СЗП
import static org.camunda.spin.Spin.JSON

if (execution.hasVariable('EDF_PROCESSING_SZP_LIST')) {
    def json = JSON(execution.getVariable("document"))

    def dataAttrs = json.prop("data").prop("attributes")
    def existingZp = []

    if (dataAttrs.hasProp("ZP")) {
        def zpProp = dataAttrs.prop("ZP")
        if (zpProp != null &amp;&amp; !zpProp.isNull()) {
            existingZp = zpProp.elements().collect { row -&gt;
                def val = row.prop("AB296_PURCHASE_ORDER_NUMBER")
                ["AB296_PURCHASE_ORDER_NUMBER": val.isString() ? val.stringValue() : val.numberValue().toString()]
            }
        }
    }

    def szpList = JSON(execution.getVariable("EDF_PROCESSING_SZP_LIST").toString()).elements().collect { it.stringValue() }

    szpList.each { szp -&gt;
        existingZp &lt;&lt; ["AB296_PURCHASE_ORDER_NUMBER": szp]
    }

    def body = ["ZP": existingZp]
    execution.setVariable("szpTableBody", new groovy.json.JsonBuilder(body).toString())
}</bpmn:script>
