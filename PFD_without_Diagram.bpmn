      <bpmn:scriptTask id="Activity_0n0h1xw" name="Поиск кода приоритета в справочнике" scriptFormat="groovy">
        <bpmn:incoming>Flow_1wnfbnd</bpmn:incoming>
        <bpmn:outgoing>Flow_09pxl5s</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonOutput

def priorityCodeFromDelegate = execution.getVariable("priorityCodeRaw")

def dataArray = S(catalogResponse).prop("data").elements()

def matchedItem = dataArray.find { item -&gt;
    !item.prop("code").isNull() &amp;&amp; item.prop("code").stringValue() == priorityCodeFromDelegate
}

if (matchedItem != null) {
    def code     = matchedItem.prop("code").stringValue()
    def guid     = matchedItem.prop("guid").stringValue()
    def title    = matchedItem.prop("displayTitle").stringValue()
    def priority = matchedItem.prop("PRIORITY_STATUS").stringValue()
    def isParent = matchedItem.prop("isParent").boolValue()

    def map = [
        code            : code,
        guid            : guid,
        PRIORITY_STATUS : priority,
        displayTitle    : title,
        name            : title,
        value           : guid,
        hasChildren     : false,
        isParent        : isParent
    ]

    def priorityObject = map

    execution.setVariable("priorityObject", priorityObject)
    execution.setVariable("priorityResolved", true)
    // Сохраняем текстовое значение для проверки в шлюзе
    execution.setVariable("priorityStatusValue", priority)
} else {
    execution.setVariable("priorityObject", null)
    execution.setVariable("priorityResolved", false)
    execution.setVariable("priorityStatusValue", null)
}</bpmn:script>
      </bpmn:scriptTask>
