    <bpmn:scriptTask id="Activity_0kl5agr" name="Наличие документа-основания" camunda:asyncBefore="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_1wesr5s</bpmn:incoming>
      <bpmn:outgoing>Flow_1u1k3zg</bpmn:outgoing>
      <bpmn:script>// Определяем наличие документа-основания (связь типа BASE_DOCUMENT)
def hasBaseDocument = false

// Получаем данные документа
def doc = S(documents)

def relations = []

// Проверяем наличие data
if (doc.prop("data") != null) {
    def data = doc.prop("data")
    
    // Проверяем, может быть data сама является массивом relations
    if (data.isArray()) {
        relations = data.elements()
    }
}

// Ищем BASE_DOCUMENT в relations
if (relations != null &amp;&amp; !relations.isEmpty()) {
    for (relation in relations) {
        def relationObj = S(relation)
        def relationCode = relationObj.prop("relationCode")?.stringValue()
        
        if (relationCode == "BASE_DOCUMENT") {
            hasBaseDocument = true
            break
        }
    }
}

// Устанавливаем переменную процесса
execution.setVariable("hasBaseDocument", hasBaseDocument)</bpmn:script>
    </bpmn:scriptTask>
