      </bpmn:serviceTask>
      <bpmn:scriptTask id="Activity_0jxflai" name="Формирование списка guid документов" scriptFormat="groovy">
        <bpmn:incoming>Flow_17jjc46</bpmn:incoming>
        <bpmn:outgoing>Flow_1mqppv9</bpmn:outgoing>
        <bpmn:script>println "=========Старт отбора документов для перемещения============="
def log = org.slf4j.LoggerFactory.getLogger("MoveDocDiadoc")
def pid  = execution.getProcessInstanceId()

def packageGuids = S(documents)
    .prop("data")
    .elements()
    .findAll { it.prop("relationCode").stringValue() == "PACKAGE" }
    .collect  { it.prop("targetGuid").stringValue() }

if (packageGuids.isEmpty()) {

    log.warn("[MoveDocDiadoc][{}] Документов с relationCode=PACKAGE не найдено. Пакет: {}",
             pid, execution.getVariable("entityGuid"))

    execution.setVariable("NoPackageType", true)
} else {

log.info("[MoveDocDiadoc][{}] Найдено документов с типом PACKAGE: {}. Guid-ы: {}",
             pid, packageGuids.size(), packageGuids)
    execution.setVariable("NoPackageType",  false)
    execution.setVariable("diadocDocGuid",  packageGuids)
}
println "=========Окончание отбора документов для перемещения============="</bpmn:script>
