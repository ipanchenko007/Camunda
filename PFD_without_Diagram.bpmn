    <bpmn:scriptTask id="Activity_0n88wuh" name="Обработка ответа роботов" scriptFormat="groovy">
      <bpmn:incoming>Flow_058z8du</bpmn:incoming>
      <bpmn:outgoing>Flow_1ct4y6w</bpmn:outgoing>
      <bpmn:script>// Список имен роботов
def rpaNames = ["RPA_SF", "RPA_VAT", "RPA_SN_AN", "RPA_PSF"]

// Нормализуем статусы: null -&gt; NOT_APPLICABLE
def statuses = rpaNames.collect { name -&gt;
    def raw = execution.getVariable("${name}_STATUS")
    raw != null ? raw.toString().toUpperCase() : "NOT_APPLICABLE"
}

def comments = rpaNames.collect { name -&gt;
    execution.getVariable("${name}_COMMENT")?.toString()
}

String sf  = statuses[0]  // RPA_SF
String vat = statuses[1]  // RPA_VAT
String sn  = statuses[2]  // RPA_SN_AN
String psf = statuses[3]  // RPA_PSF

final String NA = "NOT_APPLICABLE"
final String OK = "OK"
final String ER = "ERROR"
final String TO = "TIMEOUT"

// ============================================================
// Обрабатываем статусы от роботов
// ============================================================

// Паттерны для автоматической архивации
def archivePatterns = [
    // 1. SF=OK, остальные NA/TO
    [ sf: [OK],      vat: [NA, TO], sn: [NA, TO], psf: [NA, TO] ],
    
    // 2. VAT=OK, остальные NA/TO
    [ sf: [NA, TO],  vat: [OK],     sn: [NA, TO], psf: [NA, TO] ],
    
    // 3. VAT=OK, SN=OK, остальные NA/TO
    [ sf: [NA, TO],  vat: [OK], sn: [OK], psf: [NA, TO] ],
    
    // 4. SN=OK, остальные NA/TO
    [ sf: [NA, TO],  vat: [NA, TO], sn: [OK], psf: [NA, TO] ],
    
    // 5. PSF=OK, остальные NA/TO
    [ sf: [NA, TO],  vat: [NA, TO], sn: [NA, TO], psf: [OK] ],
    
    // 6. SF=OK, VAT=ERROR, остальные NA/TO
    [ sf: [OK],  vat: [ER],     sn: [NA, TO], psf: [NA, TO] ],
    
    // 7. SF=ERROR, VAT=OK, остальные NA/TO
    [ sf: [ER],      vat: [OK],     sn: [NA, TO], psf: [NA, TO] ],
    
    // 8. SF=OK, VAT=ERROR, SN=ERROR, остальные NA/TO
    [ sf: [OK],      vat: [ER],     sn: [ER], psf: [NA, TO] ]
]

// Проверяем, попадает ли текущий набор статусов в одну из архивных схем
// Обратите внимание: теперь проверка включает и psf (строка ниже была изменена)
boolean isArchive = archivePatterns.any { p -&gt;
    p.sf.contains(sf) &amp;&amp; p.vat.contains(vat) &amp;&amp; p.sn.contains(sn) &amp;&amp; p.psf.contains(psf)
}

execution.setVariable("RPA_PROCESSING_SUCCEEDED", isArchive)

// ============================================================
// Формируем комментарий для Activity_06q5qio
// ============================================================

def robotStatusParts = rpaNames.withIndex().collect { name, i -&gt;
    def st = statuses[i]
    def comment = comments[i]

    def part = "[${name}]: Статус=${st}"
    if (comment != null &amp;&amp; comment.trim()) {
        part += ", Комментарий=${comment}"
    }
    return part
}

String aggregatedComment

if (isArchive) {
    aggregatedComment = "Пакет документов обработан роботами. " + robotStatusParts.join(" | ")
} else {
    aggregatedComment = robotStatusParts.join(" | ")
}

execution.setVariable("RPA_PROCESSING_COMMENT", aggregatedComment)
execution.setVariable("AB999_SUCCESS_RPA", isArchive)

println "=============== LOG ================"
println "### RPA STATUSES : " + rpaNames.withIndex()
        .collect { name, i -&gt; "${name}=${statuses[i]}" }
        .join(", ")
println "### SUCCEEDED     : ${isArchive}"
println "### COMMENT       : ${aggregatedComment}"
println "===================================="</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_1243qpc" name="Добавление комментария" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
          <camunda:inputParameter name="path">private/documents/{documentGuid}/comments</camunda:inputParameter>
