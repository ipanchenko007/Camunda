      </bpmn:scriptTask>
      <bpmn:serviceTask id="Activity_0nwz0vs" name="Запрос к делегату для перерасчета" camunda:asyncBefore="true" camunda:delegateExpression="${delegateRetrieveData}">
        <bpmn:documentation>BEEDOCS-5177</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="NumberPO">${entityGuid}</camunda:inputParameter>
            <camunda:inputParameter name="priorityRecalculation">${priorityRecalculation}</camunda:inputParameter>
            <camunda:inputParameter name="dpp">${dpp}</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0kontqb</bpmn:incoming>
        <bpmn:outgoing>Flow_1azj3zp</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="Activity_1o7aoal" name="Заменить значение" scriptFormat="groovy">
        <bpmn:incoming>Flow_1azj3zp</bpmn:incoming>
        <bpmn:outgoing>Flow_0858lt1</bpmn:outgoing>
        <bpmn:script>import groovy.json.JsonOutput

// 1. Получить priorityStatus из ответа делегата (как в старом скрипте)
def priorityCodeRaw = S(response).prop("priorityStatus").isNull() ? null : S(response).prop("priorityStatus").stringValue()?.trim()

// 2. Маппинг кодов в названия (как было)
def priorityMap = [
    "urgent_queue_2": "Срочная очередь 2",
    "urgent_queue_1": "Срочная очередь 1",
    "not_urgent_queue": "Не срочная очередь",
    "no_processing_required": "Не требует обработки",
    "vat_refund": "Возмещение НДС"
]

// 3. Обработка кода и установка базовых переменных (priority, priorityResolved, priorityCodeRaw)
if (priorityCodeRaw == null || priorityCodeRaw.isEmpty()) {
    execution.setVariable("priority", null)
    execution.setVariable("priorityResolved", false)
    execution.setVariable("priorityCodeRaw", null)
    // Обнуляем итоговые переменные, так как код не распознан
    execution.setVariable("priorityObject", null)
    execution.setVariable("priorityStatusValue", null)
    return  // дальше не идём
} else {
    def priorityName = priorityMap[priorityCodeRaw]
    if (priorityName) {
        execution.setVariable("priority", priorityName)
        execution.setVariable("priorityResolved", true)
        execution.setVariable("priorityCodeRaw", priorityCodeRaw)
    } else {
        // Код есть, но не найден в маппинге — сбрасываем
        execution.setVariable("priority", null)
        execution.setVariable("priorityResolved", false)
        execution.setVariable("priorityCodeRaw", priorityCodeRaw)  // сохраняем неизвестный код для отладки
        execution.setVariable("priorityObject", null)
        execution.setVariable("priorityStatusValue", null)
        return
    }
}

// 4. Поиск в справочнике (аналог второго скрипта) — формирование priorityObject и priorityStatusValue
def dataArray = S(catalogResponse).prop("data").elements()
def matchedItem = dataArray.find { item -&gt;
    !item.prop("code").isNull() &amp;&amp; item.prop("code").stringValue() == priorityCodeRaw
}

if (matchedItem != null) {
    def code     = matchedItem.prop("code").stringValue()
    def guid     = matchedItem.prop("guid").stringValue()
    def title    = matchedItem.prop("displayTitle").stringValue()
    def priority = matchedItem.prop("PRIORITY_STATUS").stringValue()
    def isParent = matchedItem.prop("isParent").boolValue()

    def priorityObject = [
        code            : code,
        guid            : guid,
        PRIORITY_STATUS : priority,
        displayTitle    : title,
        name            : title,
        value           : guid,
        hasChildren     : false,
        isParent        : isParent
    ]

    execution.setVariable("priorityObject", priorityObject)
    execution.setVariable("priorityStatusValue", priority)  // для шлюзов
    // priority и priorityResolved уже установлены выше, оставляем как есть
} else {
    // Не нашли в справочнике — сбрасываем
    execution.setVariable("priorityObject", null)
    execution.setVariable("priorityStatusValue", null)
    execution.setVariable("priorityResolved", false)
    execution.setVariable("priority", null)
}</bpmn:script>
      </bpmn:scriptTask>
