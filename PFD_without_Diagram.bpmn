        <bpmn:incoming>Flow_1rwf32q</bpmn:incoming>
        <bpmn:outgoing>Flow_17i4r3b</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${sdocuments}" camunda:elementVariable="currentDocument" />
        <bpmn:startEvent id="Event_0205usw">
          <bpmn:outgoing>Flow_0tcip11</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:scriptTask id="Activity_0kq311v" name="Фильтр вложений AT025" scriptFormat="groovy">
          <bpmn:incoming>Flow_0tcip11</bpmn:incoming>
          <bpmn:outgoing>Flow_0d5uyyq</bpmn:outgoing>
          <bpmn:script>import groovy.json.JsonSlurper

def docGuid = (currentDocument as Map)["guid"] ?: ""
def docVar = execution.getVariable("linkedDocument")
def json = new JsonSlurper()
def docMap
if (docVar instanceof Map) {
    docMap = docVar
} else {
    docMap = json.parseText(docVar.toString())
}
def dataMap = docMap?.get("data") as Map
def attachments = dataMap?.get("attachments") as List

def deleteParams = new ArrayList()
if (attachments != null) {
    attachments.each { att -&gt;
        def attType = att["attachmentType"] ?: ""
        if (attType == "AT025_RECIPIENT_TITLE_ATTACHMENT_XML") {
            def contentGuid = att["contentGuid"] ?: ""
            if (contentGuid) {
                def entry = new java.util.LinkedHashMap()
                entry.put("guid", docGuid)
                entry.put("attachmentGuid", contentGuid)
                deleteParams.add(entry)
            }
        }
    }
}

execution.setVariable("hasAT025", !deleteParams.isEmpty())
execution.setVariable("deleteAttachmentParamsList", deleteParams)</bpmn:script>
        </bpmn:scriptTask>
