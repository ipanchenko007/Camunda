      <bpmn:serviceTask id="Activity_0zbtkv1" name="Запрос данных по связанному документу в пакете" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
