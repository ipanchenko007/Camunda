              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">packDocument</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1cb3ggd</bpmn:incoming>
        <bpmn:outgoing>Flow_1k9ujkm</bpmn:outgoing>
