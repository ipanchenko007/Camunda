      <bpmn:scriptTask id="Activity_15ns8n0" name="Получение номера КЗП из ответа API" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_0gcds2f</bpmn:incoming>
        <bpmn:outgoing>Flow_10sbk79</bpmn:outgoing>
        <bpmn:script>def contractNumValue = null

if (execution.hasVariable("NFSrequest") &amp;&amp; NFSrequest != null) {

    def contractNum = S(NFSrequest).prop("po_info")

    if (contractNum != null &amp;&amp; contractNum.isArray()) {
        for (def item in contractNum.elements()) {
            if (item.hasProp("contract_num") &amp;&amp; !item.prop("contract_num").isNull()) {
                contractNumValue = item.prop("contract_num").value().toString()
                break
            }
        }
    }
}

execution.setVariable(
    "contractNumValue",contractNumValue
)

import static org.camunda.spin.Spin.JSON

def json = JSON(execution.getVariable("document"))

def poNumber = execution.getVariable("poNumber")?.toString()
def NFSRequestID = execution.getVariable("NFSRequestID")?.toString()

def zpArray = json
        .prop("data")
        .prop("attributes")
        .prop("ZP")

    zpArray.elements().each { zp -&gt;

        if (zp.hasProp("AB296_PURCHASE_ORDER_NUMBER")) {

            def poNode = zp.prop("AB296_PURCHASE_ORDER_NUMBER")
            def currentPo = null

            if (poNode != null &amp;&amp; !poNode.isNull()) {
                currentPo = String.valueOf(poNode.unwrap()).replaceAll('^"|"$', '').trim()
            }

            def poNumberStr = poNumber?.trim()

execution.setVariable("currentPo", currentPo)
execution.setVariable("poNumberStr", poNumberStr)

if (currentPo != null &amp;&amp; currentPo == poNumberStr &amp;&amp; contractNumValue) {
    zp.prop("AB357_PURCHASE_CONTRACT_NUMBER", contractNumValue)
}
        }
    }

def zpBody = '{ "ZP": ' + zpArray.toString() + ' }'

execution.setVariable("documentZP", zpBody)</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_0lhgcb7" name="Наличие документа-основания" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_10sbk79</bpmn:incoming>
        <bpmn:outgoing>Flow_0dztr3j</bpmn:outgoing>
        <bpmn:script>def hasBaseDocument = false
def baseDocumentGuid = null
def baseDocumentRelationGuid = null

def doc = S(documents)

def relations = []

if (doc.prop("data") != null) {
    def data = doc.prop("data")
    if (data.isArray()) {
        relations = data.elements()
    }
}

if (relations != null &amp;&amp; !relations.isEmpty()) {
    for (relation in relations) {
        def relationObj = S(relation)
        def relationCode = relationObj.prop("relationCode")?.stringValue()

        if (relationCode == "BASE_DOCUMENT") {
            hasBaseDocument = true
            baseDocumentGuid = relationObj.prop("targetGuid")?.stringValue()
            baseDocumentRelationGuid = relationObj.prop("guid")?.stringValue()
            break
        }
    }
}

execution.setVariable("hasBaseDocument", hasBaseDocument)
execution.setVariable("baseDocumentGuid", baseDocumentGuid)
execution.setVariable("baseDocumentRelationGuid", baseDocumentRelationGuid)
</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="Activity_0vzi4m3" name="Запрос атрибутов документа основания" camunda:asyncBefore="true" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
            <camunda:inputParameter name="path">private/documents/{guid}</camunda:inputParameter>
            <camunda:inputParameter name="pathParams">
              <camunda:map>
                <camunda:entry key="guid">${baseDocumentGuid}</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">baseDocument</camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:failedJobRetryTimeCycle />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_17z8kd3</bpmn:incoming>
        <bpmn:outgoing>Flow_1ovexi9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="Activity_0mjwrx9" name="Получение КЗП из документа-основания и сравнение" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>Flow_1ovexi9</bpmn:incoming>
        <bpmn:outgoing>Flow_1vxp0ku</bpmn:outgoing>
        <bpmn:script>def contractNumber = null

if (baseDocument != null) {
    def attrs = S(baseDocument).prop("data")?.prop("attributes")
    if (attrs != null &amp;&amp; attrs.hasProp("AB357_PURCHASE_CONTRACT_NUMBER")
            &amp;&amp; !attrs.prop("AB357_PURCHASE_CONTRACT_NUMBER").isNull()) {
        contractNumber = attrs.prop("AB357_PURCHASE_CONTRACT_NUMBER").stringValue()
    }
}

execution.setVariable("purchaseContractNumber", contractNumber)

def contractNumValue = execution.getVariable("contractNumValue")
def contractNumbersMatch = false

if (contractNumber != null &amp;&amp; contractNumValue != null) {
    contractNumbersMatch = contractNumber.trim().equalsIgnoreCase(
        contractNumValue.toString().trim())
}

execution.setVariable("contractNumbersMatch", contractNumbersMatch)</bpmn:script>
      </bpmn:scriptTask>
