<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di_1="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi_1="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://omg.org" xmlns:xsi="http://w3.org" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1il8meu" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:error id="Error_Reject" name="ProcessRejectedError" errorCode="PROCESS_REJECTED" />
  <bpmn:error id="Error_Revision" name="ProcessRevisionError" errorCode="PROCESS_REVISION" />
  <bpmn:process id="PIB0600_STEP_EXECUTION" name="0600 Исполнение шага" isExecutable="true" camunda:historyTimeToLive="365">
    <bpmn:exclusiveGateway id="Gateway_StepType" name="Какой тип шага?" default="Flow_ToSingle">
      <bpmn:incoming>Flow_0liufkh</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSingle</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToParallel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Parallel" name="${currentStep.name} (Параллельно)" camunda:assignee="${assigneeLoop}" camunda:dueDate="#{extensions.timeService.addCalendarDaysTillEndOfDay(currentStep.working_days)}">
      <bpmn:documentation>${S(baseDocument).prop("data").prop("typeTitle").stringValue()} № ${S(baseDocument).prop("data").prop("projectNumber").stringValue()}</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="disableDefaultNotifications">${true}</camunda:inputParameter>
          <camunda:inputParameter name="actions">${currentStep.actions}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">//Смотрим пример формирования в процессе "Отправка уведомлений задачи пользователя" (UserTaskNotificationDelegateProcess)
execution.setVariable('messageProperties', [commentText: 'Назначена параллельная Задача'])</camunda:script>
        </camunda:executionListener>
        <camunda:taskListener delegateExpression="#{userTaskNotificationListener}" event="create" id="notificationListener">
          <camunda:field name="messageCode">
            <camunda:string>NTB0600_TASK_ASSIGNED</camunda:string>
          </camunda:field>
          <camunda:field name="properties">
            <camunda:expression>${messageProperties}</camunda:expression>
          </camunda:field>
        </camunda:taskListener>
        <camunda:taskListener event="complete">
          <camunda:script scriptFormat="groovy">/* Для передачи значения taskOutcome в Родительский процесс */
def currentVal = task.getVariable("taskOutcome")
if (currentVal == "TAB0600_REVISE" || currentVal == "TAB0600_DECLINE") {
    // Принудительно поднимаем значение на уровень инстанса дочернего процесса
    task.getExecution().setVariable("taskOutcome", currentVal)
}</camunda:script>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToParallel</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:collection="parallelAssigneesList" camunda:elementVariable="assigneeLoop">
        <bpmn:completionCondition xsi_1:type="bpmn:tFormalExpression">${taskOutcome == 'TAB0600_REVISE' or taskOutcome == 'TAB0600_DECLINE'}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_0vodv9m</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SubEnd" name="Конец шага">
      <bpmn:incoming>Flow_0vodv9m</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="prepareCurrentStage" name="Подготовка текущего этапа">
      <bpmn:incoming>Flow_0brv6y3</bpmn:incoming>
      <bpmn:outgoing>Flow_0liufkh</bpmn:outgoing>
      <bpmn:serviceTask id="setupStatus" name="Установка статуса" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
            <camunda:inputParameter name="path">/private/documents/{guid}/_status</camunda:inputParameter>
            <camunda:inputParameter name="pathParams">
              <camunda:map>
                <camunda:entry key="guid">${entityGuid}</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">PUT</camunda:inputParameter>
            <camunda:inputParameter name="resultVarName">putStatusResponse</camunda:inputParameter>
            <camunda:inputParameter name="body">
              <camunda:map>
                <camunda:entry key="statusCode">${'DSB0600_'.concat(currentStep.code)}</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:executionListener event="start">
            <camunda:script scriptFormat="groovy">def log = org.slf4j.LoggerFactory.getLogger("prepareCurrentStage -&gt; setupStatus")
def step = execution.getVariable("currentStep")
//log.info("PROCESS [{}] -&gt; ОТПРАВКА PUT ЗАПРОСА. Ожидаемый статус: [DSB0600_{}]", execution.getProcessInstanceId(), step?.code)    </camunda:script>
          </camunda:executionListener>
          <camunda:executionListener event="end">
            <camunda:script scriptFormat="groovy">def log = org.slf4j.LoggerFactory.getLogger("prepareCurrentStage -&gt; setupStatus")
def processInstanceId = execution.getProcessInstanceId()

// Читаем из новой изолированной переменной
def apiResponse = execution.getVariable("putStatusResponse")
        
//log.info("PROCESS [{}] -&gt; ИСТИННЫЙ ОТВЕТ СЕРВЕРА СИМФОНИИ НА СМЕНУ СТАТУСА: {}", processInstanceId, apiResponse)       </camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1rlyn4f</bpmn:incoming>
        <bpmn:outgoing>Flow_141pagw</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:startEvent id="Event_1k7p0h1">
        <bpmn:outgoing>Flow_1rlyn4f</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_1pxm5fq">
        <bpmn:incoming>Flow_17hqhe0</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="Activity_0qf55af" name="Обновление документа (attributes)" camunda:delegateExpression="#{restClient}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="serviceName">documents</camunda:inputParameter>
            <camunda:inputParameter name="path">private/documents/{guid}/_attributes</camunda:inputParameter>
            <camunda:inputParameter name="method">PUT</camunda:inputParameter>
            <camunda:inputParameter name="pathParams">
              <camunda:map>
                <camunda:entry key="guid">${entityGuid}</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="body">${stepFormMap}</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0au9w22</bpmn:incoming>
        <bpmn:outgoing>Flow_17hqhe0</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="Activity_0uznoc9" name="Create StepFormMap" scriptFormat="groovy">
        <bpmn:incoming>Flow_141pagw</bpmn:incoming>
        <bpmn:outgoing>Flow_0au9w22</bpmn:outgoing>
        <bpmn:script>// JsonBuilder - для преобразования объектов Groovy (Map, List, POGO) в строку формата JSON
import groovy.json.JsonBuilder
def log = org.slf4j.LoggerFactory.getLogger("prepareCurrentStage -&gt; Create StepFormMap")
def processInstanceId = execution.getProcessInstanceId()

def step = execution.getVariable("currentStep")

// Безопасно извлекаем и приводим свойства к java.lang.String
def currentCode = step?.code?.toString() ?: ""
def currentName = step?.name?.toString() ?: ""

// Напрямую забираем готовый массив Java из контекста процесса
def rawInitialList = execution.getVariable("INITIAL_EXECUTION_LIST") ?: []

// Используем конструктор JsonBuilder для создания валидной JSON-строки
def stepFormJson = new JsonBuilder([
    "ABB0600_STAGE_CODE": currentCode
   ,"ABB0600_STAGE_NAME": currentName
   ,"INITIAL_EXECUTION_LIST": rawInitialList // Передаем напрямую как объект Java-List
]).toString()

// Сохраняем в переменную процесса
execution.setVariable("stepFormMap", stepFormJson)

//Нельзя изменять значение taskOutcome !!!
//execution.setVariable("taskOutcome", "NONE")
</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_1rlyn4f" sourceRef="Event_1k7p0h1" targetRef="setupStatus" />
      <bpmn:sequenceFlow id="Flow_141pagw" sourceRef="setupStatus" targetRef="Activity_0uznoc9" />
      <bpmn:sequenceFlow id="Flow_17hqhe0" sourceRef="Activity_0qf55af" targetRef="Event_1pxm5fq" />
      <bpmn:sequenceFlow id="Flow_0au9w22" sourceRef="Activity_0uznoc9" targetRef="Activity_0qf55af" />
    </bpmn:subProcess>
    <bpmn:userTask id="Task_SingleOrGroup" name="${currentStep.name}" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:dueDate="#{extensions.timeService.addCalendarDaysTillEndOfDay(currentStep.working_days)}">
      <bpmn:documentation>${S(baseDocument).prop("data").prop("typeTitle").stringValue()} № ${S(baseDocument).prop("data").prop("projectNumber").stringValue()}</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:taskListener event="create">
          <camunda:script scriptFormat="groovy">// В Task Listener объект контекста процесса извлекается через task.getExecution()
def ctx = task.getExecution()
def step = ctx.getVariable("currentStep")

if (step != null &amp;&amp; step.actions != null) {
    // Безопасно пишем переменную в локальный контекст самой задачи
    task.setVariableLocal("actions", step.actions.toString())
    
    // Если Симфония требует дублирования в локальный контекст исполнения:
    ctx.setVariableLocal("actions", step.actions.toString())
}
</camunda:script>
        </camunda:taskListener>
        <camunda:inputOutput>
          <camunda:inputParameter name="disableDefaultNotifications">${true}</camunda:inputParameter>
          <camunda:inputParameter name="actions">${currentStep.actions}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">//Смотрим пример формирования в процессе "Отправка уведомлений задачи пользователя" (UserTaskNotificationDelegateProcess)
execution.setVariable('messageProperties', [commentText: 'Назначена персональная Задача'])</camunda:script>
        </camunda:executionListener>
        <camunda:taskListener event="create">
          <camunda:script scriptFormat="groovy">// Извлекаем текущий шаг из контекста выполнения
def step = task.getExecution().getVariable("currentStep")

if (step != null) {
    // 1. Персональное назначение
    if (step.assignee != null &amp;&amp; step.assignee != "") {
        task.setAssignee(step.assignee.toString())
    }
    
    // 2. Группы кандидатов (Роли)
    if (step.candidateGroup != null &amp;&amp; step.candidateGroup != "") {
        // Метод принимает коллекцию строк
        def groups = step.candidateGroup.toString().split(",").collect { it.trim() }
        task.addCandidateGroups(groups)
    }
    
    // 3. Пользователи-кандидаты
    if (step.candidateUsers != null &amp;&amp; step.candidateUsers != "") {
        // Метод принимает коллекцию строк
        def users = step.candidateUsers.toString().split(",").collect { it.trim() }
        task.addCandidateUsers(users)
    }
}
</camunda:script>
        </camunda:taskListener>
        <camunda:taskListener delegateExpression="#{userTaskNotificationListener}" event="create" id="notificationListener">
          <camunda:field name="messageCode">
            <camunda:string>NTB0600_TASK_ASSIGNED</camunda:string>
          </camunda:field>
          <camunda:field name="properties">
            <camunda:expression>${messageProperties}</camunda:expression>
          </camunda:field>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSingle</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0liufkh" sourceRef="prepareCurrentStage" targetRef="Gateway_StepType" />
    <bpmn:sequenceFlow id="Flow_ToSingle" name="Flow to Single" sourceRef="Gateway_StepType" targetRef="Task_SingleOrGroup" />
    <bpmn:sequenceFlow id="Flow_ToParallel" name="Flow to Parallel (Take)" sourceRef="Gateway_StepType" targetRef="Task_Parallel">
      <bpmn:extensionElements>
        <camunda:executionListener event="take">
          <camunda:script scriptFormat="groovy">// Получаем текущий шаг подпроцесса
def step = execution.getVariable("currentStep")
def cleanCollection = new java.util.ArrayList()

if (step != null &amp;&amp; step.parallelAssignees != null) {
    // Безопасно извлекаем элементы, независимо от того, SPIN это или массив
    def rawList = step.parallelAssignees
    
    if (rawList instanceof org.camunda.spin.json.SpinJsonNode) {
        cleanCollection = rawList.mapTo(java.util.List.class)
    } else {
        rawList.each { item -&gt; 
            if (item != null &amp;&amp; item.toString() != "") {
                cleanCollection.add(item.toString())
            }
        }
    }
}

// Записываем чистую плоскую Java-коллекцию в контекст выполнения
execution.setVariable("parallelAssigneesList", cleanCollection)
</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:conditionExpression xsi_1:type="bpmn:tFormalExpression">${currentStep.assignment_type == 'PARALLEL'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Parallel" targetRef="Gateway_Merge">
      <bpmn:extensionElements />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SingleOrGroup" targetRef="Gateway_Merge" />
    <bpmn:startEvent id="SubStart" name="Начало шага">
      <bpmn:outgoing>Flow_0brv6y3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0brv6y3" sourceRef="SubStart" targetRef="prepareCurrentStage" />
    <bpmn:sequenceFlow id="Flow_0vodv9m" sourceRef="Gateway_Merge" targetRef="SubEnd" />
  </bpmn:process>
