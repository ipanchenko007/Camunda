function caseManagerGetCases($limit, $start, $proUid, $app_num) {
	
	$countCases = 0;
	$sqlWhere = "acv.PRO_UID = '$proUid' AND acv.APP_NUMBER Like '%$app_num%' AND acv.APP_STATUS = 'TO_DO' AND acv.DEL_THREAD_STATUS = 'OPEN'";
	$sql = "SELECT count(1) AS COUNT_ROW FROM APP_CACHE_VIEW acv WHERE $sqlWhere";
	$result = executeQuery($sql);

	if (is_array($result) && count($result) > 0) {
		$countCases = $result[1]['COUNT_ROW'];
	}

	$sql = 
	   "SELECT acv.APP_NUMBER, acv.APP_TITLE,".
	   " acv.APP_TAS_TITLE, acv.APP_CURRENT_USER,".
	   " CONCAT(u1.USR_LASTNAME,' ',u1.USR_FIRSTNAME) AS INIT_USER_NAME,".
	   " acv.APP_CREATE_DATE, acv.APP_UPDATE_DATE,".
	   " acv.APP_STATUS, acv.USR_UID, acv.APP_UID, acv.DEL_INDEX".
       " FROM APP_CACHE_VIEW acv".
	   " JOIN APPLICATION ap ON (ap.APP_UID = acv.APP_UID)".
	   " LEFT JOIN USERS u1 ON u1.USR_UID = ap.APP_INIT_USER".
	   " WHERE $sqlWhere ORDER BY acv.APP_NUMBER LIMIT $start, $limit";
	//vipLog("caseManagerApplicationAjax/caseManagerGetCases 2 sql: $sql");
	$result = executeQuery($sql);

	$cases = array();
	if (is_array($result) && count($result) > 0) {
		//Переиндексируем с 0
		//$cases = array_values($result);

		$process = new Process();
		$processData = $process->load($proUid);

		//Переиндексируем с 0 и дозаполним информацией о SUMMARY_UID
		foreach ($result as $value) {
			$cases[] = ['APP_NUMBER'       => $value['APP_NUMBER']
					   ,'APP_TITLE'        => $value['APP_TITLE']
					   ,'APP_TAS_TITLE'    => $value['APP_TAS_TITLE']
					   ,'APP_CURRENT_USER' => $value['APP_CURRENT_USER']
					   ,'INIT_USER_NAME'   => $value['INIT_USER_NAME']
					   ,'APP_CREATE_DATE'  => $value['APP_CREATE_DATE']
					   ,'APP_UPDATE_DATE'  => $value['APP_UPDATE_DATE']
					   //Не отображаемые значения
					   ,'SUMMARY_UID'      => $processData['PRO_DYNAFORMS']['PROCESS']
					   ,'APP_STATUS'       => $value['APP_STATUS']
					   ,'USR_UID'          => $value['USR_UID']
					   ,'APP_UID'          => $value['APP_UID']
					   ,'DEL_INDEX'        => $value['DEL_INDEX']
					   ];
		}
	}

	return G::json_encode(array("success" => true, "resultTotal" => $countCases, "resultRoot" => $cases));
}

