//Перевод на Task "Администрирование"
function caseManagerToSupervisor ($selectedCase) {
	//Для отправки на другую Task используем PMFDerivateCase()
	//См. реализацию в триггере "AutoApproval 862" процесса "500"
	// и в триггере "Post Step Superviser" процесса "851"
	$toSupervisorResult = array();
	
	$currentUser = $_SESSION['USER_LOGGED'];
	$userData = PMFInformationUser($currentUser);
	
	$caseId =  $selectedCase['APP_UID'];
	$caseNum =  $selectedCase['APP_NUMBER'];

	$c = new Cases(); //Создание экземпляра класса Cases	
	
	//Блок контроля доступности текущего Case для $currentUser----------------------
	$aCase = $c->loadCase($caseId); //Выгрузка данных из Case в $aCase
	
	$requestType = $aCase['APP_DATA']['requestType'];
	$users = array();
	//Admin Users в Case
	$users = array_column($aCase['APP_DATA']['gridAdmin'],'adminUserUid');
	//vipLog("caseManagerApplicationAjax/caseManagerToSupervisor 1 users: ".vipVarDump($users));
	
	//Добавим Секретарей из настройки для Главного Родительского Типа заявки и DUMMY_STAGE_SECRETARY
	//Плюс users from PM Group 'ad_1410: администраторы'
	$sqlUsers = 
	"SELECT pru.USR_UID FROM pmt_request_users_1410 pru".
	" WHERE pru.USER_TYPE_CODE = 'TYPE_SECRETARY' AND pru.REQUEST_ID = '$requestType'".
	" UNION".
	" SELECT pru.USR_UID FROM pmt_request_users_1410 pru".
	" JOIN pmt_request_types_1410 rt ON (rt.REQUEST_ID = pru.REQUEST_ID AND rt.REQUEST_NAME = 'DUMMY_STAGE_SECRETARY')".
	" WHERE pru.USER_TYPE_CODE = 'TYPE_SECRETARY'".
	" UNION".
	" SELECT gru.USR_UID FROM groupwf gr".
	" JOIN group_user gru ON (gru.GRP_UID = gr.GRP_UID)".
	" WHERE gr.GRP_TITLE = 'ad_1410: администраторы'";
	//vipLog("caseManagerApplicationAjax/caseManagerToSupervisor sqlUsers = $sqlUsers");
	$resUsers = executeQuery($sqlUsers);
	
	if (is_array($resUsers) && count($resUsers) > 0) {
		//Дозаполним $users
		foreach(array_column($resUsers,'USR_UID') as $secretaryUserUid) {
			$users[] = $secretaryUserUid;
		}
	}
	//vipLog("caseManagerApplicationAjax/caseManagerToSupervisor 2 users: ".vipVarDump($users));

	//Входит ли $currentUser в список $users ?
	if (!in_array($currentUser, $users)) {
		$action_result = "ERROR. Нет прав для перевода на 'Администрирование'!";
		array_push($toSupervisorResult, array("app_number" => $caseNum, "action_result" => $action_result));
		return $toSupervisorResult;
	}
	//End Блока контроля доступности текущего Case для $currentUser-----------------

	//Еще раз найдем все OPEN Delegations для выбранного $caseId
	$sql = 
	"SELECT APP_NUMBER, TAS_UID, DEL_INDEX, USR_UID FROM APP_CACHE_VIEW".
	" WHERE APP_UID = '$caseId' AND DEL_THREAD_STATUS = 'OPEN'";
	//vipLog("caseManagerApplicationAjax/caseManagerToSupervisor sql: $sql"); 
	$result = executeQuery($sql);
	//vipLog("caseManagerApplicationAjax/caseManagerToSupervisor result: ".vipVarDump($result)); 
	
	//$resDerivate - Результат выполнения PMFDerivateCase (0 - не выполнено, 1 - выполнено)
	$resDerivate = 0;

	if (is_array($result) && count($result) > 0) {

		//Проанализируем Task только из первой строки (остальные должны быть те же!)
		$currentTaskName = PMFGetTaskName($result[1]['TAS_UID']);
		//Откажемся от обработки Task "Доработка заявки" и "Администрирование"
		//А так же ПОКА от "Предоставление информации".
		//Для Case только в статусе 'TO_DO'
		//Можно вытащить сохраненное в APP_DATA значения STAGE_NAME (в stageSequence) и обрабатывать только их
		//strpos - чувствительна к регистру!
		if (strpos($currentTaskName, 'Доработка') !== false || 
			strpos($currentTaskName, 'Предоставление') !== false ||
			strpos($currentTaskName, 'Администрирование') !== false) {
			//vipLog("caseManagerApplicationAjax/caseManagerToSupervisor Skip Task '$currentTaskName'");
			$action_result = "ERROR. Задачу '$currentTaskName' нельзя первести на этап 'Администирование'!";
			array_push($toSupervisorResult, array("app_number" => $caseNum, "action_result" => $action_result));
			return $toSupervisorResult;
		}

		//$checkReassign - Признак выполненного переназначения на $currentUser
		$checkReassign = 0; 
		$countClosed = 0; //Кол-во закрытых delIndex
		
		$i = 0;
		foreach ($result as $row) {
			$i++;
			//vipLog("caseManagerApplicationAjax/caseManagerToSupervisor i= $i"); 
			
			$delIndex = $row['DEL_INDEX'];
			$userId = $row['USR_UID']; //Назначенный user

			//Блок закрытия Delegation по условию 
			if ($checkReassign == 1) {
				//PMFDerivateCase уже выполнено. Все оставшиеся delIndex закрываем
				$resClosed = $c->CloseCurrentDelegation($caseId, $delIndex); 
				$countClosed++;
				//vipLog("caseManagerApplicationAjax/caseManagerToSupervisor i=$i caseId: $caseId delIndex: $delIndex countClosed: $countClosed");
				//На следующую итерацию
				continue;
			}
			
			//Выполним переназначение с $userId на $currentUser с признаком $sType = 'ADD_USER'
			$checkReassign = $c->reassignCase($caseId, $delIndex, $userId, $currentUser, 'ADD_USER');
			vipLog("caseManagerApplicationAjax/caseManagerToSupervisor checkReassign: $checkReassign"); 
			vipLog("caseManagerApplicationAjax/caseManagerToSupervisor caseId: $caseId delIndex: $delIndex"); 
			vipLog("caseManagerApplicationAjax/caseManagerToSupervisor userId: $userId currentUser: $currentUser"); 
		}
		vipLog("caseManagerApplicationAjax/caseManagerToSupervisor checkReassign: $checkReassign countClosed: $countClosed"); 

		//Если переназначение выполнено успешно, то ищем $resMax
		if ($checkReassign == 1) {
			//Найдем MAX(DEL_INDEX), созданный после переназначения
			$sqlMax = "SELECT MAX(DEL_INDEX) AS MAX_DEL_INDEX FROM APP_DELEGATION WHERE APP_UID='$caseId'"; 
			$resMax = executeQuery($sqlMax);
		} else {
			$resMax = array(); //На всякий случай пустой array
		}

		if (is_array($resMax) && count($resMax) > 0) {

			//$maxDelIndex - Delegation назначено на $currentUser
			$maxDelIndex = $resMax[1]['MAX_DEL_INDEX'];
				
			//Блок выполнения маршрутизации (Routes a case to the next task)
			$aCase = $c->loadCase($caseId); //Выгрузка данных из Case в $aCase
			//vipLog("caseManagerApplicationAjax/caseManagerToSupervisor Skip aCase:".vipVarDump($aCase));

			//Текущие значения в Task
			$docStatus = $currentTaskName;
			$prevStageCode = $aCase['APP_DATA']['prevStageCode'];
			$stageCode = $aCase['APP_DATA']['stageCode'];
			$XC_COMMENT_LIST = $aCase['APP_DATA']['XC_COMMENT_LIST'];
			$XA_ACTION_LIST = $aCase['APP_DATA']['XA_ACTION_LIST'];
			
			//Заполним ВСЕ необходимые переменные для выполнения Derivate Case
			$nextDocStatus = "Назначена на 'Администрирование'";
			$nextStageCode = 'ADMIN';
			$nextStageName = 'Администрирование';
			$XA_CURRENT_ACTION = "ADMIN";
			$nextResponsible = $currentUser;
			
			//ВАЖНО! Чтобы при параллельном согласовании кто-то одновременно не выполнил
			//отправку на следующий этап, выполним ОБНУЛЕНИЕ array XA_APPROVE_USERS_UIDS
			$XA_APPROVE_USERS_UIDS = array();
		
			//Сохраним Комментарий с заполнением по-новому (без обращения к $apprHelper)
			//Комментарий добавляем ТОЛЬКО один раз
			$userData = PMFInformationUser($currentUser);
			$XC_COMMENT_LIST[count($XC_COMMENT_LIST) + 1] =
							   ['commentWhen'     => getCurrentDate().' '.getCurrentTime()
							   ,'commentStage'    => $currentTaskName
							   ,'commentAction'   => 'На Администирование'
							   ,'commentWho'      => $userData['lastname'].' '.$userData['firstname']
							   ,'commentText'     => "Перевод на Задачу 'Администрирование'"
							   ,'commentTaskName' => $currentTaskName //Текущая Task
							   //Не будем заполнять текущее значения DEL_INDEX! Т.к. не нужна связка с XA_ACTION_LIST 
							   ,'commentDelIndex' => ''
							   ];

			//Сохранение выполненных изменений 
			$aNewValue = array('docStatus'                => $nextDocStatus,
							   'docStatus_label'          => $nextDocStatus,
							   'nextStageCode'            => $nextStageCode,
							   //'nextStageCode_label'      => $nextStageCode,
							   'nextStageName'            => $nextStageName,
							   //'nextStageName_label'      => $nextStageName,
							   'XA_CURRENT_ACTION'        => $XA_CURRENT_ACTION,
							   //'XA_ACTION_LIST'           => $XA_ACTION_LIST, //Пока не менял
							   'nextResponsible'          => $nextResponsible,
							   'XC_COMMENT_LIST'          => $XC_COMMENT_LIST,
							   'XA_APPROVE_USERS_UIDS'    => $XA_APPROVE_USERS_UIDS //ВАЖНО! Пустой array
							   ); 
			//vipLog("caseManagerApplicationAjax/caseManagerToSupervisor aNewValue: " .vipVarDump($aNewValue)); 
			
			$aCase['APP_DATA'] = array_merge($aCase['APP_DATA'], $aNewValue); //Замена в 'APP_DATA'
			//Выполнение изменений. Вместо updateCase рекомендуют еще использовать PMFSendVariables()
			$caseFields = $c->updateCase($caseId, $aCase);
			//vipLog("caseManagerApplicationAjax/caseManagerToSupervisor caseFields: " .vipVarDump($caseFields)); 

			//После сохранения изменений можно выполнилить PMFDerivateCase
			//Для отправки на следующий этап используем PMFDerivateCase()
			//See: PMFDERIVATECASE() IS NOT WORKING WHEN WE USE IT TRY FROM OTHER PROCESS
			$g = new G();
			$g->sessionVarSave();
			$resDerivate = PMFDerivateCase($caseId, $maxDelIndex, false, $currentUser);  
			$g->sessionVarRestore();
			vipLog("caseManagerApplicationAjax/caseManagerToSupervisor PMFDerivateCase maxDelIndex: $maxDelIndex currentUser: $currentUser resDerivate: ".vipVarDump($resDerivate));

		}		
		
		if ($resDerivate == 1) {
			$action_result = "Маршрутизация выполнена успешно.";

			//Попробуем сразу перейти в форму "Администирирование" ----
			/* Не получается!!!****************************************
			//Найдем OPEN Delegation (должна быть Task "Администирирование")
			$sql = 
			"SELECT APP_UID, DEL_INDEX FROM APP_DELEGATION".
			" WHERE APP_UID = '$caseId'  AND DEL_THREAD_STATUS = 'OPEN'";
			vipLog("caseManagerApplicationAjax/caseManagerToSupervisor Search Task Admin sql: $sql"); 
			$result = executeQuery($sql);
			
			if (is_array($result) && count($result) > 0) {
				header("Location: cases_Open?APP_UID=$caseId&DEL_INDEX=".$result[1]['DEL_INDEX']."&action=draft");
				die();
			}
			**********************************************************/
			//End перехода в форму "Администирирование" ---------------
			
		} else {
			$action_result = "ERROR. Не найдены Задачи для маршрутизации!";
		}
	
	} else {
		$action_result = "ERROR. Не найдены Задачи для маршрутизации!";
	}
	
	array_push($toSupervisorResult, array("app_number" => $caseNum, "action_result" => $action_result));
	return $toSupervisorResult;
}
    
//Перевод на Next Task
function caseManagerToNextTask ($selectedCase) {
	//Для отправки на другую Task используем PMFDerivateCase()
	$toNextTaskResult = array();
	
	$caseId = $selectedCase['APP_UID'];
	$caseNum =  $selectedCase['APP_NUMBER'];
	$sql = "SELECT APP_NUMBER FROM APPLICATION WHERE APP_UID = '$caseId'";
	$result = executeQuery($sql);
	
	if (is_array($result) && count($result) > 0) {
		array_push($toNextTaskResult, array("app_number" => $caseNum, "action_result" => "Функция не реализована."));
	
	} else {
		array_push($toNextTaskResult, array("app_number" => $caseNum, "action_result" => "ERROR. Не найдены Задачи для маршрутизации!"));
	}

	return $toNextTaskResult;
}
    
